+/* ================= GETV_XLUCENSUS -- transparency census (read-only) =================
+ *
+ * Distinguishes the two candidate mechanisms for "shiny surfaces render translucent":
+ *   (A) render-mode misdecode  -> a large fraction of ALL draws take the alpha path
+ *   (B) shine alpha used as coverage -> only texgen / env-mapped materials do
+ *
+ * Keyed on the exact other_mode_l word so the blender mux, the coverage bits and the
+ * z-mode are all visible at once. `ALPHA_CVG_SEL` is the field the port never reads:
+ * on hardware it means the blender's A input is COVERAGE, not the combiner's alpha. */
+#define GE_XLU_MAX 40
+struct GeXluRow {
+    uint32_t oml;
+    unsigned long n, n_alpha, n_texgen, n_fog, n_fogprim, n_lit;
+    unsigned long n_shade_a_lt255, n_prim_a_lt255, n_env_a_lt255;
+    unsigned long min_shade_a, min_prim_a, min_env_a;
+    uint32_t acc[4];          /* up to 4 distinct cycle-1 alpha combiner encodings */
+    unsigned long accn[4];
+    unsigned acc_used;
+};
+static struct GeXluRow ge_xlu_rows[GE_XLU_MAX];
+static unsigned ge_xlu_used;
+unsigned long ge_xlu_tris;            /* global on purpose: `nm` discriminator */
+unsigned long ge_xlu_overflow;
+
+/* Runtime discriminators for the ALPHA_CVG_SEL fix -- GLOBAL on purpose so `nm` proves
+ * the object relinked and the per-frame line proves the branch actually executed. */
+unsigned long ge_cvgsel_seen;         /* draws whose A input hardware takes from coverage */
+unsigned long ge_cvgsel_opaque;       /* ...of those, the ones we forced opaque */
+
+static int ge_xlu_on(void) {
+    static int on = -1;
+    if (on < 0) { const char *e = getenv("GETV_XLUCENSUS"); on = (e && *e == '1'); }
+    return on;
+}
+
+static void ge_xlu_note(uint32_t oml, uint32_t gm, int use_alpha, int use_fog,
+                        int fogprim, uint32_t acc,
+                        uint8_t a1, uint8_t a2, uint8_t a3,
+                        uint8_t prim_a, uint8_t env_a) {
+    struct GeXluRow *r = NULL;
+    unsigned i;
+    unsigned long sa = a1; if (a2 < sa) sa = a2; if (a3 < sa) sa = a3;
+    ge_xlu_tris++;
+    for (i = 0; i < ge_xlu_used; i++) if (ge_xlu_rows[i].oml == oml) { r = &ge_xlu_rows[i]; break; }
+    if (r == NULL) {
+        if (ge_xlu_used >= GE_XLU_MAX) { ge_xlu_overflow++; return; }
+        r = &ge_xlu_rows[ge_xlu_used++];
+        r->oml = oml;
+        r->min_shade_a = r->min_prim_a = r->min_env_a = 255;
+    }
+    r->n++;
+    if (use_alpha) r->n_alpha++;
+    if (gm & G_TEXTURE_GEN) r->n_texgen++;
+    if (gm & G_LIGHTING) r->n_lit++;
+    if (use_fog) r->n_fog++;
+    if (fogprim) r->n_fogprim++;
+    if (sa < 255) r->n_shade_a_lt255++;
+    if (prim_a < 255) r->n_prim_a_lt255++;
+    if (env_a < 255) r->n_env_a_lt255++;
+    if (sa < r->min_shade_a) r->min_shade_a = sa;
+    if (prim_a < r->min_prim_a) r->min_prim_a = prim_a;
+    if (env_a < r->min_env_a) r->min_env_a = env_a;
+    for (i = 0; i < r->acc_used; i++) if (r->acc[i] == acc) { r->accn[i]++; break; }
+    if (i == r->acc_used && i < 4) { r->acc[i] = acc; r->accn[i] = 1; r->acc_used++; }
+}
