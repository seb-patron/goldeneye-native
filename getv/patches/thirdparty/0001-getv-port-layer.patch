+    struct gfx_dltrace_entry *e = &gfx_dltrace[gfx_dltrace_pos];
+    e->from = from; e->target = target; e->w0 = w0; e->w1 = w1;
+    e->depth = depth; e->kind = kind;
+    gfx_dltrace_pos = (gfx_dltrace_pos + 1) % GFX_DLTRACE_N;
+    gfx_dltrace_total++;
