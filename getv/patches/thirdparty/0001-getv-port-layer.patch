+ * where the rails ended. This ring records only the events that move the instruction pointer
+ * non-linearly: G_DL calls, G_DL branches, and the G_ENDDL returns that pop back. Sixteen of
+ * those cover far more ground than sixteen commands. */
+#define GFX_DLTRACE_N 24
+struct gfx_dltrace_entry {
+    const void *from;      /* address of the command that moved us */
+    const void *target;    /* where it went (NULL for a return) */
+    uintptr_t w0, w1;
+    int depth;
+    unsigned char kind;    /* 0 = call, 1 = branch, 2 = enddl return */
