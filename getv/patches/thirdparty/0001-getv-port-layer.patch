+#define GFX_TRACE_N 16
+struct gfx_trace_entry { const void *cmd; uintptr_t w0, w1; };
+struct gfx_trace_entry gfx_trace[GFX_TRACE_N];
+unsigned int gfx_trace_pos;
+unsigned long gfx_trace_total;
