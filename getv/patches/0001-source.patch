+/* ===================== HORDE MODE =====================
+ *
+ * Endless waves, built entirely out of the engine's own spawning. A horde is not a game
+ * mode here so much as a rule attached to dying: when a guard dies, some number of
+ * replacements are spawned where it fell, and that number grows every so many kills.
+ *
+ * Driven from lv.c's per-frame tick rather than from a death callback, because there is no
+ * single place a chr dies -- a bullet, an explosion, a fall and a scripted kill all arrive
+ * differently, and chr.c:4204 only sees the bullet. Polling the slot table catches every
+ * cause for the price of one walk of an array the game already walks several times a frame.
+ *
+ * Slot reuse is why the "already counted" marks are cleared for any slot that is not
+ * currently dying: a slot that dies, is cleaned up and is then handed to a new guard must be
+ * countable again, and clearing on the live path means that happens without tracking
+ * cleanup explicitly.
+ *
+ * Three limits, all of which can stop a spawn, and all deliberate:
+ *   - chrSpawnAtCoord refuses unless chrGetNumFree() >= 3, which is the engine's own rule.
+ *     g_ChrSlots is allocated with only (count + 10) entries (initguards.c:30), so the
+ *     ceiling on live guards is a property of the level, not of this code.
+ *   - max_alive caps how many spawned guards may live at once.
+ *   - per_kill is capped, so growth cannot outrun the slot table.
+ * A refused spawn is not an error and is not retried; the wave simply stays smaller.
+ */
+
+#define GE_HORDE_MARKS 512
+
+static unsigned char ge_horde_dead_mark[GE_HORDE_MARKS];
+static s32 ge_horde_kills;
+static s32 ge_horde_wave;
+static s32 ge_horde_alive;      /* guards spawned by this system that are still up */
+static s32 ge_horde_spawned;    /* lifetime total, for the summary line */
+
+s32 gePortHordeKills(void) { return ge_horde_kills; }
+s32 gePortHordeWave(void)  { return ge_horde_wave;  }
+
+void gePortHordeTick(void)
+{
+    extern int gePortHordeEnabled(void);
+    extern int gePortHordeMaxAlive(void);
+    extern int gePortHordeWaveKills(void);
+    extern int gePortHordeGrowth(void);
+    extern int gePortHordePerKillBase(void);
+    extern int gePortHordePerKillCap(void);
+    extern PropRecord *chrSpawnAtCoord(s32 bodynum, s32 headnum, coord3d *pos,
+                                       StandTile *stan, f32 angle,
+                                       struct AIListRecord *ailist, s32 spawnflags);
+
+    s32 i;
+    s32 per_kill;
+
+    if (!gePortHordeEnabled()) {
+        return;
+    }
+
+    /* GETV_HORDE_SELFTEST=<frame>: at that tick, treat the first live guard as a kill
+     * without one having happened. Combat cannot be driven reliably from a headless run --
+     * scripted fire sprays in whatever direction the level happens to start facing and
+     * usually hits nobody -- so without this the spawn path could only be claimed to work,
+     * not shown to. It exercises exactly the code a real death runs, and it is the only
+     * thing in this file that is not reachable in normal play. */
+    {
+        static s32 ge_st_tick = 0;
+        static s32 ge_st_at = -2;
+        if (ge_st_at == -2) {
+            const char *e = getenv("GETV_HORDE_SELFTEST");
+            ge_st_at = (e && *e) ? atoi(e) : -1;
+        }
+        ge_st_tick++;
+        if (ge_st_at > 0 && ge_st_tick == ge_st_at) {
+            s32 k;
+            s32 found = 0;
+            for (k = 0; k < g_NumChrSlots; k++) {
+                ChrRecord *c = &g_ChrSlots[k];
+                if (c->model != NULL && c->prop != NULL && c->prop->stan != NULL &&
+                    c->actiontype != ACT_DIE && c->actiontype != ACT_DEAD) {
+                    PropRecord *r = chrSpawnAtCoord((s32) c->bodynum, -1, &c->prop->pos,
+                                                    c->prop->stan, getsubroty(c->model),
+                                                    (struct AIListRecord *) c->ailist, 0);
+                    printf("[getv][horde] selftest: slot %d body %d free-before=%d -> "
+                           "spawn %s\n", k, (s32) c->bodynum, chrGetNumFree(),
+                           r ? "OK" : "REFUSED (too few free slots)");
+                    if (r) { ge_horde_alive++; ge_horde_spawned++; }
+                    found = 1;
+                    break;
+                }
+            }
+            /* Reporting the empty case matters as much as the spawn. Without it a selftest
+             * that found no eligible guard is silent, which is indistinguishable from the
+             * tick never having run -- and on a slow host, where the chosen frame simply is
+             * not reached inside the timeout, that ambiguity sends you looking for a bug in
+             * the wrong place. Measured once, on a 1 fps box. */
+            if (!found) {
+                printf("[getv][horde] selftest: no eligible guard among %d slots at tick %d\n",
+                       (s32) g_NumChrSlots, (s32) ge_st_tick);
+            }
+        }
+    }
+
+    per_kill = gePortHordePerKillBase() + (ge_horde_wave * gePortHordeGrowth());
+    if (per_kill > gePortHordePerKillCap()) {
+        per_kill = gePortHordePerKillCap();
+    }
+
+    for (i = 0; i < g_NumChrSlots && i < GE_HORDE_MARKS; i++) {
+        ChrRecord *chr = &g_ChrSlots[i];
+        s32 dying;
+
+        if (chr->model == NULL) {
+            ge_horde_dead_mark[i] = 0;
+            continue;
+        }
+
+        dying = (chr->actiontype == ACT_DIE || chr->actiontype == ACT_DEAD);
+
+        if (!dying) {
+            ge_horde_dead_mark[i] = 0;      /* live again: this slot was reused */
+            continue;
+        }
+        if (ge_horde_dead_mark[i]) {
+            continue;                        /* already counted this death */
+        }
+        ge_horde_dead_mark[i] = 1;
+        ge_horde_kills++;
+
+        if (ge_horde_alive > 0) {
+            ge_horde_alive--;                /* approximate: any death frees a slot budget */
+        }
+
+        if ((ge_horde_kills % gePortHordeWaveKills()) == 0) {
+            ge_horde_wave++;
+            printf("[getv][horde] wave %d  (%d kills, %d spawned so far)\n",
+                   ge_horde_wave, ge_horde_kills, ge_horde_spawned);
+        }
+
+        /* Spawn where it fell. The prop is still valid at ACT_DIE -- the body has not been
+         * cleaned up yet -- so pos and stan can be read straight off it. A null prop or stan
+         * means this guard never resolved a position, which is the same condition the door
+         * guard in propobj.c documents, and it is skipped rather than spawned into nowhere. */
+        if (chr->prop != NULL && chr->prop->stan != NULL) {
+            s32 n;
+            for (n = 0; n < per_kill; n++) {
+                if (ge_horde_alive >= gePortHordeMaxAlive()) {
+                    break;
+                }
+                if (chrSpawnAtCoord((s32) chr->bodynum, -1, &chr->prop->pos,
+                                    chr->prop->stan, getsubroty(chr->model),
+                                    (struct AIListRecord *) chr->ailist, 0) == NULL) {
+                    break;      /* engine refused: too few free slots. Not an error. */
+                }
+                ge_horde_alive++;
+                ge_horde_spawned++;
+            }
+        }
+    }
+}
