+/* GETV-HANDITEMZ: the pause-menu held item disappears once GETV-WATCHALIAS restores the
+ * watch's real geometry. Selectable modes, so the mechanism can be confirmed separately
+ * from the fix:
+ *   0  unchanged (retail).
+ *   1  clear G_ZBUFFER in the RSP geometry mode around the held item's subdraw (site 0),
+ *      and restore it afterwards.
+ *   2  leave the geometry mode alone but force zbufferenabled = TRUE at site 0, so the
+ *      item both writes and tests Z in its own projection space.
+ *   3  default: mode 1 plus the same treatment for watchRenderController's two subdraws
+ *      (site 1), whose controller models disappear for the same reason.
+ *
+ * Observed with the watch open on pages 1 and 3:
+ *   zmode=0  PP7 absent,   controllers absent   <- the regression
+ *   zmode=1  PP7 present,  controllers absent
+ *   zmode=2  PP7 absent,   controllers absent
+ *   zmode=3  PP7 present,  controllers present  <- matches the retail appearance
+ * The item is submitted in every mode -- the probe below reports 71 Gfx words, PropType=4,
+ * flags=3, numMatrices=6 identically at zmode 0/1/2 -- so this is not a dropped draw, and
+ * mode 2 rules out depth-write as the mechanism. Draw order is ruled out by source:
+ * options.c:2141-2147 draws the face, then the text, then the item last.
+ *
+ * Why mode 1 rather than simply disabling the depth test: the game already asks for no
+ * depth compare here. `renderdata.zbufferenabled = FALSE` makes
+ * modelApplyRenderModeType*() emit G_RM_AA_OPA_SURF / G_RM_AA_XLU_SURF2, i.e.
+ * othermode-lower with Z_CMP and Z_UPD clear. On the N64 that is the whole story: the RDP
+ * decides comparison from Z_CMP. Our Fast3D does not read Z_CMP at all -- gfx_pc.c:2178
+ * derives the GL depth test from the RSP geometry mode instead
+ * (`depth_test = (rsp.geometry_mode & G_ZBUFFER)`), and only the depth write follows the
+ * RDP (`z_upd = other_mode_l & Z_UPD`, gfx_pc.c:2185). That conflation is inherited from
+ * sm64ex, where SM64 always moved the two together. So on this port
+ * `zbufferenabled = FALSE` means "test against whatever is in the depth buffer, but never
+ * write" -- the opposite of the intent. Mode 1 restores the intent by clearing the bit the
+ * port actually reads: the same draw, in the same order, with the depth semantics the
+ * retail code asked for, rather than a blanket depth-test kill.
+ *
+ * Site 1 is the weaker half of this fix. Site 0 asks for no depth compare and mode 1
+ * restores exactly that. Site 1 asks for zbufferenabled = TRUE, i.e. it wants a depth
+ * test -- but the buffer it would test against holds the frozen world's depth in the
+ * world's projection, while the controller is drawn through the watch overlay's own
+ * guPerspective, so the comparison is meaningless either way. On the N64 it was not
+ * meaningless, because the overlay pass owns the Z buffer there. The proper fix is a
+ * depth clear (or a dedicated depth range) for the whole watch overlay pass, which lives
+ * in options.c / bondview2.c; this is a narrow stand-in until that exists.
+ * GETV_HANDITEMZ=1 keeps site 1 at retail behaviour.
+ *
+ * GETV_HANDITEMZ=<0|1|2|3>, default 3. gfx_pc.c is untouched. */
+int geHandItemZFlag = -2;
+
+int geHandItemZMode(void)
+{
+    if (geHandItemZFlag == -2) {
+        const char *e = getenv("GETV_HANDITEMZ");
+        geHandItemZFlag = (e && e[0] >= '0' && e[0] <= '9') ? (e[0] - '0') : 3;
+    }
+    return geHandItemZFlag;
+}
+
+void geHandItemMark(s32 site, s32 numswitches, s32 nummatrices)
+{
+    if (!geHandItemDbg()) { return; }
+    geHandItemCalls[site]++;
+    if (geHandItemCalls[site] == 1 || (geHandItemCalls[site] % 600) == 0) {
+        osSyncPrintf("[getv][handitem] site=%d calls=%u slot=%d numSwitches=%d numMatrices=%d on=%d\n",
+                     (s32) site, geHandItemCalls[site],
+                     (s32) geHandItemSlot((void *) g_CurrentPlayer),
+                     numswitches, nummatrices, geHandItemModelOn());
+    }
+}
