+#ifdef GE_PORT_NATIVE
+/* ================== GETV_GUN_AIM (tvOS port diagnostic) =========================
+ * GETV_GUN_AUTOFIRE pulses the trigger and GETV_GUN_SKIPINTRO jumps to first person,
+ * but NEITHER steers the aim -- so every headless shot went wherever Bond happened to
+ * be facing, which on the Dam is open water. This closes that gap.
+ *
+ *   GETV_GUN_AIM=chr       aim at the nearest live on-screen character
+ *   GETV_GUN_AIM=<y>,<p>   fixed yaw,pitch offset in DEGREES from screen centre
+ *
+ * Applied to shotdata.viewDir IMMEDIATELY after bullet_path_from_screen_center(), so
+ * the world-space dir, the stan/bg walk, dest and maxdist are all derived from the
+ * steered ray exactly as they would be from a real one. Diagnostic only.
+ * ============================================================================== */
+static f32 ge_aim_parsef(const char **sp)
+{
+    const char *c = *sp;
+    f32 sign = 1.0f, whole = 0.0f, frac = 0.0f, scale = 1.0f;
+    if (*c == '-') { sign = -1.0f; c++; }
+    else if (*c == '+') { c++; }
+    while (*c >= '0' && *c <= '9') { whole = whole * 10.0f + (f32)(*c - '0'); c++; }
+    if (*c == '.') {
+        c++;
+        while (*c >= '0' && *c <= '9') { scale *= 0.1f; frac += (f32)(*c - '0') * scale; c++; }
+    }
+    *sp = c;
+    return sign * (whole + frac);
+}
+
+/* 0 = off, 1 = nearest chr, 2 = fixed yaw/pitch */
+static s32 ge_gun_aim_mode(f32 *yaw, f32 *pitch)
+{
+    static s32 cached = -1;
+    static f32 cy = 0.0f, cp = 0.0f;
+    if (cached < 0) {
+        const char *e = getenv("GETV_GUN_AIM");
+        cached = 0;
+        if (e && *e) {
+            if (e[0] == 'c' || e[0] == 'C') {
+                cached = 1;
+            } else {
+                const char *c = e;
+                cy = ge_aim_parsef(&c);
+                if (*c == ',') { c++; cp = ge_aim_parsef(&c); }
+                cached = 2;
+            }
+        }
+    }
+    if (yaw) *yaw = cy;
+    if (pitch) *pitch = cp;
+    return cached;
+}
+
+/* Returns 1 if viewDir was overwritten. */
+static s32 ge_gun_aim_apply(ShotData *sd)
+{
+    f32 yaw, pitch;
+    s32 mode = ge_gun_aim_mode(&yaw, &pitch);
+
+    if (mode == 0) return 0;
+
+    if (mode == 2) {
+        f32 ry = yaw * 0.017453292f;
+        f32 rp = pitch * 0.017453292f;
+        f32 cp = cosf(rp);
+        /* yaw=0,pitch=0 -> (0,0,-1): straight ahead in view space. */
+        sd->viewDir.x =  sinf(ry) * cp;
+        sd->viewDir.y =  sinf(rp);
+        sd->viewDir.z = -cosf(ry) * cp;
+        return 1;
+    }
+
+    /* mode == 1: nearest live chr. chrTestHit compares viewOrigin/viewDir directly
+     * against getsubmatrix(model)->m[3], so that translation is already in the SAME
+     * view space the ray lives in -- no extra transform is needed here. */
+    {
+        PropRecord **pp;
+        f32 bestd = 0.0f, len;
+        s32 found = 0;
+        coord3d bt;
+
+        bt.x = bt.y = bt.z = 0.0f;
+
+        for (pp = g_OnScreenPropList; pp < g_LastOnScreenProp; pp++) {
+            PropRecord *pr = *pp;
+            Mtxf *m;
+            f32 dx, dy, dz, d;
+
+            if (pr == NULL) continue;
+            /* GETV-MPAIM: other players are PROP_TYPE_VIEWER, not PROP_TYPE_CHR --
+             * ge_hit_count_candidates() 25 lines below already says so. With only the
+             * CHR test, GETV_GUN_AIM=chr could never target another player, so headless
+             * multiplayer had no way to score a player-vs-player kill. Accepting VIEWER
+             * props other than our own cannot change any solo result: solo has exactly
+             * one viewer and it is the one this test excludes. */
+            if (pr->type != PROP_TYPE_CHR
+                && !(pr->type == PROP_TYPE_VIEWER && pr->chr != NULL
+                     && getPlayerPointerIndex(pr) != get_cur_playernum())) continue;
+            if (pr->chr == NULL || pr->chr->model == NULL) continue;
+            if (pr->chr->actiontype == ACT_DEAD) continue;
+
+            m = getsubmatrix(pr->chr->model);
+            if (m == NULL) continue;
+
+            dx = m->m[3][0] - sd->viewOrigin.x;
+            dy = m->m[3][1] - sd->viewOrigin.y;
+            dz = m->m[3][2] - sd->viewOrigin.z;
+            d = (dx * dx) + (dy * dy) + (dz * dz);
+
+            if (!found || d < bestd) {
+                found = 1; bestd = d;
+                bt.x = dx; bt.y = dy; bt.z = dz;
+            }
+        }
+
+        if (!found) return 0;
+        len = sqrtf(bestd);
+        if (!(len > 0.0f)) return 0;
+
+        sd->viewDir.x = bt.x / len;
+        sd->viewDir.y = bt.y / len;
+        sd->viewDir.z = bt.z / len;
+        return 2;
+    }
+}
+
+/* Count on-screen candidates by class, so "no candidate" and "candidate rejected"
+ * are distinguishable BEFORE chrTestHit is even reached. */
+static void ge_hit_count_candidates(s32 *nlist, s32 *nchr, s32 *nobj, s32 *nlive)
+{
+    PropRecord **pp;
+    *nlist = *nchr = *nobj = *nlive = 0;
+    for (pp = g_OnScreenPropList; pp < g_LastOnScreenProp; pp++) {
+        PropRecord *pr = *pp;
+        (*nlist)++;
+        if (pr == NULL) continue;
+        if ((pr->type == PROP_TYPE_CHR)
+            || ((pr->type == PROP_TYPE_VIEWER) && (pr->chr != 0)
+                && (getPlayerPointerIndex(pr) != get_cur_playernum()))) {
+            (*nchr)++;
+            if (pr->chr && pr->chr->actiontype != ACT_DEAD) (*nlive)++;
+        } else if ((pr->type == PROP_TYPE_OBJ) || (pr->type == PROP_TYPE_WEAPON)
+                   || (pr->type == PROP_TYPE_DOOR)) {
+            (*nobj)++;
+        }
+    }
+}
