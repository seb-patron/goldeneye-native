+#define GE_FONT_NUMCHARS    94
+#define GE_FONT_KERNING     (13 * 13)
+#define GE_FONT_ROM_CHARSZ  24
+#define GE_FONT_PIXELS_OFF  (GE_FONT_KERNING * 4 + GE_FONT_NUMCHARS * GE_FONT_ROM_CHARSZ)
