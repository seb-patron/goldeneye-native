+/* Vertex payload endianness.
+ *
+ * tvOS port: ge_conv_ptr() above fixes the address of a vertex array and nothing
+ * else. Its old comment claimed vertex arrays "need no format change" -- that was
+ * wrong: they come out of a big-endian file, so every vertex coordinate, texture
+ * coordinate and collision index in the game was read byte-reversed.
+ * sizeof(Vertex) was pinned back to 16 so the walks land on the right bytes;
+ * this is the other half -- making those bytes the right numbers.
+ *
+ * It must be an in-place swap of the loaded file, not a converted copy the way a
+ * display list gets one. The renderer does not reach vertices through
+ * rodata->Vertices; it reaches them through the G_VTX addresses baked into the display
+ * list, which Fast3D's segment table resolves back into this same file buffer. A
+ * private native copy would be swapped and then ignored.
+ *
+ * A Vertex is not uniform, and there is not one layout but two:
+ *
+ *   render array -- DL.Vertices and DLCOLLISION.Vertices. This is literally gbi Vtx:
+ *     0x0 s16 x   0x2 s16 y   0x4 s16 z   0x6 s16 flag/index
+ *     0x8 s16 s   0xa s16 t
+ *     0xc,0xd,0xe,0xf = r,g,b,a (or nx,ny,nz,nflag) -- four single bytes.
+ *     Bytes have no endianness. Swapping them silently turns every vertex colour and
+ *     every lighting normal into a different one, and nothing anywhere errors.
+ *
+ *   collision array -- DLCOLLISION.CollisionVertices:
+ *     0x0..0x7 the same four s16,
+ *     0x8 u32  CollisionRelatedNodeOffset -- one 32-bit value, not two s16. Evidence:
+ *              the N64 path at modelPromoteNodeOffsetsToPointers() PROMOTE()s exactly
+ *              this slot (`CollisionVertices[i].LinkedToOffset`) as a 32-bit pointer.
+ *     0xc s16  CollisionRelatedIndex (read at chr.c:3317)
+ *     0xe s16  CollisionReserved
+ *
+ * So a blanket 32-bit swap is wrong for both layouts: it mis-pairs the s16s and
+ * destroys the colour bytes. There is no single uniform width here.
+ *
+ * The swap must run exactly once, and provably. A vertex array may be named by more
+ * than one node, and an in-place swap applied twice hands the data back big-endian with
+ * no symptom at the point of the bug. The same shape appears in bgSwapPortalGeometry():
+ * 47 portal records share a polygon, and a per-record loop double-swaps every one of
+ * them. So this tracks the byte ranges already swapped (not just start
+ * addresses, so a node naming a sub-range of another node's array is caught too) and
+ * swaps a 16-byte record only if no earlier range covers it. Counters below make the
+ * "exactly once" claim checkable in the log instead of asserted.
+ *
+ * Not swapped here, and deliberately: DLCOLLISION.PointUsage. It is an s16 array read
+ * at chr.c:3363 and it is big-endian, but the file records no length for it, so there
+ * is no safe bound to walk. Flagged, not guessed at. */
+
+_Static_assert(sizeof(Vertex) == 16, "vertex payload swap assumes the 16-byte gbi Vtx stride");
+_Static_assert(__builtin_offsetof(Vertex, coord) == 0x0, "vertex swap: coord must be at 0x0");
+_Static_assert(__builtin_offsetof(Vertex, index) == 0x6, "vertex swap: index must be at 0x6");
+_Static_assert(__builtin_offsetof(Vertex, s) == 0x8, "vertex swap: s/t must be at 0x8");
+_Static_assert(__builtin_offsetof(Vertex, r) == 0xc, "vertex swap: rgba must be at 0xc");
+_Static_assert(__builtin_offsetof(Vertex, CollisionRelatedNodeOffset) == 0x8,
+               "vertex swap: the collision 32-bit slot must be at 0x8");
+_Static_assert(__builtin_offsetof(Vertex, CollisionRelatedIndex) == 0xc,
+               "vertex swap: CollisionRelatedIndex must be at 0xc");
+
+#define GE_VTX_MAXARRAYS 512
+
+typedef struct GeVtxRange {
+    uintptr_t start;
+    uintptr_t end;
+    s32       collision;
+} GeVtxRange;
+
+static GeVtxRange ge_vtx_range[GE_VTX_MAXARRAYS];
+static s32 ge_vtx_ranges;      /* arrays claimed during this conversion */
+static s32 ge_vtx_swapped;     /* 16-byte records actually swapped */
+static s32 ge_vtx_skipped;     /* records an earlier range already covered */
+static s32 ge_vtx_conflicts;   /* records claimed once as render and once as collision */
+static s32 ge_vtx_overflow;    /* arrays we could not track -- see below */
+/* Plausibility evidence, not decoration. Model-space coordinates are s16 in the low
+ * hundreds-to-few-thousand; byte-reversed they scatter across the whole +-32767 range.
+ * Printing both magnitudes turns "the swap ran" into "the swap produced sane numbers". */
+static s32 ge_vtx_maxabs_before;
+static s32 ge_vtx_maxabs_after;
+static s32 ge_vtx_gvtx_seen;    /* G_VTX commands the bounds probe actually examined */
+static s32 ge_vtx_gvtx_outside; /* ...of which landed outside the declared array */
+/* A model display list names its vertices through two different segments and the
+ * old probe understood only one of them, which is why it reported 110 of 110 outside
+ * on every character model.
+ *
+ *   segment 5 (SPSEGMENT_MODEL_COL1) -- the loaded file. ge_conv_ptr() resolves it, and
+ *     [Vertices, Vertices + numVertices) is the right range to test against.
+ *   segment 4 (SPSEGMENT_MODEL_VTX)  -- a per-node vertex base that the game installs
+ *     at draw time, `gSPSegment(.., SPSEGMENT_MODEL_VTX, rwdata->..Vertices)` in
+ *     modelRenderNodeDl(). Its w1 is 0x04000000 + a byte offset that is already
+ *     relative to this node's own array, so the correct test is
+ *     `offset + n*sizeof(Vtx) <= numVertices*sizeof(Vtx)`, not an absolute range.
+ *     ge_conv_ptr() returns NULL for it because it is not segment 5 -- which the old
+ *     probe scored as "outside". It never was.
+ *
+ * On the cast screen, GETV_MENU=24 GETV_CASTCHR=2:
+ *   1272 G_VTX -- 50 on segment 5, all inside; 1222 on segment 4, all within their node's
+ *   declared array (worst overrun 0 bytes). No G_VTX on any other segment. */
+static s32 ge_vtx_gvtx_seg4;    /* G_VTX naming SPSEGMENT_MODEL_VTX (per-node base) */
+static s32 ge_vtx_gvtx_seg5;    /* G_VTX naming SPSEGMENT_MODEL_COL1 (the file) */
+static s32 ge_vtx_gvtx_segoth;  /* any other segment -- would be a real finding */
+static s32 ge_vtx_gvtx_over;    /* slices running past numVertices, either segment */
+static s32 ge_vtx_slice_split;  /* slices whose own coords form two disjoint clusters */
+
+static void ge_vtx_reset(void)
+{
+    ge_vtx_ranges = 0;
+    ge_vtx_swapped = 0;
+    ge_vtx_skipped = 0;
+    ge_vtx_conflicts = 0;
+    ge_vtx_overflow = 0;
+    ge_vtx_maxabs_before = 0;
+    ge_vtx_maxabs_after = 0;
+    ge_vtx_gvtx_seen = 0;
+    ge_vtx_gvtx_outside = 0;
+    ge_vtx_gvtx_seg4 = 0;
+    ge_vtx_gvtx_seg5 = 0;
+    ge_vtx_gvtx_segoth = 0;
+    ge_vtx_gvtx_over = 0;
+    ge_vtx_slice_split = 0;
+}
+
+static void ge_vtx_note_mag(s32 *slot, const u8 *p, s32 hi_first)
+{
+    s32 k;
+    for (k = 0; k < 3; k++) {
+        s32 v = hi_first ? (s16)((p[k * 2] << 8) | p[k * 2 + 1])
+                         : (s16)((p[k * 2 + 1] << 8) | p[k * 2]);
+        s32 a = v < 0 ? -v : v;
+        if (a > *slot) { *slot = a; }
+    }
+}
+
+/* -1 when no earlier array covers this record. */
+static s32 ge_vtx_covered(uintptr_t addr)
+{
+    s32 i;
+    for (i = 0; i < ge_vtx_ranges; i++) {
+        if (addr >= ge_vtx_range[i].start && addr < ge_vtx_range[i].end) {
+            return i;
+        }
+    }
+    return -1;
+}
+
+static void ge_swap16(u8 *p)
+{
+    u8 t = p[0];
+    p[0] = p[1];
+    p[1] = t;
+}
+
+static void ge_swap32(u8 *p)
+{
+    u8 t;
+    t = p[0]; p[0] = p[3]; p[3] = t;
+    t = p[1]; p[1] = p[2]; p[2] = t;
+}
+
+/* Swap one vertex array in place. `collision` picks the 0x8..0xf layout; see the note
+ * above. Records already covered by an earlier array are left alone. */
+static void ge_swap_vertices(void *arr, s32 count, s32 collision, const char *what)
+{
+    u8 *p = (u8 *)arr;
+    s32 i;
+    s32 did = 0;
+
+    if (arr == NULL || count <= 0) {
+        return;
+    }
+
+    /* Out of range slots -- track nothing, swap nothing. Swapping an array we cannot
+     * record would be the one thing we must never do: an untracked swap can be
+     * repeated. */
+    if (ge_vtx_ranges >= GE_VTX_MAXARRAYS) {
+        ge_vtx_overflow++;
+        osSyncPrintf("[getv] vtxswap: OUT OF RANGE SLOTS at %s -- %d vertices left "
+                     "BIG-ENDIAN rather than risk an untracked double swap\n",
+                     what, count);
+        return;
+    }
+
+    for (i = 0; i < count; i++, p += sizeof(Vertex)) {
+        s32 prev = ge_vtx_covered((uintptr_t)p);
+
+        if (prev >= 0) {
+            ge_vtx_skipped++;
+            if (ge_vtx_range[prev].collision != collision) {
+                ge_vtx_conflicts++;
+            }
+            continue;
+        }
+
+        /* Sample the coordinate magnitude under BOTH readings of the same bytes,
+         * before touching them. hi_first == the file's big-endian reading (what we are
+         * about to install); the other is what the code has been reading until now. */
+        ge_vtx_note_mag(&ge_vtx_maxabs_after,  p, 1);
+        ge_vtx_note_mag(&ge_vtx_maxabs_before, p, 0);
+
+        ge_swap16(p + 0x0);
+        ge_swap16(p + 0x2);
+        ge_swap16(p + 0x4);
+        ge_swap16(p + 0x6);
+
+        if (collision) {
+            ge_swap32(p + 0x8);
+            ge_swap16(p + 0xc);
+            ge_swap16(p + 0xe);
+        } else {
+            ge_swap16(p + 0x8);
+            ge_swap16(p + 0xa);
+            /* 0xc..0xf are r,g,b,a -- single bytes. Deliberately untouched. */
+        }
+
+        ge_vtx_swapped++;
+        did++;
+    }
+
+    ge_vtx_range[ge_vtx_ranges].start     = (uintptr_t)arr;
+    ge_vtx_range[ge_vtx_ranges].end       = (uintptr_t)arr + (uintptr_t)count * sizeof(Vertex);
+    ge_vtx_range[ge_vtx_ranges].collision = collision;
+    ge_vtx_ranges++;
+
+    if (did != count) {
+        osSyncPrintf("[getv] vtxswap: %s overlaps an array already swapped -- %d of %d "
+                     "records skipped (this is the dedupe working, not a failure)\n",
+                     what, count - did, count);
+    }
+}
+
+/* PROBE: does numVertices actually cover what the display list asks for?
+ *
+ * The swap is bounded by the node's declared vertex count, but the renderer reaches
+ * vertices through the G_VTX addresses inside the display list. If a G_VTX ever points
+ * outside [Vertices, Vertices + numVertices), that vertex is still big-endian and the
+ * declared count is not the right bound. Report it rather than assume it cannot happen.
+ * Reads the CONVERTED Gfx (native words), so w1 is a plain VMA/segment address. */
+static void ge_vtx_check_gdl(Gfx *gdl, uintptr_t base, const Vertex *arr, s32 count,
+                             const char *what)
+{
+    static s32 shown = 0;
+    s32 outside = 0, nvtx = 0, j;
+    uintptr_t start = (uintptr_t)arr;
+    uintptr_t end   = start + (uintptr_t)count * sizeof(Vertex);
+
+    if (gdl == NULL || arr == NULL || count <= 0) {
+        return;
+    }
+
+    for (j = 0; j < GE_GDL_MAX; j++) {
+        u32 w0 = (u32)gdl[j].words.w0;
+        u32 op = (w0 >> 24) & 0xFF;
+        uintptr_t rp;
+
+        if (op == 0xB8) {   /* G_ENDDL */
+            break;
+        }
+        if (op != 0x04) {   /* F3DEX G_VTX */
+            continue;
+        }
+        nvtx++;
+        ge_vtx_gvtx_seen++;
+        /* Segment-aware. See the note on ge_vtx_gvtx_seg4 above: segment 4 is a
+         * per-node base installed at draw time, so its w1 is a byte offset into THIS
+         * node's array and must be range-checked as an offset, not as an address.
+         * Plain-F3D G_VTX w0: bits 20-23 = n-1, bits 16-19 = dest cache index,
+         * bits 0-15 = n * sizeof(Vtx). (gbi.h:1866, gDma1p.) */
+        {
+            u32 w1  = (u32)gdl[j].words.w1;
+            u32 seg = w1 >> 24;
+            u32 off = w1 & 0x00FFFFFFu;
+            u32 n   = ((w0 >> 20) & 0xF) + 1;
+
+            rp = 0;
+            if (seg == 4) {
+                ge_vtx_gvtx_seg4++;
+                rp = start + off;
+                if (off + n * sizeof(Vertex) > (uintptr_t)count * sizeof(Vertex)) {
+                    ge_vtx_gvtx_over++;
+                    outside++;
+                    ge_vtx_gvtx_outside++;
+                }
+            } else if (seg == 5) {
+                ge_vtx_gvtx_seg5++;
+                rp = (uintptr_t)ge_conv_ptr(base, w1);
+                if (rp == 0 || rp < start ||
+                    rp + n * sizeof(Vertex) > end) {
+                    outside++;
+                    ge_vtx_gvtx_outside++;
+                }
+            } else {
+                ge_vtx_gvtx_segoth++;
+                outside++;
+                ge_vtx_gvtx_outside++;
+            }
+
+            /* Lane-2's corroborating symptom, tested at the only granularity that can
+             * decide it: does ONE G_VTX load ever hand the renderer two spatially
+             * disjoint clusters? That is what a mis-resolved pointer looks like. A
+             * whole node ARRAY spanning several body parts is not -- it is several
+             * separate slices, each loaded under its own matrix. Flags a slice whose
+             * own coordinate bbox is larger than 4x the model's own |coord| scale. */
+            if (rp != 0 && n > 0 && rp >= start && rp + n * sizeof(Vertex) <= end) {
+                const Vertex *v = (const Vertex *)rp;
+                s32 mn[3], mx[3], a, k;
+                for (a = 0; a < 3; a++) { mn[a] = 32767; mx[a] = -32768; }
+                for (k = 0; k < (s32)n; k++) {
+                    for (a = 0; a < 3; a++) {
+                        s32 c = v[k].coord.AsArray[a];
+                        if (c < mn[a]) { mn[a] = c; }
+                        if (c > mx[a]) { mx[a] = c; }
+                    }
+                }
+                if ((mx[0] - mn[0]) > 1000 || (mx[1] - mn[1]) > 1000 ||
+                    (mx[2] - mn[2]) > 1000) {
+                    ge_vtx_slice_split++;
+                }
+            }
+        }
+        /* GETV_VTXADDR=<n>: dump the first n G_VTX resolutions with the raw segmented
+         * word, so "outside" can be read as a SEGMENT question, not only a range one.
+         * A model DL's G_VTX may legitimately name SPSEGMENT_MODEL_VTX (4), which is a
+         * per-draw buffer and NOT this file at all -- ge_conv_ptr() only understands
+         * segment 5, and returns NULL for anything else. */
+        {
+            static s32 dumped = 0;
+            static s32 dumpcap = -1;
+            if (dumpcap < 0) {
+                extern char *getenv(const char *);
+                const char *e = getenv("GETV_VTXADDR");
+                dumpcap = (e && *e) ? atoi(e) : 0;
+            }
+            if (dumped < dumpcap) {
+                u32 w1 = (u32)gdl[j].words.w1;
+                dumped++;
+                osSyncPrintf("[getv] vtxaddr: %s #%d w0=%08x w1=%08x seg=%u "
+                             "off=%06x n=%u resolved=%p decl=[%p,%p) delta=%ld %s\n",
+                             what, nvtx, w0, w1, (u32)(w1 >> 24), (u32)(w1 & 0xFFFFFF),
+                             (u32)(((w0 >> 20) & 0xF) + 1), (void *)rp,
+                             (void *)start, (void *)end,
+                             (long)((intptr_t)rp - (intptr_t)start),
+                             (rp && rp >= start && rp < end) ? "IN" : "OUT");
+            }
+        }
+    }
+
+    if (outside != 0 && shown < 8) {
+        shown++;
+        osSyncPrintf("[getv] vtxswap PROBE: %s -- %d of %d G_VTX land OUTSIDE the "
+                     "declared array [%p,%p) (numVertices=%d). Those vertices are still "
+                     "big-endian; numVertices is not the right bound.\n",
+                     what, outside, nvtx, (void *)start, (void *)end, count);
+    }
+}
+
+/* GETV_TRISPAN -- triangle geometry, reconstructed the way the RSP sees it.
+ *
+ * Two open defects (Natalya's splayed forearm wedge, and 27 triangles on Bond's
+ * CUBA head rendering as a flat orange block) share a shape that no other probe can
+ * see, because every existing one looks at a G_VTX slice or at a whole node array. The
+ * RSP sees neither: it sees a 16-entry vertex cache that successive G_VTX loads write
+ * into at (v0 .. v0+n-1), and G_TRI1 indexes that cache. A triangle can therefore join
+ * vertices from two different G_VTX loads, and a per-slice bbox test structurally
+ * cannot catch it.
+ *
+ * Cross-slice is not wrong by itself -- retail Bond's extended arm is a legitimately
+ * articulated limb whose vertices sit at very different object-space Y. So this reports
+ * the size of the reconstructed triangle, not merely whether it crossed a slice: a
+ * triangle whose own edge is a large fraction of the whole model is the thing that would
+ * rasterise as a splayed wedge or a face-covering block.
+ *
+ * Encoding, both already verified on this tree:
+ *   G_VTX  (0x04) w0: bits20-23 = n-1, bits16-19 = v0, bits0-15 = n*sizeof(Vtx)
+ *                 w1: segment 4 = per-node base + byte offset; segment 5 = the file
+ *   G_TRI1 (0xBF) w1 bytes 2/1/0 = index*10   (ge_convert_gdl writes exactly this) */
+#define GE_TRI_CACHE 16
+
+static s32 ge_trispan_on = -1;
+static long ge_trispan_tris;      /* triangles reconstructed */
+static long ge_trispan_cross;     /* ...joining two or more different G_VTX loads */
+static long ge_trispan_unset;     /* ...indexing a cache slot no G_VTX ever wrote */
+static long ge_trispan_huge;      /* ...whose longest edge exceeds half the model span */
+
+static void ge_trispan_probe(Gfx *gdl, uintptr_t base, const Vertex *arr, s32 count,
+                             const char *what)
+{
+    const Vertex *cache[GE_TRI_CACHE];
+    s32 slice[GE_TRI_CACHE];
+    uintptr_t start = (uintptr_t)arr;
+    uintptr_t end   = start + (uintptr_t)count * sizeof(Vertex);
+    s32 sliceid = 0, j, k;
+    s32 mn[3], mx[3];
+    s32 span, worst = 0, worstcross = 0;
+    long tris = 0, cross = 0, unset = 0, huge = 0;
+
+    if (ge_trispan_on < 0) {
+        extern char *getenv(const char *);
+        const char *e = getenv("GETV_TRISPAN");
+        ge_trispan_on = (e && *e && *e != '0') ? 1 : 0;
+    }
+    if (!ge_trispan_on || gdl == NULL || arr == NULL || count <= 0) {
+        return;
+    }
+
+    /* Model span, for scale. A triangle is only "huge" relative to its own model. */
+    for (k = 0; k < 3; k++) { mn[k] = 32767; mx[k] = -32768; }
+    for (j = 0; j < count; j++) {
+        for (k = 0; k < 3; k++) {
+            s32 c = arr[j].coord.AsArray[k];
+            if (c < mn[k]) { mn[k] = c; }
+            if (c > mx[k]) { mx[k] = c; }
+        }
+    }
+    span = mx[0] - mn[0];
+    if (mx[1] - mn[1] > span) { span = mx[1] - mn[1]; }
+    if (mx[2] - mn[2] > span) { span = mx[2] - mn[2]; }
+
+    for (k = 0; k < GE_TRI_CACHE; k++) { cache[k] = NULL; slice[k] = -1; }
+
+    for (j = 0; j < GE_GDL_MAX; j++) {
+        u32 w0 = (u32)gdl[j].words.w0;
+        u32 w1 = (u32)gdl[j].words.w1;
+        u32 op = (w0 >> 24) & 0xFF;
+
+        if (op == 0xB8) { break; }   /* G_ENDDL */
+
+        if (op == 0x04) {            /* G_VTX */
+            u32 n   = ((w0 >> 20) & 0xF) + 1;
+            u32 v0  = (w0 >> 16) & 0xF;
+            u32 seg = w1 >> 24;
+            uintptr_t bp = 0;
+
+            if (seg == 4)      { bp = start + (w1 & 0x00FFFFFFu); }
+            else if (seg == 5) { bp = (uintptr_t)ge_conv_ptr(base, w1); }
+            if (bp == 0) { continue; }
+
+            for (k = 0; k < (s32)n && (v0 + k) < GE_TRI_CACHE; k++) {
+                uintptr_t vp = bp + (uintptr_t)k * sizeof(Vertex);
+                if (vp >= start && vp + sizeof(Vertex) <= end) {
+                    cache[v0 + k] = (const Vertex *)vp;
+                    slice[v0 + k] = sliceid;
+                }
+            }
+            sliceid++;
+            continue;
+        }
+
+        if (op == 0xBF) {            /* G_TRI1 */
+            s32 idx[3];
+            const Vertex *v[3];
+            s32 t, a, e, longest = 0, ncross = 0;
+
+            idx[0] = (s32)((w1 >> 16) & 0xFF) / 10;
+            idx[1] = (s32)((w1 >>  8) & 0xFF) / 10;
+            idx[2] = (s32)((w1 >>  0) & 0xFF) / 10;
+
+            for (t = 0; t < 3; t++) {
+                if (idx[t] < 0 || idx[t] >= GE_TRI_CACHE) { v[t] = NULL; }
+                else { v[t] = cache[idx[t]]; }
+            }
+            if (v[0] == NULL || v[1] == NULL || v[2] == NULL) {
+                unset++;
+                tris++;
+                continue;
+            }
+            tris++;
+            if (slice[idx[0]] != slice[idx[1]] || slice[idx[1]] != slice[idx[2]]) {
+                ncross = 1;
+                cross++;
+            }
+            /* Chebyshev edge length -- no sqrt, and a splayed wedge is exactly the
+             * case where one axis blows up on its own. */
+            for (t = 0; t < 3; t++) {
+                const Vertex *p = v[t], *q = v[(t + 1) % 3];
+                for (a = 0; a < 3; a++) {
+                    e = p->coord.AsArray[a] - q->coord.AsArray[a];
+                    if (e < 0) { e = -e; }
+                    if (e > longest) { longest = e; }
+                }
+            }
+            if (span > 0 && longest * 2 > span) { huge++; }
+            if (longest > worst) { worst = longest; worstcross = ncross; }
+        }
+    }
+
+    ge_trispan_tris  += tris;
+    ge_trispan_cross += cross;
+    ge_trispan_unset += unset;
+    ge_trispan_huge  += huge;
+
+    if (huge > 0 || unset > 0) {
+        osSyncPrintf("[getv][trispan] %s model=%s nv=%d span=%d | tris=%ld cross=%ld "
+                     "unset=%ld HUGE=%ld worstedge=%d%s\n",
+                     what, ge_model_convert_name, count, span, tris, cross, unset,
+                     huge, worst, worstcross ? " (worst is cross-slice)" : "");
+    }
+}
+
+/* Convert one node's rodata. Returns NULL when the opcode carries none we understand --
+ * reported, never guessed. */
+static union ModelRoData *ge_conv_rodata(uintptr_t base, u32 type, u32 dataoff)
+{
+    const u8 *f = (const u8 *)(base + (dataoff - GE_MODEL_VMA));
+    union ModelRoData *out;
+
+    if (dataoff == 0) {
+        return NULL;
+    }
+    out = mempAllocBytesInBank(sizeof(union ModelRoData), MEMPOOL_STAGE);
+    if (out == NULL) {
+        static int reported = 0;
+        if (!reported) {
+            reported = 1;
+            osSyncPrintf("[getv] modelconv: OUT OF STAGE POOL allocating rodata "
+                         "(%u bytes/node) -- nodes will have NULL Data\n",
+                         (u32)sizeof(union ModelRoData));
+        }
+        return NULL;
+    }
+    bzero(out, sizeof(union ModelRoData));
+
+    switch (type) {
+        case MODELNODE_OPCODE_GROUP:
+        case MODELNODE_OPCODE_OP03:
+            out->Group.Origin.f[0] = ge_bef32(f + 0);
+            out->Group.Origin.f[1] = ge_bef32(f + 4);
+            out->Group.Origin.f[2] = ge_bef32(f + 8);
+            out->Group.JointID     = ge_be16(f + 12);
+            out->Group.MatrixID0   = (s16)ge_be16(f + 14);
+            out->Group.MatrixID1   = (s16)ge_be16(f + 16);
+            out->Group.MatrixID2   = (s16)ge_be16(f + 18);
+            /* ChildGroup is a node offset -- patched in the link pass. */
+            out->Group.ChildGroupNode = (ModelNode *)(uintptr_t)ge_be32(f + 20);
+            out->Group.BoundingVolumeRadius = ge_bef32(f + 24);
+            return out;
+
+        case MODELNODE_OPCODE_BBOX:
+            out->BoundingBox.ModelNumber = ge_be32(f + 0);
+            {   /* struct bbox is six f32 */
+                f32 *dst = (f32 *)&out->BoundingBox.Bounds;
+                s32  i;
+                for (i = 0; i < 6; i++) {
+                    dst[i] = ge_bef32(f + 4 + i * 4);
+                }
+            }
+            return out;
+
+        case MODELNODE_OPCODE_HEADER:
+        case MODELNODE_OPCODE_OP20:
+            /* u16 AnimPart, s16 MatrixIndex, u32 FirstGroup, u16 Group1, u16 Group2,
+             * u16 RwDataIndex. FirstGroup is a node offset -- patched in the link pass. */
