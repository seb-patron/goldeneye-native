+#ifdef GE_PORT_NATIVE
+/* GETV_FOV=<n> -- vertical field of view as a percentage of the original, 100 = unchanged.
+ *
+ * The game re-sets the field of view every frame from the player's zoom state
+ * (bondview2.c:3427), so a one-shot override is overwritten immediately. It is applied in
+ * currentPlayerSetPerspective (bondview.c), which is the single point that stores the value
+ * the projection is built from -- there are six callers, and scaling only some of them lets
+ * the others put the unscaled value back.
+ *
+ * What it must not do is change g_ViBackData->fovy itself. Three sites compute
+ * viGetFovY() / FOV_Y_F as a ratio and use it to scale aiming (bondview2.c:4398, 4402,
+ * 4414), which is how the game makes aim finer as you zoom in. Scaling the stored value
+ * would widen the view and quietly retune aim sensitivity with it -- a gameplay change
+ * wearing a cosmetic option's clothes. So the stored value stays exactly as the game set
+ * it, and only the projection matrix sees the multiplier. */
+f32 gePortFovScale(void)
+{
+    static f32 scale = -1.0f;
+    if (scale < 0.0f) {
+        const char *e = getenv("GETV_FOV");
+        s32 pct = (e && *e) ? (s32) strtol(e, NULL, 10) : 100;
+        if (pct < 50) { pct = 50; }
+        if (pct > 160) { pct = 160; }
+        scale = (f32) pct / 100.0f;
+    }
+    return scale;
+}
+#endif
