+                         (void *) v->ailist, (void *) ailistFindById(0x40a),
+                         (s32) v->aioffset, (s32) v->aireturnlist);
+            for (k = 0; k < 200 && g_GlobalAILists[k].ailist; k++)
+            {
+                if (g_GlobalAILists[k].ailist == v->ailist)
+                {
+                    osSyncPrintf("[veh] AIPTR truck ailist IS GLOBAL list k=%d id=0x%x\n",
+                                 k, g_GlobalAILists[k].ID);
+                }
+            }
+            for (k = 0; k < 64 && g_CurrentSetup.ailists && g_CurrentSetup.ailists[k].ailist; k++)
+            {
+                u8 *bb = (u8 *) g_CurrentSetup.ailists[k].ailist;
+                osSyncPrintf("[veh] AITBL k=%d id=0x%x ptr=%p first=%02x %02x %02x %02x %02x %02x %s\n",
+                             k, g_CurrentSetup.ailists[k].ID,
+                             (void *) g_CurrentSetup.ailists[k].ailist,
+                             bb[0], bb[1], bb[2], bb[3], bb[4], bb[5],
+                             (g_CurrentSetup.ailists[k].ailist == v->ailist) ? "<== TRUCK" : "");
+            }
+        }
+        if (frame == 1 || frame == 300)
+        {
+            s32 i;
+            char buf[256];
+            s32 n = 0;
+            u8 *b = (u8 *) v->ailist;
+            for (i = 0; i < 28; i++) { n += sprintf(buf + n, "%02x ", b[i]); }
+            osSyncPrintf("[veh] AILIST f=%d bytes: %s\n", frame, buf);
+        }
+
+        osSyncPrintf("[veh] f=%d cam=%d nchr=%d chrmoved=%d chrd2=%.4f nobj=%d nveh=%d "
+                     "pos=(%.2f %.2f %.2f) d2=%.4f rt=(%.2f %.2f %.2f) "
+                     "spd=%.4f aim=%.4f t60=%.3f roty=%.4f path=%p step=%d "
+                     "ail=%p aioff=%d stan=%p flags=0x%x flags2=0x%x healthy=%d dt=%.4f\n",
+                     frame, (s32) bondviewGetCameraMode(), nchr, nchrmoved, (double) chrmax,
