+                     (double) vehprop->pos.f[0], (double) vehprop->pos.f[1], (double) vehprop->pos.f[2],
+                     (double) d2,
+                     (double) v->runtime_pos.f[0], (double) v->runtime_pos.f[1], (double) v->runtime_pos.f[2],
+                     (double) v->speed, (double) v->speedaim, (double) v->speedtime60, (double) v->roty,
+                     (void *) v->path, (s32) v->nextstep,
