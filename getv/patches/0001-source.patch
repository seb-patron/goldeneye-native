+/* GETV_CHEATDUMP=1: report every cheat flag that is set, once, the first time anything asks.
+ * Cheats reaching the game without being asked for is a user-visible bug -- paintball impacts
+ * and confetti explosions are both cheat effects -- and the flag array is the only place that
+ * can come from. */
+void gePortCheatDump(void)
+{
+    static s32 done = -1;
+    s32 i;
+
+    if (done == -1) {
+        const char *e = getenv("GETV_CHEATDUMP");
+        done = (e && *e == '1') ? 0 : 1;
+    }
+    if (done) return;
+    done = 1;
+
+    osSyncPrintf("[getv][cheatdump] player=%d", (s32) get_cur_playernum());
+    for (i = 0; i <= CHEAT_INVALID; i++) {
+        if (g_CheatPlayerTextRelated[i] != 0) {
+            osSyncPrintf(" [%d]=0x%02x", i, (s32) g_CheatPlayerTextRelated[i]);
+        }
+    }
+    osSyncPrintf("  (nothing listed means every flag is clear)\n");
+}
+
+
 bool cheatIsActive(CHEAT_ID cheat)
 {
+    gePortCheatDump();
     return ((bool) (u8) g_CheatPlayerTextRelated[cheat] >> get_cur_playernum()) & 1;
 }
 
