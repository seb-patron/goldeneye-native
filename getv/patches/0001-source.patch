diff --git a/tools/gen_propdef_layout.py b/tools/gen_propdef_layout.py
new file mode 100644
index 0000000..42d6583
--- /dev/null
+++ b/tools/gen_propdef_layout.py
@@ -0,0 +1,648 @@
+#!/usr/bin/env python3
+"""Generate src/game/ge_propdef_layout.inc.c -- the N64-file -> native-record map
+for the setup file's propDef stream.
+
+WHY THIS EXISTS
+---------------
+assets/obseg/setup/*.c holds the ROM's propDef stream emitted verbatim as
+`s32 words[]`.  Records are packed at their N64 sizes with 4-byte pointer slots,
+so the native (arm64) structs -- which have 8-byte pointers -- cannot be overlaid
+on it.  gePropdefsConvertToNative() (src/game/loadobjectmodel.c) converts the
+stream once at load time using the table this script emits.
+
+HOW IT WORKS
+------------
+1. Native layout comes from `clang -Xclang -fdump-record-layouts`, parsed into a
+   TREE (offsets + nesting), not from the /*0x..*/ comments.
+2. The N64 FILE layout is RE-LAID-OUT from that tree with N64 rules (every pointer
+   is 4 bytes / 4-aligned; everything else keeps its native size and alignment).
+3. Three static checks:
+     a. FATAL -- re-laying the same tree out with NATIVE rules must reproduce clang's
+        own sizeof for every record.  If it does not, the layout engine is wrong and
+        the N64 numbers cannot be trusted either.  (This is what caught `Mtxf mtx`,
+        a TYPEDEF'd union, being laid out as a 68-byte struct.)
+     b. FATAL -- the computed N64 record size may never be SMALLER than the size
+        MEASURED from the asset data (`/* Type = Door; index = 12 */` markers in
+        assets/obseg/setup/*.c); smaller means the struct is missing a field the
+        file carries.
+     c. FATAL for an index/ID segment, REPORTED for plain data -- whatever is clipped
+        off the end.  Three types legitimately clip trailing runtime-only fields.
+
+   🔴 BE HONEST ABOUT WHAT THESE CANNOT DO.  Check (a) does NOT catch the padding
+   shear described below: inflating a member by its own trailing padding leaves the
+   NATIVE total unchanged, because the alignment rounding that follows would have
+   added those bytes anyway.  Only the file side moves.  What actually catches this
+   class -- and the `ailist` class, which no static rule can see at all -- is the
+   RUNTIME census in gePropdefsConvertToNative(): always on, and it reports every
+   non-zero file word that no segment covers.  MEASURED: pre-fix binary, 66 such
+   words across 20 of the 40 stages; post-fix, 0 across all 40.
+
+🔴🔴 THE BUG THIS FILE WAS REWRITTEN TO KILL (2026-08-21)
+--------------------------------------------------------
+The previous version took each member's size to be `next_member_offset - offset`.
+In a native struct that is the member size PLUS the alignment padding in front of
+the next member.  Any member sitting immediately before an 8-aligned pointer was
+therefore emitted 4 bytes too LONG, and every file offset after it in that record
+was shifted.
+
+Concretely, `LinkRecord` (PROPDEF_LINK 14 / PROPDEF_SWITCH 19):
+
+      native                          old table            truth
+      0   header (4 bytes)            seg {0,0,8}          seg {0,0,4}
+      4   <alignment padding>         (swallowed)          --
+      8   union{first; Index1}        dropped              file 0x4 -> nat 0x8
+      16  union{second; Index2}       dropped              file 0x8 -> nat 0x10
+      24  next (runtime)              dropped              dropped
+
+The old 8-byte header segment copied file word 0x4 -- which is Index1 -- into the
+native PADDING at offset 4, where nothing reads it, and left Index1/Index2 zero.
+It ALSO made the GETV_PDEFGAP census under-report, because file word 0x4 counted
+as "covered".  Same one-word shear in 20 of the 34 record types.
+
+🔑 SECOND DEFECT, INDEPENDENT: pointer-typed members were dropped WHOLESALE, on the
+assumption that a pointer slot is always runtime state and always zero in the file.
+That is false for `union { T *ptr; s32 Index; }` -- LinkRecord.Index1/2,
+LockDoorRecord.Index1/2, SafeObjectRecord.Index1/2/3 -- where the file carries a
+SIGNED OFFSET the prop.c handlers add to the record's own pdefIndex, and false for
+VehichleRecord/AircraftRecord `ailist`, a plain pointer whose file slot carries an
+AI-list ID.  Those are emitted now, as separate segment ranges so the runtime can
+still A/B them (GETV_PDEFIDS / GETV_VEHAI).
+
+⚠️ A pointer slot the file populates cannot always be recognised from its type
+(`ailist` is the proof).  PTR_HOLDS_ID below is the escape hatch, and the runtime
+census in gePropdefsConvertToNative() -- which now runs UNCONDITIONALLY and shouts
+about any non-zero file word that no segment covers -- is the backstop that makes
+this class of bug impossible to reintroduce silently.
+
+USAGE
+-----
+    python3 tools/gen_propdef_layout.py            # from the ge-decomp root
+
+⚠️ Re-run this after ANY change to a propDef struct in src/bondtypes.h.
+"""
+
+import os, re, sys, subprocess
+
+ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+LAYOUT = os.environ.get('GE_LAYOUT_DUMP', '/tmp/gelayout.txt')
+
+RECORD_STRUCTS = """GuardRecord DoorRecord GlobalDoorScaleRecord ObjectRecord TintedGlassRecord
+KeyRecord CCTVRecord AmmoCrateRecord WeaponObjRecord MonitorObjRecord MultiMonitorObjRecord
+AutogunRecord LinkRecord HatRecord GuardAttributeRecord SafeObjectRecord MultiAmmoCrateRecord
+BodyArmourRecord TagObjectRecord RenameObjectRecord MissionObjectiveRecord PhotographObjectRecord
+EnterRoomRecord LockDoorRecord VehichleRecord AircraftRecord TankRecord CutsceneRecord
+GlassRecord SafeRecord PropDefHeaderRecord
+""".split()
+
+# These are plain `struct X` (no typedef), so sizeof() needs the `struct` keyword.
+# They are the ALIAS shapes below -- the structs prop.c WRITES a record through when it
+# reads it through a different one.
+ALIAS_STRUCTS = """setup_objective_text objective_entry criteria_roomentered
+criteria_deposit criteria_picture textoverride""".split()
+
+CFLAGS = ("-fms-extensions -include src/ge_port_decls.h -I . -I include -I include/PR -I src "
+          "-I src/game -I src/inflate -DVERSION_US -DLANG_US -DREFRESH_NTSC -DLEFTOVERDEBUG "
+          "-DLEFTOVERSPECTRUM -DBUGFIX_R0 -DTARGET_N64 -DGE_PORT_NATIVE -DNON_MATCHING=1 "
+          "-DAVOID_UB=1 -D_LANGUAGE_C=1 -w -ferror-limit=0").split()
+
+# 🔑 Plain (non-union) pointer members whose FILE slot holds an ID, not a pointer.
+# See the GETV-VEHAI note in loadobjectmodel.c: prop.c does
+#     pdef_veh->ailist = ailistFindById((s32)(uintptr_t)pdef_veh->ailist);
+# so the converter has to carry the 4 file bytes across.  There is no way to see
+# this from the type -- if you add one, add it here AND let the runtime census
+# confirm no other non-zero word is being dropped.
+PTR_HOLDS_ID = {
+    ('VehichleRecord', 'ailist'),
+    ('AircraftRecord', 'ailist'),
+}
+
+
+# --------------------------------------------------------------------------- dump
+def dump_layouts():
+    """Compile a throwaway TU that forces every record to be laid out, and capture
+    clang's record-layout dump.  Host arm64 and tvOS arm64 share the LP64 ABI, so the
+    host layout is the target layout."""
+    src = "#include <ultra64.h>\n#include <bondtypes.h>\n"
+    src += "".join("int ge_sz_%d = sizeof(%s);\n" % (i, n) for i, n in enumerate(RECORD_STRUCTS))
+    src += "".join("int ge_asz_%d = sizeof(struct %s);\n" % (i, n) for i, n in enumerate(ALIAS_STRUCTS))
+    src += "int main(void){return 0;}\n"
+    tu = os.path.join("/tmp", "ge_propdef_layout_probe.c")
+    open(tu, "w").write(src)
+    out = subprocess.run(["clang"] + CFLAGS +
+                         ["-Xclang", "-fdump-record-layouts", "-fsyntax-only", tu],
+                         cwd=ROOT, capture_output=True, text=True).stdout
+    open(LAYOUT, "w").write(out)
+
+
+if not os.environ.get("GE_LAYOUT_DUMP"):
+    dump_layouts()
+
+txt = open(LAYOUT).read()
+
+
+def die(msg):
+    sys.stderr.write("gen_propdef_layout.py: FATAL: %s\n" % msg)
+    sys.exit(1)
+
+
+class Node(object):
+    __slots__ = ('off', 'ind', 'text', 'kids', 'parent')
+
+    def __init__(self, off, ind, text):
+        self.off, self.ind, self.text, self.kids, self.parent = off, ind, text, [], None
+
+    # ---- text decoding -----------------------------------------------------
+    @property
+    def is_record(self):
+        return bool(self.kids)
+
+    @property
+    def is_union(self):
+        """clang prints `union X::(anonymous ...)` for anonymous unions, but a
+        TYPEDEF'd union member is printed as plain `Mtxf mtx` with no keyword.
+        The reliable structural tell is that every branch starts at the same
+        offset -- which no struct with two or more real members can do.
+        ⚠️ Measured: without the second test, `Mtxf mtx` (union{f32 m[4][4]; s32
+        unused}) was laid out as a 68-byte STRUCT, shifting everything after it
+        in DoorRecord and every other record that embeds a matrix."""
+        if self.text.startswith('union '):
+            return True
+        return len(self.kids) > 1 and all(k.off == self.kids[0].off for k in self.kids)
+
+    @property
+    def name(self):
+        """Member name, or None for anonymous members (the `inherits` base and the
+        anonymous unions/structs clang prints as `X::(anonymous at f:l:c)`)."""
+        t = self.text.strip()
+        if t.endswith(')'):
+            return None
+        m = re.search(r'([A-Za-z_]\w*)$', t)
+        if not m:
+            return None
+        # `struct PropDefHeaderRecord` with no member name -> the trailing identifier
+        # IS the type.  Those always come from `inherits`/`MemberRename` and clang
+        # prints them with a trailing space, which .strip() ate -- so detect by shape.
+        head = t[:m.start()].strip()
+        if head in ('struct', 'union', 'enum', ''):
+            return None
+        return m.group(1)
+
+    @property
+    def type_text(self):
+        n = self.name
+        t = self.text.strip()
+        return t[:len(t) - len(n)].strip() if n else t
+
+    @property
+    def is_pointer(self):
+        return '*' in self.type_text
+
+
+BITFIELDED = set()
+
+
+def parse_blocks(text):
+    """Split clang's dump into {record name: root Node}.  Built with an indent stack
+    in document order, so nesting is exact even when siblings share an offset."""
+    out = {}
+    for b in text.split('*** Dumping AST Record Layout'):
+        lines = [l for l in b.split('\n') if l.strip()]
+        if not lines:
+            continue
+        m = re.match(r'\s*(\d+) \| (?:(struct|union) )?([A-Za-z_]\w*)\s*$', lines[0])
+        if not m:
+            continue
+        name = m.group(3)
+        size = None
+        root = Node(0, -1, lines[0].strip())
+        stack = [root]
+        for l in lines[1:]:
+            ms = re.search(r'\[sizeof=(\d+), align=(\d+)\]', l)
+            if ms:
+                size = int(ms.group(1))
+                continue
+            # ⚠️ clang prints a BITFIELD with a `byte:bitlo-bithi |` offset column, which
+            # the member regex below does not match -- it would be skipped in SILENCE and
+            # the record would size short.  Flag the record instead; build() refuses to
+            # emit a layout for any record that reaches one, because N64 bitfields
+            # allocate from the opposite end of the word and need real modelling.
+            # (Most flagged records -- stan tiles, gbi commands -- are not propDefs and
+            # never reach build(), so this must not be a hard error at parse time.)
+            if re.match(r'^\s*\d+:\d+-\d+ \|', l):
+                BITFIELDED.add(name)
+                continue
+            mm = re.match(r'^(\s*)(\d+) \|(\s+)(.*?)\s*$', l)
+            if not mm:
+                continue
+            off, ind, t = int(mm.group(2)), len(mm.group(3)), mm.group(4)
+            while len(stack) > 1 and stack[-1].ind >= ind:
+                stack.pop()
+            n = Node(off, ind, t)
+            n.parent = stack[-1]
+            stack[-1].kids.append(n)
+            stack.append(n)
+        out[name] = (root, size)
+    return out
+
+
+BLOCKS = parse_blocks(txt)
+
+# ------------------------------------------------------------------ scalar sizes
+BUILTIN = {
+    'u8': (1, 1), 's8': (1, 1), 'char': (1, 1), 'unsigned char': (1, 1),
+    'signed char': (1, 1), '_Bool': (1, 1),
+    'u16': (2, 2), 's16': (2, 2), 'short': (2, 2), 'unsigned short': (2, 2),
+    'u32': (4, 4), 's32': (4, 4), 'f32': (4, 4), 'int': (4, 4),
+    'unsigned int': (4, 4), 'float': (4, 4),
+    'u64': (8, 8), 's64': (8, 8), 'f64': (8, 8), 'double': (8, 8),
+    'long long': (8, 8), 'unsigned long long': (8, 8),
+}
+_probed = {}
+
+
+def scalar_size_align(base):
+    """(size, align) of a leaf scalar type name.  Builtins from the table; anything
+    else -- typedefs, enums -- is asked of clang directly rather than guessed."""
+    if base in BUILTIN:
+        return BUILTIN[base]
+    if base in _probed:
+        return _probed[base]
+    if base in ('long', 'unsigned long'):
+        die("bare `long` in a propDef record: 8 bytes native, 4 on the N64. "
+            "Retype it to s32/s64 -- the generator will not guess.")
+    src = "#include <ultra64.h>\n#include <bondtypes.h>\n#include <stdio.h>\n"
+    src += "int main(void){printf(\"%%d %%d\\n\",(int)sizeof(%s),(int)_Alignof(%s));return 0;}\n" % (base, base)
+    tu = "/tmp/ge_pdef_scalar_probe.c"
+    open(tu, "w").write(src)
+    exe = "/tmp/ge_pdef_scalar_probe"
+    r = subprocess.run(["clang"] + CFLAGS + [tu, "-o", exe], cwd=ROOT,
+                       capture_output=True, text=True)
+    if r.returncode != 0:
+        die("cannot size leaf type %r:\n%s" % (base, r.stderr[-2000:]))
+    v = subprocess.run([exe], capture_output=True, text=True).stdout.split()
+    _probed[base] = (int(v[0]), int(v[1]))
+    return _probed[base]
+
+
+ARR = re.compile(r'^(.*?)((?:\[\d+\])+)$')
+
+
+def split_array(t):
+    """`MonitorRecord[4]` -> ('MonitorRecord', 4);  `f32[4][4]` -> ('f32', 16)."""
+    m = ARR.match(t)
+    if not m:
+        return t.strip(), 1
+    n = 1
+    for d in re.finditer(r'\[(\d+)\]', m.group(2)):
+        n *= int(d.group(1))
+    return m.group(1).strip(), n
+
+
+def record_leaf(node):
+    """🔑 clang expands a nested struct MEMBER inline, but NOT an ARRAY of structs --
+    `MonitorRecord Monitor[4]` prints as one opaque leaf.  If that element type
+    contains pointers its N64 stride is SMALLER than its native one, so it cannot be
+    copied as a blob.  MEASURED: MultiMonitorObjRecord holds four MonitorRecords, each
+    with two pointers, so the old blob copy was 8 bytes per element too wide and the
+    record came out 162 words against a measured 149.
+    Returns (record-name, element-count) when this leaf is an array/instance of a
+    record we have a layout for, else None."""
+    if node.kids or node.is_pointer:
+        return None
+    base, count = split_array(node.type_text)
+    base = re.sub(r'^(struct|union|enum)\s+', '', base).strip()
+    return (base, count) if base in BLOCKS and BLOCKS[base][0].kids else None
+
+
+def leaf_size_align(node, native):
+    """Size/alignment of a LEAF member, under native or N64 rules."""
+    t = node.type_text
+    if node.is_pointer:
+        # `T *`, `T **`, and pointer arrays `T *[N]`
+        n = 1
+        for m in re.finditer(r'\[(\d+)\]', t):
+            n *= int(m.group(1))
+        w = 8 if native else 4
+        return (w * n, w)
+    base, count = split_array(t)
+    stripped = re.sub(r'^(struct|union|enum)\s+', '', base).strip()
+    s, a = scalar_size_align(stripped if stripped in BUILTIN else base)
+    return (s * count, a)
+
+
+def index_union(node):
+    """A `union { T *ptr; s32 Index; }` -- a slot whose FILE content is a 4-byte
+    index/ID even though the native type is a pointer.  Returns True only when the
+    union mixes a pointer branch with a 4-byte integer branch."""
+    if not node.is_union or not node.kids:
+        return False
+    ptr = any(k.is_pointer for k in node.kids)
+    if not ptr:
+        return False
+    for k in node.kids:
+        if k.is_pointer or k.kids:
+            continue
+        s, _ = leaf_size_align(k, True)
+        if s == 4:
+            return True
+    return False
+
+
+def layout(node, native, struct_name, base_file, nat_base, sink):
+    """Lay `node`'s children out under native or N64 rules starting at file offset
+    `base_file`.  Native offsets come from clang's dump, which is absolute within the
+    block it belongs to, so `nat_base` re-bases them when a nested record's own block
+    is spliced in (see record_leaf).  Appends (fileoff, natoff, len, kind) to `sink`
+    -- kind 0 = plain data, 1 = union index slot, 2 = plain pointer holding an ID.
+    Returns (size, align)."""
+    if node.is_union:
+        # Every branch describes the SAME bytes, so only one may be emitted or the
+        # segments would overlap.  Take the largest (ties -> first declared).
+        best, size, align = None, 0, 0
+        for k in node.kids:
+            s, a = member(k, native, struct_name, base_file, nat_base, [])
+            align = max(align, a)
+            if s > size:
+                size, best = s, k
+        if best is not None:
+            member(best, native, struct_name, base_file, nat_base, sink)
+        return size, align
+    pos, align = 0, 1
+    for k in node.kids:
+        s, a = member(k, native, struct_name, base_file, nat_base, [])
+        if a:
+            pos = (pos + a - 1) // a * a
+        align = max(align, a)
+        member(k, native, struct_name, base_file + pos, nat_base, sink)
+        pos += s
+    if align:
+        pos = (pos + align - 1) // align * align
+    return pos, align
+
+
+def member(k, native, struct_name, file_off, nat_base, sink):
+    """One member: size/alignment under the chosen rules, emitting its file->native
+    segments into `sink` (pass [] to size without emitting)."""
+    if index_union(k):
+        if not native:
+            sink.append((file_off, nat_base + k.off, 4, 1))
+        return (8, 8) if native else (4, 4)
+    if k.kids:
+        return layout(k, native, struct_name, file_off, nat_base, sink)
+    sub = record_leaf(k)
+    if sub is not None:
+        name, count = sub
+        if name in BITFIELDED:
+            die("array-of-record member %s[%d] contains a bitfield; not modelled."
+                % (name, count))
+        root, nat_size = BLOCKS[name]
+        esz, ealign = layout(root, native, name, 0, 0, [])
+        if native and esz != nat_size:
+            die("array element %s lays out at %d bytes, clang says %d" % (name, esz, nat_size))
+        stride = nat_size if native else esz
+        for i in range(count):
+            layout(root, native, name, file_off + i * stride,
+                   nat_base + k.off + i * nat_size, sink)
+        return stride * count, ealign
+    s, a = leaf_size_align(k, native)
+    if k.is_pointer:
+        if not native and (struct_name, k.name) in PTR_HOLDS_ID:
+            sink.append((file_off, nat_base + k.off, 4, 2))
+        return s, a
+    if not native:
+        sink.append((file_off, nat_base + k.off, s, 0))
+    return s, a
+
+
+def build(struct_name):
+    if struct_name not in BLOCKS:
+        die("no clang layout for %s" % struct_name)
+    if struct_name in BITFIELDED:
+        die("%s contains a bitfield; N64 bitfield allocation order is the mirror of "
+            "arm64's and this generator does not model it." % struct_name)
+    root, native_size = BLOCKS[struct_name]
+    # (a) self-check: re-laying the tree out with NATIVE rules must reproduce clang.
+    ns, _ = layout(root, True, struct_name, 0, 0, [])
+    if ns != native_size:
+        die("native re-layout of %s gives %d bytes, clang says %d -- the layout "
+            "engine disagrees with the compiler, so no N64 number here is trustworthy."
+            % (struct_name, ns, native_size))
+    segs = []
+    fs, _ = layout(root, False, struct_name, 0, 0, segs)
+    segs.sort()
+    return segs, fs, native_size
+
+
+def coalesce(segs):
+    """Merge segments that are contiguous in BOTH the file and the native record and
+    share a kind.  Purely a size optimisation -- byte-for-byte identical copies."""
+    out = []
+    for s in segs:
+        if out and out[-1][3] == s[3] and out[-1][0] + out[-1][2] == s[0] \
+           and out[-1][1] + out[-1][2] == s[1]:
+            out[-1] = (out[-1][0], out[-1][1], out[-1][2] + s[2], out[-1][3])
+        else:
+            out.append(tuple(s))
+    return out
+
+
+# PROPDEF type -> (enum name, struct or None for verbatim, measured file words)
+T = [
+ ('PROPDEF_DOOR','DoorRecord',64),
+ ('PROPDEF_DOOR_SCALE','GlobalDoorScaleRecord',2),
+ ('PROPDEF_PROP','ObjectRecord',32),
+ ('PROPDEF_KEY','KeyRecord',33),
+ ('PROPDEF_ALARM','ObjectRecord',32),
+ ('PROPDEF_CCTV','CCTVRecord',59),
+ ('PROPDEF_MAGAZINE','AmmoCrateRecord',33),
+ ('PROPDEF_COLLECTABLE','WeaponObjRecord',34),
+ ('PROPDEF_GUARD','GuardRecord',7),
+ ('PROPDEF_MONITOR','MonitorObjRecord',64),
+ ('PROPDEF_MULTI_MONITOR','MultiMonitorObjRecord',149),
+ ('PROPDEF_RACK','ObjectRecord',32),
+ ('PROPDEF_AUTOGUN','AutogunRecord',54),
+ ('PROPDEF_LINK','LinkRecord',3),
+ ('PROPDEF_HAT','HatRecord',32),
+ ('PROPDEF_GUARD_ATTRIBUTE','GuardAttributeRecord',3),
+ ('PROPDEF_SWITCH','LinkRecord',4),
+ ('PROPDEF_AMMO','MultiAmmoCrateRecord',45),
+ ('PROPDEF_ARMOUR','BodyArmourRecord',34),
+ ('PROPDEF_TAG','TagObjectRecord',4),
+ ('PROPDEF_OBJECTIVE_START','MissionObjectiveRecord',4),
+ ('PROPDEF_OBJECTIVE_END',None,1),
+ ('PROPDEF_OBJECTIVE_DESTROY_OBJECT',None,2),
+ ('PROPDEF_OBJECTIVE_COMPLETE_CONDITION',None,2),
+ ('PROPDEF_OBJECTIVE_FAIL_CONDITION',None,2),
+ ('PROPDEF_OBJECTIVE_COLLECT_OBJECT',None,2),
+ ('PROPDEF_OBJECTIVE_DEPOSIT_OBJECT',None,2),
+ ('PROPDEF_OBJECTIVE_PHOTOGRAPH','PhotographObjectRecord',4),
+ ('PROPDEF_OBJECTIVE_NULL',None,1),
+ ('PROPDEF_OBJECTIVE_ENTER_ROOM','EnterRoomRecord',4),
+ ('PROPDEF_OBJECTIVE_DEPOSIT_OBJECT_IN_ROOM',None,5),
+ ('PROPDEF_OBJECTIVE_COPY_ITEM',None,3),
+ ('PROPDEF_WATCH_MENU_OBJECTIVE_TEXT',None,4),
+ ('PROPDEF_GAS_RELEASING','ObjectRecord',32),
+ ('PROPDEF_RENAME','RenameObjectRecord',10),
+ ('PROPDEF_LOCK_DOOR','LockDoorRecord',4),
+ ('PROPDEF_VEHICHLE','VehichleRecord',44),
+ ('PROPDEF_AIRCRAFT','AircraftRecord',45),
+ ('PROPDEF_GLASS','GlassRecord',32),
+ ('PROPDEF_SAFE','SafeRecord',32),
+ ('PROPDEF_SAFE_ITEM','SafeObjectRecord',5),
+ ('PROPDEF_TANK','TankRecord',56),
+ ('PROPDEF_CAMERAPOS','CutsceneRecord',7),
+ ('PROPDEF_TINTED_GLASS','TintedGlassRecord',37),
+ ('PROPDEF_END',None,1),
+]
+
+# ---------------------------------------------------------------------------
+# 🔑 A propDef record type can be READ through one struct and WRITTEN through a
+# DIFFERENT one.  prop.c's walk casts the objective records to the `criteria_*` /
+# `setup_objective_text` / `objective_entry` shapes in objective.c, and those carry a
+# runtime `next`/parent POINTER that the *Record struct above does not.  `natwords` has
+# to be the MAX over every struct that aliases the record, or the handler writes 8 bytes
+# past the end of the record and clobbers the type word of the NEXT one.
+ALIAS = {
+ 'PROPDEF_OBJECTIVE_START':                  'objective_entry',
+ 'PROPDEF_OBJECTIVE_PHOTOGRAPH':             'criteria_picture',
+ 'PROPDEF_OBJECTIVE_ENTER_ROOM':             'criteria_roomentered',
+ 'PROPDEF_OBJECTIVE_DEPOSIT_OBJECT_IN_ROOM': 'criteria_deposit',
+ 'PROPDEF_WATCH_MENU_OBJECTIVE_TEXT':        'setup_objective_text',
+ 'PROPDEF_RENAME':                           'textoverride',
+}
+
+
+def alias_natwords(name):
+    a = ALIAS.get(name)
+    if a is None:
+        return 0
+    return (BLOCKS[a][1] + 3) // 4
+
+
+CLIPPED = {}
+
+
+def clipped(struct, fw, propdef_name):
+    segs, fc, total = build(struct)
+    lim = fw * 4
+    # (b) the computed N64 size may only ever be LARGER than the measured one, and
+    # only by a trailing run of runtime-only (dropped) fields.
+    if fc < lim:
+        die("%s (%s): computed N64 record is %d bytes but the asset data measures "
+            "%d.  The struct is missing a field the file carries." % (propdef_name, struct, fc, lim))
+    # (c) an INDEX or ID segment must never be clipped -- those are the slots the
+    # file demonstrably populates, so losing one is the bug this file exists to kill.
+    # Plain data may be clipped: several records end in runtime-only fields the ROM
+    # never stored (CCTVRecord's `timer`/`convert_to_f32`/`unkF0..` are 9 such words).
+    # Clipped data is REPORTED, never silent.
+    keep, clip = [], []
+    for s in segs:
+        (fo, no, ln, kind) = s
+        if fo >= lim:
+            clip.append(s)
+            continue
+        if fo + ln > lim:
+            if kind != 0:
+                die("%s (%s): index/ID segment file[0x%x..0x%x) runs past the measured "
+                    "record size of %d bytes -- the layout is sheared, not clipped."
+                    % (propdef_name, struct, fo, fo + ln, lim))
+            clip.append((lim, no + (lim - fo), fo + ln - lim, kind))
+            s = (fo, no, lim - fo, kind)
+        keep.append(s)
+    for (fo, no, ln, kind) in clip:
+        if kind != 0:
+            die("%s (%s): index/ID segment at file 0x%x is entirely past the measured "
+                "record size of %d bytes." % (propdef_name, struct, fo, lim))
+    CLIPPED[propdef_name] = sum(ln for (_, _, ln, _) in clip)
+    return coalesce(keep), total
+
+
+out = []
+out.append("/* GENERATED by tools/gen_propdef_layout.py -- do not edit by hand.")
+out.append(" *")
+out.append(" * Maps each setup-file propDef record (N64 layout, 4-byte pointer slots)")
+out.append(" * onto its native arm64 record (8-byte pointers).  `filewords` was MEASURED")
+out.append(" * from the `/* Type = X; index = N *\\/` markers in assets/obseg/setup/*.c;")
+out.append(" * the segments are a full N64 re-layout of clang's own record dump, checked")
+out.append(" * three ways (native round-trip, measured size, no clipped data) -- see the")
+out.append(" * generator's header comment.")
+out.append(" *")
+out.append(" * SEGMENT ORDER PER TYPE:  [0, nsegs)            plain data")
+out.append(" *                          [nsegs, +nidxsegs)    union{T*;s32 Index} slots")
+out.append(" *                          [.., +nptridsegs)     plain pointers holding an ID")
+out.append(" * The last two ranges are the ones a naive 'pointers are runtime state'")
+out.append(" * converter drops on the floor; they are kept separate so the runtime can")
+out.append(" * still A/B them (GETV_PDEFIDS / GETV_VEHAI).")
+out.append(" */")
+out.append("#ifndef GE_PROPDEF_LAYOUT_INC")
+out.append("#define GE_PROPDEF_LAYOUT_INC")
+out.append("")
+out.append("typedef struct { u16 fileoff; u16 natoff; u16 len; } GePdefSeg;")
+out.append("typedef struct { u16 filewords; u16 natwords; u16 nsegs; u16 nidxsegs;")
+out.append("                 u16 nptridsegs; const GePdefSeg *segs; } GePdefLayout;")
+out.append("")
+emitted = {}
+for name, struct, fw in T:
+    if struct is None:
+        continue
+    key = (struct, fw)
+    if key in emitted:
+        continue
+    segs, total = clipped(struct, fw, name)
+    base = [s for s in segs if s[3] == 0]
+    idx = [s for s in segs if s[3] == 1]
+    pid = [s for s in segs if s[3] == 2]
+    sym = "ge_pdefsegs_%s_%d" % (struct, fw)
+    emitted[key] = (sym, total, base, idx, pid)
+    out.append("static const GePdefSeg %s[] = { %s };"
+               % (sym, " ".join("{%d,%d,%d}," % (s[0], s[1], s[2]) for s in base + idx + pid)))
+out.append("")
+verb = []
+layout_start = len(out)
+out.append("static const GePdefLayout ge_pdef_layout[PROPDEF_MAX] = {")
+for name, struct, fw in T:
+    if struct is None:
+        sym = "ge_pdefsegs_verbatim_%d" % fw
+        if ('*verbatim*', fw) not in emitted:
+            emitted[('*verbatim*', fw)] = True
+            verb.append("static const GePdefSeg %s[] = { {0,0,%d}, };" % (sym, fw * 4))
+        out.append("    [%s] = { %d, %d, 1, 0, 0, %s }," % (name, fw, max(fw, alias_natwords(name)), sym))
+    else:
+        sym, total, base, idx, pid = emitted[(struct, fw)]
+        out.append("    [%s] = { %d, %d, %d, %d, %d, %s },"
+                   % (name, fw, max(total // 4, alias_natwords(name)),
+                      len(base), len(idx), len(pid), sym))
+out.append("};")
+out[layout_start:layout_start] = verb
+out.append("")
+out.append("#endif /* GE_PROPDEF_LAYOUT_INC */")
+open(os.path.join(ROOT, 'src/game/ge_propdef_layout.inc.c'), 'w').write("\n".join(out) + "\n")
+
+# ------------------------------------------------------------------- human report
+sys.stderr.write("%-44s %-24s %6s %6s %5s %5s %5s %8s\n"
+                 % ("TYPE", "STRUCT", "fileW", "natW", "data", "idx", "ptrid", "clipB"))
+for name, struct, fw in T:
+    if struct is None:
+        continue
+    sym, total, base, idx, pid = emitted[(struct, fw)]
+    sys.stderr.write("%-44s %-24s %6d %6d %5d %5d %5d %8d\n"
+                     % (name, struct, fw, max(total // 4, alias_natwords(name)),
+                        len(base), len(idx), len(pid), CLIPPED.get(name, 0)))
+clipped_types = sorted(k for k, v in CLIPPED.items() if v)
+if clipped_types:
+    sys.stderr.write(
+        "\n⚠️  %d type(s) compute LARGER than the measured file record and were clipped:\n"
+        "    %s\n"
+        "    That is legitimate ONLY when the excess is trailing RUNTIME state the ROM\n"
+        "    never stored (CCTVRecord's timer/convert_to_f32/unkF0.., GlassRecord and\n"
+        "    SafeRecord's runtime `normal`).  It is ALSO what a one-word layout SHEAR\n"
+        "    looks like -- the defect this generator was rewritten to kill.  🔑 The\n"
+        "    static checks CANNOT tell those two apart: inflating a member by its own\n"
+        "    trailing padding leaves the native total unchanged, so the round-trip check\n"
+        "    stays green.  The thing that CAN tell them apart is the runtime census in\n"
+        "    gePropdefsConvertToNative(), which is always on and reports any NON-ZERO\n"
+        "    file word no segment covers.  If you changed a struct and this list grew,\n"
+        "    boot every stage and read that line before believing the clip.\n" %
+        (len(clipped_types), ", ".join(clipped_types)))
+print("wrote src/game/ge_propdef_layout.inc.c (%d types, checks a/b/c passed)"
+      % len([1 for n, s, f in T if s is not None]))
