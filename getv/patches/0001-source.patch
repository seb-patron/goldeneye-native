+/* tvOS port: byte-swap a compact-MIDI header in place.
+ *
+ * ALCMidiHdr is `u32 trackOffset[16]; u32 division;` -- 17 big-endian words at the
+ * start of every decompressed sequence. alCSeqNew() reads them directly, so without
+ * this every track offset is nonsense and `qnpt = 1.0/division` is a division by a
+ * garbage tick rate.
+ *
+ * Only the header needs it. The body is a byte stream -- variable-length delta
+ * times, status bytes, data bytes -- and has no multi-byte scalars, which is why 68
+ * bytes is the whole conversion. Perfect Dark's asset preprocessor does the same
+ * (preprocessALCMidiHdr), confirming that nothing further is needed.
+ *
+ * Must run after decompressdata() and before alCSeqNew(), once per load. It is
+ * self-inverse, so calling it twice on the same buffer puts the header back to
+ * big-endian.
+ */
+static void gePortSwapCMidiHeader(void *data)
+{
+    u8 *p = (u8 *)data;
+    s32 i;
+
+    for (i = 0; i < 17; i++)
+    {
+        u8 t;
+
+        t = p[i * 4 + 0]; p[i * 4 + 0] = p[i * 4 + 3]; p[i * 4 + 3] = t;
+        t = p[i * 4 + 1]; p[i * 4 + 1] = p[i * 4 + 2]; p[i * 4 + 2] = t;
+    }
+}
+#endif
