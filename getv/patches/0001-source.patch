+/* ---------------------------------------------------------------------------
+ * StandTile bitfield endianness.
+ *
+ * A tile header is two s16 halves of packed nibbles:
+ *     mid  = { special, r, g, b }          (StandTileHeaderMid)
+ *     tail = { pointCount, C, D, E }       (StandTileHeaderTail)
+ * IDO/MIPS is big-endian, so it allocates the first declared bitfield into the
+ * most significant nibble -- pointCount at bits 12-15, E at bits 0-3. The whole
+ * decomp is written against those positions, e.g. `(tile->tail.half >> 12) & 0xf`
+ * for the point count. clang on arm64 is little-endian and allocates the first
+ * declared bitfield into the least significant nibble, so every one of those
+ * hardcoded shifts reads the wrong field here.
+ *
+ * The stan assets are generated C compiled by this same compiler
+ * (assets/obseg/stan/*.c -> `..., 3, 0x0, 0x1, 0x2, {points}`), so the struct and
+ * the data agree with each other -- it is only the hardcoded shifts that are wrong.
+ *
+ * Measured on the Dam: tail = 0x2103. Real pointCount = 3 (low nibble); the
+ * decomp's `(0x2103 >> 12) & 0xf` yields 2. That happened to still give 32 bytes
+ * because list_of_tilesizes[0..3] are all 32, which is why the bug hid -- but a
+ * 4-point tile (tail 0x3104) reads 3 instead of 4 and steps 32 bytes instead of 40,
+ * landing the tile walk in the middle of a point array.
+ *
+ * GE_NIB(half, shift) takes the big-endian shift the decomp was written with and
+ * reads the corresponding nibble wherever this compiler actually put it. Use it
+ * instead of `(x >> 12) & 0xf` / `(x >> 8) & 0xf` / ... in tile header code.
+ * Only valid for the 4-nibble halves above; do not use it on the points' `link`.
+ * --------------------------------------------------------------------------- */
+#ifdef GE_PORT_NATIVE
+#define GE_NIB(half, beShift)  (((half) >> (12 - (beShift))) & 0xF)
+#else
+#define GE_NIB(half, beShift)  (((half) >> (beShift)) & 0xF)
+#endif
+
+/* The packed tile name/id. On the N64 the first 32-bit word of a tile is laid out
+ * as [ idHi:16 | idLo:8 | room:8 ] and the code reaches into it with
+ * `*(u16 *)tile` and `((u8 *)tile)[2]`. Here it is the `u32 id : 24` bitfield plus
+ * `u8 room`, so the same two pieces are id>>8 and id&0xff. The top bit of idHi
+ * doubles as the tile-walk VISITED flag, which stanFillSearch toggles in place --
+ * on little-endian `*(u16 *)tile ^= 0x8000` would flip a bit in the middle of the
+ * id instead, silently corrupting the tile's name. */
+#define GE_STAN_IDHI(tile)      (((tile)->id >> 8) & 0xFFFF)
+#define GE_STAN_IDLO(tile)      ((tile)->id & 0xFF)
+#define GE_STAN_VISITED(tile)   (((tile)->id >> 23) & 1)
+#define GE_STAN_VISIT_FLIP(tile) ((tile)->id ^= 0x800000u)
+
