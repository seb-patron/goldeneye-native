+ * The point is to make a level attempt assertable. Frame counts and triangle counts say the
+ * renderer is busy; they cannot say Bond reached the objective. This prints where each
+ * player is, how many objectives the mission has, each status, and whether the mission is
+ * complete -- which is what a script needs to decide whether a run passed. */
+/* Position of one player, for the script host in getv/port/src/ge_lua.c.
+ *
+ * It lives here rather than in the port layer for the same reason gePortStateDump() does:
+ * struct player is a game type, and the offset of pos within it is not the N64 offset
+ * (the 32-bit pointers ahead of it are 64-bit here), so any port-side copy of that number
+ * would be wrong now or wrong later. Returns 0 when the slot is empty, which a script
+ * sees as nil.
+ *
+ * g_playerPointers, not g_CurrentPlayer: that pointer is swapped as each viewport is
+ * drawn, so in split screen it names whichever player was rendered last. */
+int gePortPlayerPos(int idx, f32 *out)
+{
+    extern struct player *g_playerPointers[4];
+
+    if (idx < 0 || idx > 3 || g_playerPointers[idx] == NULL) {
+        return 0;
+    }
+    out[0] = g_playerPointers[idx]->pos.x;
+    out[1] = g_playerPointers[idx]->pos.y;
+    out[2] = g_playerPointers[idx]->pos.z;
+    return 1;
+}
+
+
+void gePortStateDump(int frame)
+{
+    s32 i;
+    s32 n = getPlayerCount();
+
+    /* Why the co-op players do not move, if they do not.
+     *
+     * lvlManageMpGame() (lv.c:1098) sets g_ClockTimer to 0 whenever controls are locked or
+     * the game is paused, and to speedgraphframes otherwise. A zero clock means zero delta,
+     * and zero delta freezes every player including player 0 while rendering carries on
+     * normally -- which is exactly the reported symptom: p0 travels 72.5 units in co-op
+     * against 16930 solo, and separating the spawns (GETV_COOP_SPREAD) did not change it.
+     *
+     * Printed rather than assumed, because the alternative explanations -- no input reaching
+     * players 1-3, spawn collision, missing pads -- have already been ruled out one at a
+     * time and this is the next candidate rather than a conclusion. */
+    {
+        extern s32 g_ControlsLockedFlag;
+        extern s32 g_ClockTimer;
+        extern s32 checkGamePaused(void);
+        printf("[getv][state] locked=%d paused=%d clock=%d",
+               (int) g_ControlsLockedFlag, (int) checkGamePaused(), (int) g_ClockTimer);
+    }
+    printf("[getv][state] f=%d players=%d", frame, (int) n);
+
