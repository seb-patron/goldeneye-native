+/* Convert the whole graph. Returns the native root, or NULL. */
+static ModelNode *ge_model_convert(uintptr_t base, uintptr_t rootptr, const char *what)
+{
+    u32 stack[GE_MODEL_MAXNODES];
+    s32 sp = 0;
+    s32 i;
+    u32 rootoff;
+
+    if (base == 0 || rootptr == 0) {
+        return NULL;
+    }
+    ge_conv_count = 0;
+    ge_vtx_reset();
+    rootoff = (u32)(rootptr - base) + GE_MODEL_VMA;
+    stack[sp++] = rootoff;
+
+    /* Pass 1 -- discover every reachable node and allocate its native record. */
+    while (sp > 0 && ge_conv_count < GE_MODEL_MAXNODES) {
+        u32 off = stack[--sp];
+        const u8 *f;
+        ModelNode *nn;
+        u32 nxt, chld;
+
+        if (off < GE_MODEL_VMA || ge_conv_lookup(off) != NULL) {
+            continue;
+        }
+        f = (const u8 *)(base + (off - GE_MODEL_VMA));
+        nn = mempAllocBytesInBank(sizeof(ModelNode), MEMPOOL_STAGE);
+        if (nn == NULL) {
+            break;
+        }
+        bzero(nn, sizeof(ModelNode));
+        nn->Opcode = ge_be16(f);
+
+        ge_conv_off[ge_conv_count] = off;
+        ge_conv_new[ge_conv_count] = nn;
+        ge_conv_count++;
+
+        nxt  = ge_be32(f + 12);
+        chld = ge_be32(f + 20);
+        if (nxt  && sp < GE_MODEL_MAXNODES - 1) { stack[sp++] = nxt; }
+        if (chld && sp < GE_MODEL_MAXNODES - 1) { stack[sp++] = chld; }
+    }
+
+    /* Pass 2 -- links and rodata, now that every node has an address. */
+    for (i = 0; i < ge_conv_count; i++) {
+        const u8  *f  = (const u8 *)(base + (ge_conv_off[i] - GE_MODEL_VMA));
+        ModelNode *nn = ge_conv_new[i];
+        u32 type = nn->Opcode & 0xff;
+
+        nn->Data   = ge_conv_rodata(base, type, ge_be32(f + 4));
+        nn->Parent = ge_conv_lookup(ge_be32(f + 8));
+        nn->Next   = ge_conv_lookup(ge_be32(f + 12));
+        nn->Prev   = ge_conv_lookup(ge_be32(f + 16));
+        nn->Child  = ge_conv_lookup(ge_be32(f + 20));
+
+        /* GROUP's ChildGroup is a node offset stashed by ge_conv_rodata(). */
+        if ((type == MODELNODE_OPCODE_GROUP || type == MODELNODE_OPCODE_OP03)
+            && nn->Data != NULL) {
+            u32 cg = (u32)(uintptr_t)nn->Data->Group.ChildGroupNode;
+            nn->Data->Group.ChildGroupNode = cg ? ge_conv_lookup(cg) : NULL;
+        }
+        /* HEADER/OP20's FirstGroup and SHADOW's Header are node offsets too. */
+        if ((type == MODELNODE_OPCODE_HEADER || type == MODELNODE_OPCODE_OP20)
+            && nn->Data != NULL) {
+            u32 fg = (u32)(uintptr_t)nn->Data->Header.FirstGroupNode;
+            nn->Data->Header.FirstGroupNode = fg ? ge_conv_lookup(fg) : NULL;
+        }
+        if (type == MODELNODE_OPCODE_LOD && nn->Data != NULL) {
+            u32 af = (u32)(uintptr_t)nn->Data->LOD.Affects;
+            nn->Data->LOD.Affects = af ? ge_conv_lookup(af) : NULL;
+        }
+        if (type == MODELNODE_OPCODE_SHADOW && nn->Data != NULL) {
+            u32 hd = (u32)(uintptr_t)nn->Data->Shadow.HeaderNode;
+            nn->Data->Shadow.HeaderNode = hd ? ge_conv_lookup(hd) : NULL;
+        }
+        /* SWITCH's Controls is a node offset too -- see the case in ge_conv_rodata(). */
+        if (type == MODELNODE_OPCODE_SWITCH && nn->Data != NULL) {
+            u32 cs = (u32)(uintptr_t)nn->Data->Switch.Controls;
+            nn->Data->Switch.Controls = cs ? ge_conv_lookup(cs) : NULL;
+        }
+        /* Likewise BSP's two child links. */
+        if (type == MODELNODE_OPCODE_BSP && nn->Data != NULL) {
+            u32 l = (u32)(uintptr_t)nn->Data->BSP.leftChild;
+            u32 r = (u32)(uintptr_t)nn->Data->BSP.rightChild;
+            nn->Data->BSP.leftChild  = l ? ge_conv_lookup(l) : NULL;
+            nn->Data->BSP.rightChild = r ? ge_conv_lookup(r) : NULL;
+        }
+    }
+
+    osSyncPrintf("[getv] modelconv %s: %d nodes converted (file %u bytes/node -> %u)\n",
+                 what, ge_conv_count, (u32)sizeof(ModelNode_file), (u32)sizeof(ModelNode));
+    /* Cumulative texture-expansion tally, printed once per model file so DAM
+     * and stage 90 are directly comparable with one grep. */
+    {
+        /* Per-file deltas, not the running totals: a cumulative counter cannot tell you
+         * which model is the untextured one, which is the entire question. */
+        static unsigned long p_lists = 0, p_noop = 0, p_exp = 0, p_timg = 0, p_nores = 0, p_nocomb = 0;
+        osSyncPrintf("[getv] gdltally: %-24s lists=%lu withnoop=%lu expanded=%lu "
+                     "out_settimg=%lu NORESOLVE=%lu nocombine=%lu\n",
+                     ge_model_convert_name,
+                     ge_gdl_lists_total - p_lists, ge_gdl_lists_withnoop - p_noop,
+                     ge_gdl_texexpand_lists - p_exp, ge_gdl_out_settimg - p_timg,
+                     ge_gdl_lists_noresolve - p_nores,
+                     ge_gdl_nocombine - p_nocomb);
+        osSyncPrintf("[getv] modeltype: %-24s t0(NoSetup)=%lu t1=%lu t2=%lu t3=%lu t4=%lu\n",
+                     ge_model_convert_name, ge_modeltype_hist[0], ge_modeltype_hist[1],
+                     ge_modeltype_hist[2], ge_modeltype_hist[3], ge_modeltype_hist[4]);
+        { int z; for (z = 0; z < 8; z++) { ge_modeltype_hist[z] = 0; } }
+        p_lists = ge_gdl_lists_total; p_noop = ge_gdl_lists_withnoop;
+        p_exp = ge_gdl_texexpand_lists; p_timg = ge_gdl_out_settimg;
+        p_nores = ge_gdl_lists_noresolve; p_nocomb = ge_gdl_nocombine;
+    }
+    /* The "exactly once" claim, as data. `base` is printed so a repeat conversion of the
+     * same loaded file -- the one thing an in-place swap cannot survive -- is greppable
+     * rather than assumed impossible. skipped>0 is the dedupe doing its job; conflicts>0
+     * would mean an array is claimed as both render and collision and the layout choice
+     * is wrong somewhere. */
+    osSyncPrintf("[getv] vtxswap %s: base=%p arrays=%d swapped=%d skipped_dupe=%d "
+                 "conflicts=%d untracked=%d\n",
+                 what, (void *)base, ge_vtx_ranges, ge_vtx_swapped, ge_vtx_skipped,
+                 ge_vtx_conflicts, ge_vtx_overflow);
+    /* gvtx_seen proves the bounds probe actually ran; gvtx_outside == 0 is what says
+     * numVertices really is the bound the display list works within. maxabs is the
+     * plausibility check: after << before is the signature of a correct swap. */
+    osSyncPrintf("[getv] vtxswap %s: gvtx_seen=%d gvtx_outside=%d | max|coord| "
+                 "big-endian(now)=%d vs byte-reversed(before)=%d\n",
+                 what, ge_vtx_gvtx_seen, ge_vtx_gvtx_outside,
+                 ge_vtx_maxabs_after, ge_vtx_maxabs_before);
+    /* The breakdown that makes gvtx_outside actionable. seg4 = per-node vertex base
+     * (offset-checked), seg5 = the file (address-checked), segother != 0 would be a
+     * real unresolved address. over = a slice running past numVertices; split = a
+     * single G_VTX load whose own coords are two disjoint clusters, which is the
+     * signature a mis-resolved vertex pointer would actually leave. */
+    osSyncPrintf("[getv] vtxswap %s: gvtx seg4=%d seg5=%d segother=%d | "
+                 "slice_overrun=%d slice_split=%d\n",
+                 what, ge_vtx_gvtx_seg4, ge_vtx_gvtx_seg5, ge_vtx_gvtx_segoth,
+                 ge_vtx_gvtx_over, ge_vtx_slice_split);
+    {   /* Texture-bind health, cumulative. A miss emits NO bind at all, so the
+         * following triangles keep the previous texture -- the one mis-selection mode
+         * that is invisible to every renderer-side probe. See tex.c texLoadFromGdl(). */
+        extern long ge_texbind_total, ge_texbind_miss, ge_texbind_1x1, ge_texbind_wrongnum;
+        extern long ge_texrow_total, ge_texrow_misaligned;
+        extern long ge_texout_zlib, ge_texout_zlib_odd;
+        extern long ge_texout_nonzlib, ge_texout_nonzlib_odd;
+        extern long ge_texalign_calls, ge_texalign_nonci;
+        extern long ge_texpool_realigned;
+        osSyncPrintf("[getv] texrow: decoded_rows=%ld dst_not_8aligned=%ld | "
+                     "zlib=%ld(odd %ld) nonzlib=%ld(odd %ld) | align_calls=%ld nonCI=%ld "
+                     "poolrealigned=%ld\n",
+                     ge_texrow_total, ge_texrow_misaligned,
+                     ge_texout_zlib, ge_texout_zlib_odd,
+                     ge_texout_nonzlib, ge_texout_nonzlib_odd,
+                     ge_texalign_calls, ge_texalign_nonci, ge_texpool_realigned);
+        osSyncPrintf("[getv] trispan %s (model=%s): tris=%ld cross=%ld unset=%ld huge=%ld\n",
+                     what, ge_model_convert_name, ge_trispan_tris, ge_trispan_cross,
+                     ge_trispan_unset, ge_trispan_huge);
+        osSyncPrintf("[getv] texbind %s (model=%s): binds=%ld miss=%ld deg1x1=%ld "
+                     "wrongnum=%ld\n",
+                     what, ge_model_convert_name, ge_texbind_total, ge_texbind_miss,
+                     ge_texbind_1x1, ge_texbind_wrongnum);
+    }
+    return ge_conv_count ? ge_conv_new[0] : NULL;
+}
