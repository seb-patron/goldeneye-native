+/* ==================== GETV_CLOCK -- HUD countdown-timer probe ====================
+ * Separates "the clock never starts" from "the clock runs but is not drawn".
+ *   clock_time        f32, ticks down in if_enabled_reset_clock() (propobj.c)
+ *   clock_enable      set by hud_countdown_start / _stop
+ *   clock_drawn_flag  a lock mask -- countdownTimerRender() draws only when it is 0.
+ *                     bit1 AI hud_countdown_show/hide - bit2 plastique - bit4 watch pause
+ *                     bit8 damage flash - bit16 AI bond_disable/enable_control
+ * Also names every AI list that actually executes, so "the list never ran" is visible.
+ * Diagnostic only: with GETV_CLOCK unset nothing in this file changes behaviour. */
+int ge_clock_probe_on(void)
+{
+    static int cached = -1;
+    if (cached < 0) { const char *e = getenv("GETV_CLOCK"); cached = (e && *e == '1'); }
+    return cached;
+}
+
+void ge_clock_probe(void)
+{
+    static int   tick = 0;
+    static f32   last_t = -12345.0f;
+    static s32   last_e = -1, last_d = -1;
+    if (!ge_clock_probe_on()) return;
+    tick++;
+    if (clock_enable != last_e || clock_drawn_flag != last_d) {
+        printf("[getv][clock] t=%d STATE CHANGE enable=%d drawn_flag=0x%x time=%.2f (%.2fs)\n",
+               tick, clock_enable, clock_drawn_flag, clock_time, clock_time / 60.0f);
+        fflush(stdout);
+        last_e = clock_enable; last_d = clock_drawn_flag;
+    }
+    if ((tick % 60) == 1 || (last_t != clock_time && (tick % 15) == 1)) {
+        printf("[getv][clock] t=%d time=%.2f (%.2fs) enable=%d drawn_flag=0x%x\n",
+               tick, clock_time, clock_time / 60.0f, clock_enable, clock_drawn_flag);
+        fflush(stdout);
+    }
+    last_t = clock_time;
+}
+
