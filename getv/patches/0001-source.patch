+    TRUE,           /* zbufferenabled */
+    3,              /* flags          <- the field that was wrong */
+    NULL,           /* gdl            */
+    NULL,           /* mtxlist        */
+    0, 0, 0,        /* unk14 unk18 unk1c */
+    0, 0, 0, 0,     /* unk20 unk24 unk28 unk2c */
