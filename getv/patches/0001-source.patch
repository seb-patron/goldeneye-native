+            nchr++;
+            if (firstchr == NULL) { firstchr = p; }
+        }
+        else if (p->type == PROP_TYPE_OBJ)
+        {
+            nobj++;
+            if (p->obj != NULL && p->obj->type == PROPDEF_VEHICHLE)
+            {
+                nveh++;
+                if (vehprop == NULL) { vehprop = p; }
+            }
+        }
+    }
+
+    {
+        static f32 chrsnap[64][3];
+        static s32 nsnap = 0;
+        s32 idx = 0;
+        for (p = chrpropGetActiveTail(); p != NULL && idx < 64; p = p->prev)
+        {
+            if (p->type != PROP_TYPE_CHR) { continue; }
+            if (idx < nsnap)
+            {
+                f32 dx = p->pos.f[0] - chrsnap[idx][0];
+                f32 dy = p->pos.f[1] - chrsnap[idx][1];
+                f32 dz = p->pos.f[2] - chrsnap[idx][2];
+                f32 d2 = dx*dx + dy*dy + dz*dz;
+                if (d2 > 0.0f) { nchrmoved++; }
+                if (d2 > chrmax) { chrmax = d2; }
+            }
+            chrsnap[idx][0] = p->pos.f[0];
+            chrsnap[idx][1] = p->pos.f[1];
+            chrsnap[idx][2] = p->pos.f[2];
+            idx++;
+        }
+        nsnap = idx;
+        (void) firstchr; (void) lastchr; (void) havechr;
+    }
+
+    if (vehprop != NULL)
+    {
+        struct VehichleRecord *v = (struct VehichleRecord *) vehprop->obj;
+        f32 d2 = -1.0f;
+        if (haveveh)
+        {
+            f32 dx = vehprop->pos.f[0] - lastveh[0];
+            f32 dy = vehprop->pos.f[1] - lastveh[1];
+            f32 dz = vehprop->pos.f[2] - lastveh[2];
+            d2 = dx*dx + dy*dy + dz*dz;
+        }
+        lastveh[0] = vehprop->pos.f[0];
+        lastveh[1] = vehprop->pos.f[1];
+        lastveh[2] = vehprop->pos.f[2];
+        haveveh = 1;
+
+        if (frame == 1)
+        {
+            s32 k;
