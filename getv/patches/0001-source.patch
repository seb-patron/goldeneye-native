+ if (pdefids < 0) { e = getenv("GETV_PDEFIDS"); pdefids = !(e && *e == '0'); }
+ if (vehai   < 0) { e = getenv("GETV_VEHAI"); vehai   = !(e && *e == '0'); }
+
+ fpos = 0;
+ npos = 0;
+ while (fpos < filewords)
+        {
+ const u8 *f = src + fpos * 4;
+ u8 *n = ((u8 *) g_gePropdefsNative) + npos * 4;
+ u8 type = ((const PropDefHeaderRecord *) f)->type;
+ const GePdefLayout *L = ge_pdef_layout_for(type);
+ s32 nall = L->nsegs + L->nidxsegs + L->nptridsegs;
+ s32 i;
+
+            /* Three ranges, three independent gates -- so GETV_PDEFIDS=0 and
+             * GETV_VEHAI=0 are separable arms and neither implies the other. */
+ for (i = 0; i < L->nsegs; i++)
+            {
+ memcpy(n + L->segs[i].natoff, f + L->segs[i].fileoff, L->segs[i].len);
+            }
+ if (pdefids)
+            {
+ for (i = L->nsegs; i < L->nsegs + L->nidxsegs; i++)
+                {
+ memcpy(n + L->segs[i].natoff, f + L->segs[i].fileoff, L->segs[i].len);
+                }
+            }
+ if (vehai)
+            {
+ for (i = L->nsegs + L->nidxsegs; i < nall; i++)
+                {
+ memcpy(n + L->segs[i].natoff, f + L->segs[i].fileoff, L->segs[i].len);
+                }
+            }
+
+            /* Backstop: a file word that no segment covers must be zero. Two cases
+             * where it was not, both silent:
+             *   - VehichleRecord/AircraftRecord.ailist (file 0x80) carried an AI-list
+             * ID, so the Dam truck ran g_GlobalAILists[0] and never moved;
+             *   - LinkRecord/LockDoorRecord/SafeObjectRecord Index1..3 carried signed
+             * pdefIndex offsets, so switch->door, padlock and safe links were never
+             * established on any level, and the only diagnostic that would have
+             * said so sits behind #ifdef DEBUG.
+             * This check is always on (a few compares per record, once per level load)
+             * so the class cannot recur silently. GETV_PDEFGAP=1 makes it print every
+             * instance instead of the first few plus a total. */
+            {
+ static s32 gap = -1;
+ s32 fb, j;
+ if (gap < 0) { e = getenv("GETV_PDEFGAP"); gap = (e && *e == '1'); }
+
+ for (fb = 0; fb < L->filewords * 4; fb += 4)
+                {
+ s32 covered = 0;
+ u32 w;
+ for (j = 0; j < nall; j++)
+                    {
+ if (fb >= L->segs[j].fileoff && fb < L->segs[j].fileoff + L->segs[j].len)
+                        { covered = 1; break; }
+                    }
+ if (covered) { continue; }
+ memcpy(&w, f + fb, 4);
+ if (w != 0)
+                    {
+ lost++;
+ if (gap || reported < 8)
+                        {
+ reported++;
+ osSyncPrintf("[pdefgap] type=%d fileword=%d fileoff=0x%x ""LOST value=0x%08x -- a file word no segment covers. ""Add it to gen_propdef_layout.py.\n",
+                                         (s32) type, (s32) (fpos), (unsigned) fb, (unsigned) w);
+                        }
+                    }
+                }
+            }
+
+ fpos += L->filewords;
+ npos += L->natwords;
+        }
+
+ if (lost != 0)
+        {
+ osSyncPrintf("[pdefgap] %d non-zero file word(s) dropped by the propDef ""converter. See tools/gen_propdef_layout.py.\n", lost);
+        }
+ else
+        {
+ osSyncPrintf("[pdef] converter: %d file words -> %d native words, ""0 non-zero words dropped (pdefids=%d vehai=%d)\n",
+ filewords, natwords, pdefids, vehai);
+        }
+    }
+
+ return g_gePropdefsNative;
