+/* GETV-VISSWAP -- the global visibility command list was never byte-swapped. This is
+ * The byte-swap rule again, on the last unconverted consumer of the bg blob:
+ * bgSwapRoomTable(), bgSwapPortalTable() and bgSwapPortalGeometry() covered the room
+ * table, the portal table and the portal polygons; header word 3 -- the envdata /
+ * global-visibility command stream -- was left big-endian.
+ *
+ * Why it looked fine: every record is 8 bytes, `u8 type; u8 pad[3]; s32 arg`. The opcode
+ * and length are single bytes and therefore endianness-immune, so
+ * parse_global_vis_command_list() walked the stream correctly and every opcode it
+ * dispatched on was right. Only the arguments -- which live in the following record and
+ * are read as `cmd[1].arg` -- were byte-reversed. A room id of 57 read as 0x39000000 =
+ * 956301312.
+ *
+ * The cost, on FRIGATE / stage 26 (GETV_VISTRACE=1):
+ *   - record 6: VISOP_PUSH_IF_ROOM_IN_RANGE, args 57..58 -- the boat Bond starts on;
+ *   - records 9..28: VISOP_ADD_VISIBLE_ROOM, args 1 and 35..50 -- the frigate's hull.
+ * The range test compared curroom 57 against 956301312..973078528, so it was always
+ * false, the IF body never executed, and no hull room was ever added. FRIGATE drew
+ * `drawn=1` of 59 rooms -- open water and nothing else -- while `onscr=49` reported the
+ * geometry as present and on screen.
+ *
+ * This is why it presented as a portal bug and is not one. Rooms 57 and 58 are genuinely
+ * outside the portal graph (`adj=0`: of 94 portals, zero touch room 57 -- verified with
+ * GETV_PORTALCENSUS, and the portal table decodes cleanly, ids 1..56). Exterior rooms
+ * are not portal-connected by design; the visibility command list is the mechanism that
+ * draws them, and it was inert.
+ *
+ * The region uses the same 8-byte stride and terminator both consumers already assume:
+ * the ALT-portal loop in load_bg_file() walks this table record-by-record until
+ * `type == 0`, and VISOP_END is 0. So a linear record walk to the first zero type byte
+ * is exactly the extent, and it visits argument records too -- which a
+ * `cmd += cmd->length` walk would skip, since that is precisely how they are hidden from
+ * the opcode dispatcher.
+ *
+ * Must run before the ALT-portal loop. That loop calls getIndexOfPORTALID() on the
+ * `data` word of every type==ENVIRONMENTDATA_ALT record and writes an index back; it has
+ * to read a native PORTALID and write a native index, or it just relocates the damage.
+ *
+ * GETV_VISSWAP=0 restores the unswapped table for a same-binary A/B. */
+static void bgSwapVisCommandTable(s32 *pc)
+{
+    static s32 on = -1;
+    u8 *rec;
+    s32 i;
+
+    if (on < 0)
+    {
+        const char *e = getenv("GETV_VISSWAP");
+        on = (e && *e == '0') ? 0 : 1;
+    }
+
+    if (pc == NULL || !on)
+    {
+        return;
+    }
+
+    rec = (u8 *) pc;
+
+    /* 4096 records is ~8x the largest stream in any bg file and exists only so a corrupt
+     * table cannot run off the end of the buffer. */
+    for (i = 0; i < 4096; i++)
+    {
+        u32 v = bgBE32(rec + 4);
+
+        /* Swap the terminator's own argument word too (it is 0 either way), then stop. */
+        *(u32 *) (rec + 4) = v;
+
+        if (rec[0] == VISOP_END)
+        {
+            return;
+        }
+
+        rec += 8;
+    }
+
+    osSyncPrintf("[getv] bgvis: visibility command table has no terminator in 4096 records\n");
+}
+
+/* Byte-swap the portal polygons. A bg_portal_entry is `u8 numPoints; u8 pad[3];` then
+ * numPoints coord3ds -- and those are f32s straight out of a big-endian file, so every
+ * one of them has to be swapped too. Nothing did this before; swapping the table alone
+ * only fixes which entry you land on, not what you read once you are there.
+ *
+ * The obvious implementation is wrong: you cannot loop over the portal table and swap
+ * each entry it points at. Across all 25 non-empty bg files, 47 table records share a
+ * bg_portal_entry with another record, so a per-record loop swaps those 47 polygons
+ * twice and hands them back byte-reversed. That would not look wrong until one specific
+ * portal on one specific level culled strangely.
+ *
+ * So this walks the polygon region linearly instead, entry by entry, which visits each
+ * exactly once by construction -- the same shape as bgSwapRoomTable(). The region runs
+ * from the lowest offset the table names to the end of the entry at the highest, and
+ * entries are packed with no gaps. Verified against all 25 files: the walk lands exactly
+ * on the computed end every time, and never sees a numPoints outside 3..7. Two files
+ * contain a few entries the table never references; those get swapped too, which is
+ * harmless -- nothing reads them.
+ *
+ * Must run after bgSwapPortalTable(): it needs native offsets to find the region. */
+static void bgSwapPortalGeometry(bg_portal_data_entry *portals)
+{
+    u32 lo = 0xffffffff;
+    u32 hi = 0;
+    u32 off;
+    u8 *base;
+    u8 *p;
+    u8 *end;
+    s32 i;
+
+    if (portals == NULL)
+    {
+        return;
+    }
+
+    for (i = 0; i < PORTMAX * MAXPORTALSPERROOM && portals[i].offset_portal != 0; i++)
+    {
+        off = SEGMENT_OFFSET(portals[i].offset_portal);
+
+        if (off < lo)
+        {
+            lo = off;
+        }
+
+        if (off > hi)
+        {
+            hi = off;
+        }
+    }
+
+    if (hi == 0)
+    {
+        return;
+    }
+
+    base = (u8 *) BG_SEG_TO_PTR(ptr_bg_data, 0x0f000000u);
+    p = base + lo;
+    end = base + hi;
+    end += 4 + 12 * (u32) *end;
+
+    while (p < end)
+    {
+        u32 n = *p;
+        u32 *f;
+        u32 j;
+
+        if (n < 3 || n > 32)
+        {
+            osSyncPrintf("[getv] bgportal: polygon walk hit numPoints=%u at +0x%x -- "
+                         "stopping (the table or the offsets are wrong)\n",
+                         n, (u32) (p - base));
+            return;
+        }
+
+        f = (u32 *) (p + 4);
+
+        for (j = 0; j < n * 3; j++)
+        {
+            f[j] = bgBE32(&f[j]);
+        }
+
+        p += 4 + 12 * n;
+    }
+
+    if (p != end)
+    {
+        osSyncPrintf("[getv] bgportal: polygon walk overshot -- ended at +0x%x, expected "
+                     "+0x%x\n", (u32) (p - base), (u32) (end - base));
+    }
+}
