+/* GETV: the first-person gun Model was overlaid on `struct hand` at field_B68, and on
+ * arm64 that overlay is wrong in three independent ways. Same bug family as the player
+ * gait model already fixed in initBondDATAdefaults.c -- see the long comment there.
+ *
+ * Measured natively (clang, arm64, this header set):
+ *     sizeof(Model)                = 264      (0xBC on the N64)
+ *     sizeof(struct hand)          = 952      (0x3B8)
+ *     offsetof(hand, field_B68)    = 0x304    <-- 4 mod 8, NOT 8-aligned
+ *     offsetof(hand, mtxlist)      = 0x310    == field_B68 + 12
+ *     offsetof(hand, field_B78)    = 0x318
+ *     offsetof(hand, modeldatas)   = 0x328    == field_B68 + 36
+ *     offsetof(Model, obj)         = 16       -> absolute 0x304 + 16 = 0x314
+ *
+ *   1. Alignment / aliasing -- the crash. `mtxlist` is a real 8-byte pointer, so the
+ *      compiler put it at 0x310, i.e. field_B68 + 12, not + 16. `Model.obj` therefore
+ *      spans 0x314..0x31C = the HIGH half of `mtxlist` followed by `field_B78`.
+ *      gunfire.c did `modelInit(model, ...)` (which stores obj at +16) and then, 18 lines
+ *      later, `hand->mtxlist = rwmtx`. rwmtx is a native heap pointer 0x1_05xxxxxx, so
+ *      that store dropped its high word 0x00000001 straight onto obj's low half, leaving
+ *      obj == 0x00000001_00000001. That is exactly the observed fault address
+ *      0x100000001 -- not a truncated pointer and not a NULL, but two halves of two
+ *      different values. modelUpdateNodeRelations+16 is the `model->obj->RootNode`
+ *      double deref, and it faulted on the very first frame the weapon model rendered.
+ *   2. Overflow -- the native Model spans 0x304..0x40C but sizeof(struct hand) is 0x3B8,
+ *      so writing it ran 84 bytes past the end of the hand and into the next one.
+ *   3. Pool size / overlap -- `modeldatas` starts at Model + 36, i.e. inside the 64-byte
+ *      native Model header, so modelInit's `scale`, `attachedto` and `attachedto_objinst`
+ *      stores landed in rwdata words 1..6 and vice versa. And the pool is only 32 words
+ *      (modeldatas .. field_C04) while modelCalculateRwDataIndexes() sizes records with
+ *      native sizeof()/4, so numRecords is far larger here than the N64's <32.
+ *
+ * Fix: give each hand a standalone, correctly-aligned Model and its own rwdata pool.
+ * Nothing outside gunfire.c reads field_B68..field_B84 or modeldatas (`mtxlist` is
+ * written here and read nowhere -- on the N64 it IS Model.render_pos, so the assignment
+ * becomes an explicit `model->render_pos = rwmtx`), so `struct hand` is left untouched
+ * and those fields simply become dead padding. Static rather than mempAllocBytesInBank()
+ * so a stage-pool reset cannot invalidate a Model that outlives the frame. */
+#define GE_GUN_RWDATA_WORDS 512
+#define GE_GUN_MAX_HANDS    8   /* 4 players x 2 hands */
+static Model  ge_gun_models[GE_GUN_MAX_HANDS];
+static u32    ge_gun_rwdata[GE_GUN_MAX_HANDS][GE_GUN_RWDATA_WORDS];
+static void  *ge_gun_owner[GE_GUN_MAX_HANDS];
+
+/* One slot per distinct `struct hand *`; re-entering a level reuses the same slot. */
+static s32 ge_gun_slot(void *hand)
+{
+    s32 i;
+
+    for (i = 0; i < GE_GUN_MAX_HANDS; i++)
+    {
+        if (ge_gun_owner[i] == hand) { return i; }
+    }
+
+    for (i = 0; i < GE_GUN_MAX_HANDS; i++)
+    {
+        if (ge_gun_owner[i] == NULL) { ge_gun_owner[i] = hand; return i; }
+    }
+
+    osSyncPrintf("[getv] gun model: no free slot for hand %p -- reusing slot 0\n", hand);
+    return 0;
+}
+
+static Model *ge_gun_model(void *hand) { return &ge_gun_models[ge_gun_slot(hand)]; }
+static u32   *ge_gun_pool(void *hand)  { return ge_gun_rwdata[ge_gun_slot(hand)]; }
