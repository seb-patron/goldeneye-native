+/* The bg file is big-endian. It comes straight out of the ROM, unlike the font and
+ * chr arrays elsewhere in this port, which were extracted already-native -- do not copy
+ * this pattern to those. Proof it is needed here: the dam header's word 1 reads
+ * `0f 00 00 14`; read natively that is 0x1400000F, so BG_SEG_TO_PTR added 0x0500000F
+ * instead of 0x14 (the observed fault delta, 0x5000037, matched).
+ *
+ * Verified against all 25 non-empty assets/obseg/bg/*.bin: word 1 is always 0x0F......,
+ * and the room table always divides by 24 with zero remainder. */
+static u32 bgBE32(const void *p)
+{
+    const u8 *b = (const u8 *) p;
+    return ((u32) b[0] << 24) | ((u32) b[1] << 16) | ((u32) b[2] << 8) | (u32) b[3];
+}
+
+/* Header word `i` of the bg file, as a native value. */
+#define BG_HDR_WORD(base, i)  bgBE32((const u8 *) (uintptr_t) (base) + (i) * 4)
+
+/* How many bg_room_data records the room table holds.
+ *
+ * Capacity is a separate fix from stride -- getting the record size right says
+ * nothing about how many records there are. The table runs from header word 1 up to
+ * whichever of the other section offsets (2 = portals, 3 = envdata, 4 = float table)
+ * comes next. Over all 25 non-empty bg files that span divides by 24 with zero
+ * remainder every time, which is independent confirmation of the 24-byte stride. */
+static s32 bgRoomTableCount(uintptr_t base, u32 bufsize)
+{
+    u32 start = BG_HDR_WORD(base, 1) & 0x00ffffff;
+    u32 end = bufsize;
+    s32 i;
+
+    for (i = 2; i <= 4; i++)
+    {
+        u32 w = BG_HDR_WORD(base, i);
+        u32 o = w & 0x00ffffff;
+
+        if (w != 0 && o > start && o < end)
+        {
+            end = o;
+        }
+    }
+
+    if (end <= start)
+    {
+        return 0;
+    }
+
+    return (s32) ((end - start) / sizeof(bg_room_data));
+}
