+            out->DisplayList.Secondary   = ge_convert_gdl(base, ge_be32(f + 4), "DL.Secondary");
+            out->DisplayList.BaseAddr    = (void *)base;
+            out->DisplayList.Vertices    = (Vertex *)ge_conv_ptr(base, ge_be32(f + 12));
