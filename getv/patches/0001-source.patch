+/* ---- GETV_VEH_DEBUG=1: per-frame census of moving things ----------------------
+ * Answers, with numbers rather than code reading:
+ *   (a) do CHRs (guards) change position at all?
+ *   (b) does the DAM truck's VehichleRecord ever get a path / speed / nextstep?
+ *   (c) does prop->pos of the truck change per frame?
+ * Diagnostic only; nothing runs unless the env var is set. */
+static s32 ge_veh_dbg(void)
+{
+    static s32 cached = -1;
+    if (cached < 0) { const char *e = getenv("GETV_VEH_DEBUG"); cached = (e && *e == '1'); }
+    return cached;
+}
+
+/* ---- GETV_VEHALL=1: every vehicle and aircraft, not just the first -------------
+ * ge_veh_probe() above tracks only the first PROPDEF_VEHICHLE it finds, so it cannot
+ * answer how many vehicles a level has or whether an aircraft position was ever
+ * sampled. This prints one line per VEHICHLE/AIRCRAFT prop at
+ * a few fixed frames with its cumulative displacement from the first sample, so a
+ * parked prop and a frozen prop are distinguishable.
+ * Diagnostic only; nothing runs unless the env var is set. */
+static s32 ge_vehall_dbg(void)
+{
+    static s32 cached = -1;
+    if (cached < 0) { const char *e = getenv("GETV_VEHALL"); cached = (e && *e == '1'); }
+    return cached;
+}
+
+/* ---- GETV_SWITCHTEST=<frame>: does a switch actually OPEN ITS DOOR? -------------
+ * The link tallies in prop.c prove the type checks pass. They do not prove the game
+ * does anything with the link, and mere resolution is a bar a broken build can clear
+ * (pdefIndex+0 also resolved). This is the behavioural test.
+ *
+ * Bond cannot be walked to a switch headless, so instead this calls the game's own
+ * switch handler -- sub_GAME_7F03E6A0(), the function propobjInteract() calls the
+ * instant the player uses an object -- on every object prop at a fixed frame. It is
+ * the real activation path, unmodified; only the trigger is synthetic, and it is the
+ * same synthetic trigger in both arms.
+ *
+ *   fix off -> RUNTIMEBITFLAG_00000001 is never set and g_LevelLoadPropSwitch is
+ *              empty, so the handler returns immediately for every prop and no door
+ *              moves.
+ *   fix on  -> the handler finds the link and calls doorActivateWrapper(link->second).
+ *
+ * What is sampled is not the pointer but DoorRecord.openPosition on every door prop,
+ * read before the trigger and every 30 frames after. A door that opens has moved of its
+ * own accord under the normal door tick.
+ * Diagnostic only; nothing runs unless the env var is set. */
+extern int atoi(const char *);
+void sub_GAME_7F03E6A0(PropRecord *prop);   /* defined further down this file */
+
+static s32 ge_switchtest_frame(void)
+{
+    static s32 cached = -2;
+    if (cached == -2) { const char *e = getenv("GETV_SWITCHTEST"); cached = e ? atoi(e) : -1; }
+    return cached;
+}
+
+/* ---- GETV_MPTICK=1: per-character render/animation census -----------------------
+ * "the model loaded" is not "the model renders and animates". For every CHR prop this
+ * prints, at fixed frames, the model instance, its current animation frame and the
+ * prop's DRAWN flag, so a character that loads but is never posed or never submitted is
+ * distinguishable from one that works. Diagnostic only. */
+static void ge_mpchr_tick(void)
+{
+    static s32 frame = 0;
+    static s32 on = -1;
+    PropRecord *p;
+    s32 i = 0;
+    if (on < 0) { const char *e = getenv("GETV_MPTICK"); on = (e && *e == '1'); }
+    if (!on) return;
+    frame++;
+    if (frame != 1 && (frame % 120) != 0) return;
+    for (p = chrpropGetActiveTail(); p != NULL; p = p->prev) {
+        if ((p->type == PROP_TYPE_CHR || p->type == PROP_TYPE_VIEWER) && p->chr != NULL) {
+            ChrRecord *c = p->chr;
+            Model *m = c->model;
+            printf("[getv][mptick] f=%d [%d] type=%d chrnum=%d body=%d head=%d model=%p animframe=%.3f a=%d b=%d looping=%d flags=0x%x pos=(%.1f %.1f %.1f)\n",
+                   (int) frame, (int) i, (int) p->type, (int) c->chrnum,
+                   (int) c->bodynum, (int) c->headnum, (void *) m,
+                   m ? m->animframe1 : -1.0f, m ? (int) m->framea : -1, m ? (int) m->frameb : -1,
+                   m ? (int) m->animlooping : -1,
+                   (unsigned) p->flags, p->pos.x, p->pos.y, p->pos.z);
+            i++;
+            if (i >= 12) break;
+        }
+    }
+    fflush(stdout);
+}
+
+static void ge_switch_probe(void)
+{
+    static s32 frame = 0;
+    s32 at = ge_switchtest_frame();
+    PropRecord *p;
+    s32 ndoor = 0, nopen = 0, nfired = 0;
+    f32 maxopen = 0.0f;
+
+    if (at < 0) { return; }
+    frame++;
+
+    for (p = chrpropGetActiveTail(); p != NULL; p = p->prev)
+    {
+        /* Doors are PROP_TYPE_DOOR, not PROP_TYPE_OBJ; filtering on PROP_TYPE_OBJ
+         * alone counts ndoor=0 on every level. */
+        if ((p->type != PROP_TYPE_DOOR && p->type != PROP_TYPE_OBJ) || p->obj == NULL) { continue; }
+        if (p->obj->type == PROPDEF_DOOR)
+        {
+            DoorRecord *d = (DoorRecord *) p->obj;
+            ndoor++;
+            if (d->openPosition > 0.001f) { nopen++; }
+            if (d->openPosition > maxopen) { maxopen = d->openPosition; }
+        }
+    }
+
+    if (frame == at || frame == at - 1 || ((frame > at) && ((frame - at) % 30) == 0))
+    {
+        osSyncPrintf("[switchtest] f=%d ndoor=%d nopen=%d maxopen=%.4f%s\n",
+                     frame, ndoor, nopen, (double) maxopen,
+                     (frame == at) ? "  <== FIRING sub_GAME_7F03E6A0 on every obj prop" : "");
+    }
+
+    if (frame == at)
+    {
+        for (p = chrpropGetActiveTail(); p != NULL; p = p->prev)
+        {
+            if ((p->type != PROP_TYPE_OBJ && p->type != PROP_TYPE_DOOR) || p->obj == NULL) { continue; }
+            nfired++;
+            sub_GAME_7F03E6A0(p);
+        }
+        osSyncPrintf("[switchtest] fired on %d object props\n", nfired);
+    }
+}
