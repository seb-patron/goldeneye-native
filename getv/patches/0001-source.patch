+/* Promote a VMA offset to a real pointer into the loaded file.
+ *
+ * This is what the original PROMOTE() did for every non-node data field (images, vertex
+ * arrays, collision data). Those live inside the file and are read directly by the CPU,
+ * so unlike display lists they need no format change -- only the address fixing up.
+ * Out-of-range values become NULL rather than a wild pointer. */
+static void *ge_conv_ptr(uintptr_t base, u32 off)
+{
+    if (off < GE_MODEL_VMA || (off - GE_MODEL_VMA) > 0x1000000u) {
+        return NULL;
+    }
+    return (void *)(base + (off - GE_MODEL_VMA));
+}
