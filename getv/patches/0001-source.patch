+static void ge_vehall_probe(void)
+{
+    static f32 first[32][3];
+    static s32 nfirst = 0;
+    static s32 frame = 0;
+    PropRecord *p;
+    s32 idx = 0;
+
+    if (!ge_vehall_dbg()) { return; }
+    frame++;
+
+    for (p = chrpropGetActiveTail(); p != NULL && idx < 32; p = p->prev)
+    {
+        struct VehichleRecord *v;
+        f32 dx, dy, dz;
+        if (p->type != PROP_TYPE_OBJ || p->obj == NULL) { continue; }
+        if (p->obj->type != PROPDEF_VEHICHLE && p->obj->type != PROPDEF_AIRCRAFT) { continue; }
+        if (idx >= nfirst)
+        {
+            first[idx][0] = p->pos.f[0]; first[idx][1] = p->pos.f[1]; first[idx][2] = p->pos.f[2];
+            nfirst = idx + 1;
+        }
+        v = (struct VehichleRecord *) p->obj;
+        dx = p->pos.f[0] - first[idx][0];
+        dy = p->pos.f[1] - first[idx][1];
+        dz = p->pos.f[2] - first[idx][2];
+        if (frame == 1 || (frame % 60) == 1)
+        {
+            osSyncPrintf("[vehall] f=%d i=%d type=%d pos=(%.2f %.2f %.2f) "
+                         "moved=%.3f spd=%.4f ail=%p aioff=%d path=%p step=%d\n",
+                         frame, idx, (s32) p->obj->type,
+                         (double) p->pos.f[0], (double) p->pos.f[1], (double) p->pos.f[2],
+                         (double) sqrtf(dx*dx + dy*dy + dz*dz),
+                         (double) v->speed, (void *) v->ailist, (s32) v->aioffset,
+                         (void *) v->path, (s32) v->nextstep);
+        }
+        idx++;
+    }
+    if (frame == 1)
+    {
+        osSyncPrintf("[vehall] f=1 total vehicle/aircraft props = %d\n", idx);
+    }
+}
