+/* ---------------------------------------------------------------------------
+ * SETUP INTRO SECTION -- file layout -> native layout.
+ *
+ * Same family as the propDefs above, and it is the FIRST record on the Dam, so it
+ * killed the boot immediately. Of the ten intro record types only INTROTYPE_CAMERA
+ * contains pointers, and it contains three:
+ *
+ * file (4-byte ptrs) native (8-byte ptrs)
+ * type..unk18   0x00 .. 0x1b          0x00 .. 0x1b
+ * lang1c        0x1c   (4)            0x20   (8)
+ * lang20        0x20   (4)            0x28   (8)
+ * prev          0x24   (4)            0x30   (8)   <- runtime only, stays 0
+ * sizeof        0x28                  0x38
+ *
+ * So walking the file stream with native strides overshot by 0x10 per camera record
+ * AND read/wrote lang1c/lang20 past where the file actually holds them.
+ *
+ * lang1c is copied as raw bytes on purpose. The reader wants `lang_index[1]`, the
+ * second u16 of the slot -- on the N64 that is the low half of the big-endian word,
+ * i.e. file bytes 0x1e..0x1f. Copying the 4 bytes verbatim to native 0x20 lands them
+ * at 0x22..0x23, which is exactly `lang_index[1]` natively. lang20 is read as a whole
+ * s32 and then narrowed with (u16), so it is value-identical either way. The two
+ * fields look alike but are read differently, so they must be converted
+ * differently. */
+
+/* If any of these fire, the segment table below is describing a struct that no longer
+ * has this shape -- fix the table, do not silence the assert. */
+_Static_assert(sizeof(struct SetupIntroCamera) == 0x38, "SetupIntroCamera native size changed");
+_Static_assert(sizeof(struct SetupIntroSpawn)  == 0x0c, "SetupIntroSpawn native size changed");
+_Static_assert(sizeof(struct SetupIntroItem)   == 0x10, "SetupIntroItem native size changed");
+_Static_assert(sizeof(struct SetupIntroAmmo)   == 0x10, "SetupIntroAmmo native size changed");
+_Static_assert(sizeof(struct SetupIntroSwirl)  == 0x20, "SetupIntroSwirl native size changed");
+_Static_assert(sizeof(struct SetupIntroAnim)   == 0x08, "SetupIntroAnim native size changed");
+_Static_assert(sizeof(struct SetupIntroCuff)   == 0x08, "SetupIntroCuff native size changed");
+_Static_assert(sizeof(struct SetupIntroWatch)  == 0x0c, "SetupIntroWatch native size changed");
+_Static_assert(sizeof(struct SetupIntroCredits)== 0x08, "SetupIntroCredits native size changed");
+_Static_assert(sizeof(struct SetupIntroEmpty)  == 0x04, "SetupIntroEmpty native size changed");
+
+typedef struct GeIntroSeg  { u16 fileoff, natoff, len; } GeIntroSeg;
+typedef struct GeIntroLayout {
+ u16 filesize, natsize, nsegs;
+ GeIntroSeg segs[3];
+} GeIntroLayout;
+
+/* Indexed by INTRO_TYPE. Every type except CAMERA is pure s32/f32, so file == native
+ * and one whole-record segment covers it. */
+static const GeIntroLayout ge_intro_layout[INTROTYPE_MAX] = {
+    /* SPAWN   */ { 0x0c, 0x0c, 1, { {0, 0, 0x0c} } },
+    /* ITEM    */ { 0x10, 0x10, 1, { {0, 0, 0x10} } },
+    /* AMMO    */ { 0x10, 0x10, 1, { {0, 0, 0x10} } },
+    /* SWIRL   */ { 0x20, 0x20, 1, { {0, 0, 0x20} } },
+    /* ANIM    */ { 0x08, 0x08, 1, { {0, 0, 0x08} } },
+    /* CUFF    */ { 0x08, 0x08, 1, { {0, 0, 0x08} } },
+    /* CAMERA  */ { 0x28, 0x38, 3, { {0x00, 0x00, 0x1c},
+                                     {0x1c, 0x20, 0x04},
+                                     {0x20, 0x28, 0x04} } },
+    /* WATCH   */ { 0x0c, 0x0c, 1, { {0, 0, 0x0c} } },
+    /* CREDITS */ { 0x08, 0x08, 1, { {0, 0, 0x08} } },
+    /* END     */ { 0x04, 0x04, 1, { {0, 0, 0x04} } },
+};
+
+static u8  *g_geIntroNative      = NULL;
+static s32 g_geIntroNativeBytes = 0;
+
+void *geIntroConvertToNative(void *fileintro)
+{
+ const u8 *src = (const u8 *) fileintro;
+ s32 filebytes = 0, natbytes = 0, fpos = 0, npos = 0;
+
+    /* NULL is not the only bad pointer here. Archives and Cuba pass (void *)-1, and
+     * dereferencing it faulted at 0xffffffffffffffff inside pass 1. The cause is
+     * upstream and is not a conversion bug: their setup assets are
+     * missing or do not compile -- assets/obseg/setup/u/ has no UsetuparchZ.c at all
+     * (only the multiplayer Ump_setuparchZ.c), and UsetuplenZ.c fails to compile
+     * because it initialises an s32 intro slot with a real pointer (&credits_data_0).
+     * Either way the stage setup resolves to a stub and the intro pointer is garbage.
+     *
+     * Refusing the pointer turns an unexplained SIGSEGV into a named diagnosis and lets
+     * the level continue with no intro, which is the same thing the game already does
+     * for a setup with no intro section. It does not fix the underlying asset problem;
+     * the message records that the problem is still there. */
+ if (fileintro == NULL || (uintptr_t) fileintro == (uintptr_t) -1
+        || (uintptr_t) fileintro < 0x10000u)
+    {
+ if (fileintro != NULL)
+        {
+ osSyncPrintf("[getv][intro] setup intro pointer is not valid (%p) -- ""stage setup asset is missing or stubbed; continuing with no intro\n",
+ fileintro);
+        }
+ return NULL;
+    }
+
+    /* Pass 1 -- size both sides, terminator included. An unknown type has no known
+     * stride, so stop rather than walk off into the rest of the setup file. */
+ for (;;)
+    {
+ s32 type = *(const s32 *) (src + filebytes);
+ const GeIntroLayout *L;
+
+ if (type < 0 || type >= INTROTYPE_MAX)
+        {
+ osSyncPrintf("[getv][intro] unknown record type %d at +0x%x -- stopping\n",
+                         (int) type, (unsigned) filebytes);
+ return fileintro;
+        }
+
+ L = &ge_intro_layout[type];
+ filebytes += L->filesize;
+ natbytes  += L->natsize;
+
+ if (type == INTROTYPE_END)
+        {
+ break;
+        }
+    }
+
+ if (natbytes > g_geIntroNativeBytes)
+    {
+ free(g_geIntroNative);
+ g_geIntroNative      = (u8 *) malloc((size_t) natbytes);
+ g_geIntroNativeBytes = g_geIntroNative ? natbytes : 0;
+    }
+
+ if (g_geIntroNative == NULL)
+    {
+ return fileintro;   /* out of memory: old broken behaviour beats a null deref */
+    }
+
+    /* Anything not covered by a segment is a widened pointer slot or runtime state and
+     * must start zeroed -- `prev` in particular is a chain head built during the walk. */
+ memset(g_geIntroNative, 0, (size_t) natbytes);
+
+ while (fpos < filebytes)
+    {
+ const u8 *f = src + fpos;
+ u8 *n = g_geIntroNative + npos;
+ const GeIntroLayout *L = &ge_intro_layout[*(const s32 *) f];
+ s32 i;
+
+ for (i = 0; i < L->nsegs; i++)
+        {
+ memcpy(n + L->segs[i].natoff, f + L->segs[i].fileoff, L->segs[i].len);
+        }
+
+ fpos += L->filesize;
+ npos += L->natsize;
+    }
+
+ osSyncPrintf("[getv][intro] converted %d file bytes -> %d native bytes\n",
+                 (int) filebytes, (int) natbytes);
+ return g_geIntroNative;
+}
