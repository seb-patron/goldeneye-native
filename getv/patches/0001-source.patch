+#ifdef GE_PORT_NATIVE
+/* GETV: the front-end deadlock. It is structural.
+ *
+ * The three `musicTrackNPlay()` functions each open with
+ *
+ *     if (g_musicXTrackNCurrentTrackNum) { musicTrackNStop(); }
+ *     while (alCSPGetState(g_musicXTrackNSeqPlayer))
+ *         ;
+ *
+ * On the N64 that is a legitimate cross-thread handshake. `alCSPStop()` only POSTS an
+ * AL_SEQP_STOPPING_EVT (`cspstop.c`); the transition to AL_STOPPED happens inside
+ * `__CSPVoiceHandler()` (`csplayer.c:230,243`), which runs on the AUDIO THREAD out of
+ * `alAudioFrame()`. The game thread spins for a few hundred microseconds and the audio
+ * thread clears it.
+ *
+ * This port has no audio thread. `port_audio.c:529` states it directly -- the port is
+ * single-threaded and the frame loop drives it instead -- so `alAudioFrame()` is called
+ * by `gePortAudioFrame()` from the main loop, i.e. from the same thread that is sitting
+ * in this spin. The one thing that could clear the state is the thing the spin is
+ * preventing from running, so the wait can never end.
+ *
+ * With `GETV_STAGE=90` the attract chain walks LEGAL -> NINTENDO -> RAREWARE and then
+ * stops dead partway into MENU_EYE_INTRO, at 100% CPU, with no fault and no crash
+ * report. `/usr/bin/sample` on the live process names the loop exactly:
+ *
+ *     bossMainloop -> lvlManageMpGame -> menu_init -> musicTrack1Play -> alCSPGetState
+ *     1504 of 1504 samples
+ *
+ * It is the second music call that hangs, which makes this look like a model bug:
+ * `init_menu01_nintendo()` calls `musicTrack1Play(M_INTROSWOOSH)` while
+ * `g_musicXTrack1CurrentTrackNum` is still 0 -- no stop, state already AL_STOPPED, loop
+ * skipped. `init_menu03_gunbarrel()` (`front.c:1879`) then calls
+ * `musicTrack1Play(M_INTRO)` with a track already playing, and that one never returns.
+ * MENU_RAREWARE plays no music at all, which is why it passes through in between. The
+ * hang therefore lands immediately after `initializeGunBarrelIntro()` has finished
+ * loading Bond's body, head and PP7, so the last thing in the log is a model load and
+ * it reads as a model failure. It is not.
+ *
+ * The fix is to pump the audio frame from inside the wait: in a single-threaded port,
+ * calling `gePortAudioFrame()` here is what the audio thread would have been doing. The
+ * same handler runs, the same events are consumed, and the state machine advances as it
+ * would have, which is the smallest change that makes the original's assumption true
+ * again.
+ *
+ * `gePortAudioFrame()` is rate-limited against the wall clock (it targets a fixed SDL
+ * queue depth), so most iterations return immediately and the loop still spins. That is
+ * intended -- it is a real-time wait of a millisecond or two, as on the N64. The spin
+ * bound exists for the other case: if `musicTrackNStop()` found the player in a state
+ * its `== AL_PLAYING` test does not cover, no stop event was ever posted and no amount
+ * of pumping will clear it. Rather than hang, give up, report it once, and let the
+ * caller continue; a wrong music track is a better failure than a dead front-end.
+ *
+ * This generalises: any N64 busy-wait on state owned by another thread is an automatic
+ * deadlock here. These three were the only `while (alCSPGetState(...))` spins in the
+ * tree, but the family is "spin on something only the audio or scheduler thread
+ * advances".
+ *
+ * GETV_MUSICWAIT=0 disables the pump (restoring the old, hanging behaviour) for A/B.
+ */
+extern void gePortAudioFrame(void);
+extern char *getenv(const char *);
+
+#define GE_MUSIC_STOP_SPIN_MAX 2000000u
+
+static void gePortMusicWaitStopped(ALCSPlayer *seqp, int track_slot)
+{
+    unsigned long spins = 0;
+    static int pump = -1;
+
+    if (pump < 0)
+    {
+        const char *e = getenv("GETV_MUSICWAIT");
+        pump = (e != NULL && *e != '\0') ? (e[0] != '0') : 1;
+    }
+
+    while (alCSPGetState(seqp))
+    {
+        if (pump)
+        {
+            gePortAudioFrame();
+        }
+
+        if (++spins > GE_MUSIC_STOP_SPIN_MAX)
+        {
+            osSyncPrintf("[getv][music] track%d: seq player never left state %d after "
+                         "%lu pumped spins -- giving up and playing anyway\n",
+                         track_slot, (int)alCSPGetState(seqp), spins);
+            return;
+        }
+    }
+
+    if (spins != 0)
+    {
+        osSyncPrintf("[getv][music] track%d: waited %lu spins for AL_STOPPED\n",
+                     track_slot, spins);
+    }
+}
