+/* GETV-HANDITEMMODEL: third instance of the "N64 struct is smaller than ours" Model
+ * family, after the first-person gun models above (gunfire.c:270) and the pause-menu
+ * watch (bondview2.c:206, GETV-WATCHMODEL). Same fix: a standalone, correctly sized
+ * Model plus a standalone rwdata pool, one slot per player.
+ *
+ * Measured natively (compiled sizeof/offsetof against these headers, arm64 clang -O1):
+ *     sizeof(Model)                  = 264
+ *     sizeof(ModelHeader) [gunfire.c local typedef, 9 fields]  =  64
+ *     sizeof(ModelHead)   [gunfire.c local typedef, 9 fields]  =  64
+ *     sizeof(union ModelRwData)      =  96
+ *     offsetof(Model, obj) = 16, render_pos = 24, datas = 32
+ *
+ * The 9 declared fields of the local ModelHeader/ModelHead typedefs happen to lay out
+ * IDENTICALLY to Model's first 9 fields (both 64 bytes), so modelInit()'s own stores are
+ * in range. The overrun comes from everything modelInit calls and everything called after
+ * it -- modelInitRwData, sub_GAME_7F05E978, sub_GAME_7F05EA94, modelUpdateNodeRelations,
+ * subdraw -- which read and write Model fields out to offset 0x107 (anim, framea/frameb,
+ * unk34/unk38, speeds, unka0, anim_translation_scale). That is 264 - 64 = 200 bytes past
+ * the end of the stack local, straight over the caller's other locals. On the N64 the
+ * struct was 0xBC and the declaration was honest; here it is not.
+ *
+ * The rwdata pools are the second, independent breakage, sized in N64 bytes:
+ *     u8  spb8[0x80]  = 128 bytes -> 128 / 96 = one native record
+ *     u32 rwdata[26]  = 104 bytes -> 104 / 96 = one native record
+ * modelCalculateRwDataIndexes() sizes records with native sizeof()/4, so numRecords here
+ * is far larger than the N64's, and the second record onwards writes off the end.
+ *
+ * Static storage rather than mempAllocBytesInBank(), so a stage-pool reset cannot
+ * invalidate a Model that outlives the frame -- same reasoning as the two prior fixes.
+ * Per-player slots rather than a scalar, so that split-screen co-op stays possible.
+ *
+ * GETV_HANDITEMMODEL=0 restores the retail stack locals for a same-binary A/B.
+ * These are globals, not statics: a static inlines at -O1 and leaves no symbol for
+ * `nm -gU`. */
+#define GE_HANDITEM_RWDATA_WORDS 1024
+#define GE_HANDITEM_MAX_PLAYERS  4
+/* 0 = set_enviro_fog_for_items_in_solo_watch_menu, 1 = watchRenderController,
+ * 2 = sub_GAME_7F068EC4 (shell casings). One Model per site per player: two of these can
+ * be live in the same frame (the watch draws the controller and the held item). */
+#define GE_HANDITEM_SITES        3
+
+Model geHandItemModels[GE_HANDITEM_SITES][GE_HANDITEM_MAX_PLAYERS];
+u32   geHandItemRwdata[GE_HANDITEM_SITES][GE_HANDITEM_MAX_PLAYERS][GE_HANDITEM_RWDATA_WORDS];
+void *geHandItemOwner[GE_HANDITEM_MAX_PLAYERS];
+int   geHandItemModelFlag = -1;
+
+int geHandItemModelOn(void)
+{
+    if (geHandItemModelFlag < 0) {
+        const char *e = getenv("GETV_HANDITEMMODEL");
+        geHandItemModelFlag = (e && e[0] == '0') ? 0 : 1;
+    }
+    return geHandItemModelFlag;
+}
+
+/* One slot per distinct `struct player *`; re-entering a level reuses the same slot. */
+s32 geHandItemSlot(void *player)
+{
+    s32 i;
+
+    for (i = 0; i < GE_HANDITEM_MAX_PLAYERS; i++)
+    {
+        if (geHandItemOwner[i] == player) { return i; }
+    }
+
+    for (i = 0; i < GE_HANDITEM_MAX_PLAYERS; i++)
+    {
+        if (geHandItemOwner[i] == NULL) { geHandItemOwner[i] = player; return i; }
+    }
+
+    osSyncPrintf("[getv] hand-item model: no free slot for player %p -- reusing slot 0\n", player);
+    return 0;
+}
+
+Model *geHandItemModel(s32 site, void *player)
+{
+    return &geHandItemModels[site][geHandItemSlot(player)];
+}
+
+u32 *geHandItemPool(s32 site, void *player)
+{
+    return geHandItemRwdata[site][geHandItemSlot(player)];
+}
+
+/* GETV_HANDITEMDBG=1 -- one line the first time each site draws, and one per site every
+ * 600 calls. This is the only discriminator that says WHICH watch page rendered: site 0
+ * is draw_watch_mission_status_page's held item, site 1 is the control-style page's
+ * controller model, site 2 is the in-world shell casings. */
+int geHandItemDbgFlag = -1;
+u32 geHandItemCalls[GE_HANDITEM_SITES];
+
+int geHandItemDbg(void)
+{
+    if (geHandItemDbgFlag < 0) {
+        const char *e = getenv("GETV_HANDITEMDBG");
+        geHandItemDbgFlag = (e && e[0] == '1');
+    }
+    return geHandItemDbgFlag;
+}
