+{
+    static s32 v = -2;
+    if (v == -2) {
+        const char *e = getenv("GETV_CHR_FIRERATE");
+        v = (e && *e) ? atoi(e) : -1;
+    }
+    return (v >= 0) ? v : item;
+}
