+static void ge_dlmtx_probe(Model *mdl)
+{
+    ModelNode *n;
+    int guard = 0, k;
+    if (ge_dlmtx_on < 0) {
+        extern char *getenv(const char *);
+        const char *e = getenv("GETV_DLMTX");
+        ge_dlmtx_on = (e && *e) ? atoi(e) : 0;
+    }
+    if (!ge_dlmtx_on || mdl == NULL || mdl->obj == NULL) return;
+    for (k = 0; k < ge_dlmtx_nseen; k++)
+        if (ge_dlmtx_seen[k] == (const void *)mdl->obj) return;
+    if (ge_dlmtx_nseen >= 16) return;
+    ge_dlmtx_seen[ge_dlmtx_nseen++] = (const void *)mdl->obj;
+
+    osSyncPrintf("[getv][dlmtx] === model obj=%p numMatrices=%d ===\n",
+                 (void *)mdl->obj, (int)mdl->obj->numMatrices);
+    n = mdl->obj->RootNode;
+    while (n != NULL && guard++ < 4096) {
+        u32 t = n->Opcode & 0xffu;
+        if (t == MODELNODE_OPCODE_DL || t == MODELNODE_OPCODE_DLCOLLISION
+            || t == MODELNODE_OPCODE_DLPRIMARY) {
+            s32 i0 = modelFindNodeMtxIndex(n, 0);
+            s32 i1 = modelFindNodeMtxIndex(n, 0x100);
+            s32 i2 = modelFindNodeMtxIndex(n, 0x200);
+            /* Which one the node ASKS for is encoded in its own high opcode bits. */
+            s32 want = (n->Opcode & 0x200u) ? i2 : ((n->Opcode & 0x100u) ? i1 : i0);
+            ModelNode *par = n->Parent;
+            osSyncPrintf("[getv][dlmtx] node=%p op=%04x t=%2d parent_op=%04x "
+                         "mtx0=%3d mtx1=%3d mtx2=%3d -> want=%3d\n",
+                         (void *)n, (unsigned)n->Opcode, (int)t,
+                         par ? (unsigned)par->Opcode : 0xffffu,
+                         (int)i0, (int)i1, (int)i2, (int)want);
+            if (n->Data) {
+                if (t == MODELNODE_OPCODE_DLCOLLISION) {
+                    ge_dlmtx_walk_gdl(n->Data->DisplayListCollisions.Primary, "DLC.P", want);
+                    ge_dlmtx_walk_gdl(n->Data->DisplayListCollisions.Secondary, "DLC.S", want);
+                } else {
+                    ge_dlmtx_walk_gdl(n->Data->DisplayList.Primary, "DL.P", want);
+                    ge_dlmtx_walk_gdl(n->Data->DisplayList.Secondary, "DL.S", want);
+                }
+            }
+        }
+        if (n->Child) { n = n->Child; continue; }
+        while (n) { if (n->Next) { n = n->Next; break; } n = n->Parent; }
+    }
+    osSyncPrintf("[getv][dlmtx] === end ===\n");
+}
