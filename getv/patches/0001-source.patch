+            out->BSP.Point.f[1]  = ge_bef32(f + 4);
+            out->BSP.Point.f[2]  = ge_bef32(f + 8);
+            out->BSP.Vector.f[0] = ge_bef32(f + 12);
+            out->BSP.Vector.f[1] = ge_bef32(f + 16);
+            out->BSP.Vector.f[2] = ge_bef32(f + 20);
+            out->BSP.leftChild   = (ModelNode *)(uintptr_t)ge_be32(f + 24);
+            out->BSP.rightChild  = (ModelNode *)(uintptr_t)ge_be32(f + 28);
