+static void bgConvertRoomGdl(const u8 *src, Gfx *dst, u32 ncmds)
+{
+    u32 i;
+
+    for (i = 0; i < ncmds; i++)
+    {
+        dst[i].words.w0 = (uintptr_t)bgGdlBe32(src + i * 8);
+        dst[i].words.w1 = (uintptr_t)bgGdlBe32(src + i * 8 + 4);
+    }
