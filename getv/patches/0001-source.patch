+ * coord3d* -- sees a native record and needs no changes. The 3 offsets and the 3 f32
+ * bit patterns take the identical 32-bit swap. */
+/* Resolve a portal's segment-0x0F address to a real pointer.
+ *
+ * The resolution is not cached back into the field. The N64 relocated
+ * g_BgPortals[i].offset_portal in place, once, right after load; a 4-byte field cannot
+ * hold a 64-bit pointer, so the segment address stays put and every use goes through
+ * here instead. Cheap -- an add and a mask. */
+#define BG_PORTAL_PTR(i) \
+    ((bg_portal_entry *) BG_SEG_TO_PTR(ptr_bg_data, g_BgPortals[i].offset_portal))
+
+/* Byte-swap the portal table in place. The room table gets the same treatment in
+ * bgSwapRoomTable(); portals were simply never done, so bg.c relocated byte-reversed
+ * segment addresses. Only the 4-byte offset needs swapping -- the four room/control
+ * bytes after it are single bytes and have no endianness.
+ *
+ * The table is terminated by a zero offset, and zero reads the same either way, so the
+ * terminator is found correctly before the swap. PORTMAX * MAXPORTALSPERROOM caps a
+ * corrupt table rather than letting it run off the buffer. */
+static void bgSwapPortalTable(bg_portal_data_entry *portals)
+{
+    s32 i;
+
+    if (portals == NULL)
+    {
+        return;
+    }
+
+    for (i = 0; i < PORTMAX * MAXPORTALSPERROOM; i++)
+    {
+        u32 v;
+
+        if (portals[i].offset_portal == 0)
+        {
+            return;
+        }
+
+        v = bgBE32(&portals[i].offset_portal);
+        portals[i].offset_portal = v;
+    }
