+#  define GE_SUBWORD3(a, b, c)          c b a
+#  define GE_SUBWORD4(a, b, c, d)       d c b a
+#  define GE_SUBWORD2_INIT(a, b)        b, a
+#  define GE_SUBWORD3_INIT(a, b, c)     c, b, a
+#else
+#  define GE_SUBWORD2(a, b)             a b
+#  define GE_SUBWORD3(a, b, c)          a b c
+#  define GE_SUBWORD4(a, b, c, d)       a b c d
+#  define GE_SUBWORD2_INIT(a, b)        a, b
+#  define GE_SUBWORD3_INIT(a, b, c)     a, b, c
