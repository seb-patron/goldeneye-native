+    int  i;
+    bool isglobal = FALSE;
+    s32  id;
+    if (!ge_clock_probe_on() || l == NULL) return;
+    for (i = 0; i < ge_clock_nseen; i++) { if (ge_clock_seen[i] == l) return; }
+    if (ge_clock_nseen >= 256) return;
+    ge_clock_seen[ge_clock_nseen++] = l;
