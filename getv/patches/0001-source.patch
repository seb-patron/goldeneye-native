+static void bgSwapRoomTable(uintptr_t base, u32 bufsize)
+{
+    u32 start = BG_HDR_WORD(base, 1) & 0x00ffffff;
+    s32 count = bgRoomTableCount(base, bufsize);
+    u8 *p = (u8 *) base + start;
+    s32 i;
+    s32 j;
+
+    for (i = 0; i < count; i++, p += sizeof(bg_room_data))
+    {
+        for (j = 0; j < 6; j++)
+        {
+            u32 v = bgBE32(p + j * 4);
+            ((u32 *) p)[j] = v;
+        }
+    }
+}
