+/* Room display lists are raw N64 commands: 8 bytes each, two big-endian 32-bit words.
+ * They come straight out of the bg file, which came straight out of the ROM.
+ * Our Gfx is 16 bytes (two uintptr_t), so anything that walks the decompressed bytes
+ * as `Gfx *` strides twice as far as the data and reads the wrong byte for the
+ * opcode -- which is how bgBuildRoomVtxBounds never saw G_ENDDL and ran away.
+ *
+ * This is exactly the problem model.c's ge_convert_gdl() solves for model display
+ * lists, and this is deliberately the same conversion in the same style so the two
+ * cannot drift apart. As there, w1 is left alone: room lists refer to their vertices
+ * through segment SPSEGMENT_BG_VTX (bgRenderRoomPrimary emits the gSPSegment), and
+ * Fast3D's seg_addr() resolves those 0x0Fxxxxxx values at execution time.
+ *
+ * Unlike the model path this one cannot allocate: the room's display list has to live
+ * inside the single contiguous block bgLoadRoomModelData carved out, because
+ * delete_room_data() frees exactly that one block. So the conversion is staged inside
+ * the block and the size accounting below has to pay for the doubling. */
+static u32 bgGdlBe32(const u8 *p)
+{
+    return ((u32)p[0] << 24) | ((u32)p[1] << 16) | ((u32)p[2] << 8) | (u32)p[3];
+}
