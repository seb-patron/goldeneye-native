+/* Decomposes posIsOnScreen()'s predicate chain WITHOUT editing propobj.c (not our
+ * file). Read-only: it re-evaluates the same sub-predicates and records which one
+ * rejects the chr, so "not visible" turns into a named cause. */
+void ge_chr_dbg_vis_breakdown(PropRecord *prop, coord3d *pos, f32 size)
+{
+    /* [8], not [PROPRECORD_STAN_ROOM_LEN]. chraiGetPropRoomIds() writes the -1
+     * terminator AFTER the last room, so a prop occupying all 4 rooms writes
+     * index 4. Every correct caller in the tree declares [8]. */
+    s32 room_ids[8];
+    s32 *rp;
+    bbox2d bbox;
+
+    if (!ge_chr_dbg_on()) return;
+
+    chraiGetPropRoomIds(prop, room_ids);
+    g_geChrDbgVbRoom0 = room_ids[0];
+
+    if (room_ids[0] < 0) { g_geChrDbgVbRooms++; return; }
+
+    for (rp = room_ids; *rp >= 0; rp++) {
+        if (getROOMID_isRendered(*rp)) break;
+    }
+    if (*rp < 0) { g_geChrDbgVbNotRend++; return; }
+
+    if (!fogPositionIsVisibleThroughFog(pos, size)) { g_geChrDbgVbFog++; return; }
+    if (!sub_GAME_7F054C58(pos, size))              { g_geChrDbgVbCull++; return; }
+
+    if (getPropCombinedRoomsBBox2D(prop, &bbox) != 0) {
+        if (!camIsPosInScreenBox(pos, size, &bbox)) { g_geChrDbgVbBox++; return; }
+    } else {
+        if (!camIsPosInScreen(pos, size)) { g_geChrDbgVbBox++; return; }
+    }
+    g_geChrDbgVbOk++;
+}
