+/* ---------------------------------------------------------------------------
+ * GE_SUBWORD2 / GE_SUBWORD2_INIT -- endianness-safe sub-word field groups.
+ *
+ * Declares two groups of fields that share ONE 32-bit file word, in the order
+ * that makes NAMED access read the N64 value on the host. On big-endian MIPS
+ * the first-declared field takes the word's HIGH bits; on little-endian arm64
+ * it takes the LOW bits, so the two halves must be swapped there.
+ *
+ * Use ONLY on structs overlaid on N64 file data whose words are stored as
+ * host-endian s32 VALUES (assets/obseg/setup/*.c). See the long note above
+ * PropDefHeaderRecord.
+ * ------------------------------------------------------------------------- */
+/* __LITTLE_ENDIAN__ is a Clang/Apple predefine; GCC does not define it and instead
+ * reports byte order through __BYTE_ORDER__. Testing only the Clang spelling meant a
+ * GCC build silently took the big-endian branch below, left these field groups
+ * unreversed, and mismatched every struct overlaid on setup-file data. MSVC defines
+ * neither, so _WIN32 is accepted directly: every Windows target is little-endian.
+ * The _Static_asserts at the top of src/game/propobj.c are what catch a regression
+ * here, and they are the reason this surfaced as a compile error rather than as
+ * corrupted object data at runtime. */
+#if defined(GE_PORT_NATIVE) && (defined(__LITTLE_ENDIAN__) || defined(_WIN32) || \
+    (defined(__BYTE_ORDER__) && defined(__ORDER_LITTLE_ENDIAN__) && \
+     __BYTE_ORDER__ == __ORDER_LITTLE_ENDIAN__))
