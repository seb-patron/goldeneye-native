+    if (rate <= 0) return 1;
+    if (!gePortTimeFireOn()) return ((count % rate) == 0);
+
+    if (count == 0) return 1;
+    prev = count - (s32) g_ClockTimer;
+    if (prev < 0) prev = 0;
+    return (prev / rate) != (count / rate);
