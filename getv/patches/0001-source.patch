+/* ===================== GETV-SUBWORD3INIT =====================
+ *
+ * The defect. `GE_SUBWORD3(a,b,c)` / `GE_SUBWORD2(a,b)` (bondtypes.h:41-51) declare their
+ * fields in reverse on little-endian, so that named access to a sub-word field reads the
+ * same value the big-endian N64 file word held. That reversal is correct and
+ * load-bearing, but it also reverses the positional order of a brace initializer, and
+ * four hand-written struct literals in this file still fill those groups in source order.
+ *
+ * Confirmed by compiled __builtin_offsetof against the real headers (arm64,
+ * GE_PORT_NATIVE):
+ *   offsetof(ObjectRecord, type)=0 state=1 extrascale=2 pad=4 obj=6
+ *
+ *   blank_08_object_preset_4001 = { 0x0100, 0x0, 0x08, 0, 0x4001, ... }
+ *      ->  type       = 0x0100 truncated to u8 = 0     (should be 8, PROPDEF_COLLECTABLE)
+ *          extrascale = 8                              (should be 256)
+ *          obj        = 0x4001, pad = 0                (swapped)
+ *
+ * sub_GAME_7F051F30() does `scale = extrascale * (1/256)`, so 8/256 = 1/32: every weapon
+ * created through chrGiveWeapon / something_with_generating_object is drawn at 1/32 scale.
+ * That is why other players' character models appear to hold nothing in multiplayer, while
+ * SP guards -- whose weapons come from setup-file data, where extrascale is a real file
+ * word -- are correct.
+ *
+ * The fix is to use the *_INIT macros the headers already provide (as
+ * New_PropDefHeaderRecord does). No magic constants, no MP special-casing.
+ *
+ * GETV_SUBWORD3INIT=0 writes the old, positionally-filled values back into the copy at
+ * each of the four use sites, so the same binary reproduces the pre-fix behaviour exactly
+ * and the A/B needs no rebuild. Default on.
+ */
+/* Build-enforced form of the check above. <stddef.h> in this tree (include/stddef.h:79)
+ * defines offsetof as a cast expression, which is not a constant expression; use
+ * __builtin_offsetof or these assertions silently will not compile. */
+_Static_assert(__builtin_offsetof(ObjectRecord, type)       == 0, "GE_SUBWORD3 order changed: type");
+_Static_assert(__builtin_offsetof(ObjectRecord, state)      == 1, "GE_SUBWORD3 order changed: state");
+_Static_assert(__builtin_offsetof(ObjectRecord, extrascale) == 2, "GE_SUBWORD3 order changed: extrascale");
+_Static_assert(__builtin_offsetof(ObjectRecord, pad)        == 4, "GE_SUBWORD2 order changed: pad");
+_Static_assert(__builtin_offsetof(ObjectRecord, obj)        == 6, "GE_SUBWORD2 order changed: obj");
+_Static_assert(__builtin_offsetof(WeaponObjRecord, weaponnum)
+               >  __builtin_offsetof(WeaponObjRecord, timer),
+               "GE_SUBWORD3 order changed: WeaponObjRecord weaponnum/timer");
+
+static int getv_subword_init_on(void)
+{
+    static int cached = -1;
+    if (cached < 0)
+    {
+        const char *e = getenv("GETV_SUBWORD3INIT");
+        cached = (e && e[0] == '0') ? 0 : 1;
+        printf("[getv][sw3] GETV_SUBWORD3INIT=%d (%s *_INIT macros)\n",
+               cached, cached ? "fixed --" : "REVERTED to positional fill --");
+    }
+    return cached;
+}
+
+/* Restore the pre-fix values of the PropDefHeaderRecord group (type/state/extrascale) and
+ * the ObjectRecord group (obj/pad) exactly as the positional literal produced them.
+ * `type`/`pad` are the values the literal MEANT to place there. */
+static void getv_subword_unfix_obj(ObjectRecord *o, u8 type, s16 pad)
+{
+    o->type       = 0;            /* 0x0100 truncated to u8 */
+    o->state      = 0;
+    o->extrascale = (u16)type;    /* the type byte landed in extrascale */
+    o->pad        = 0;            /* the literal's `obj` entry (always 0) landed in pad */
+    o->obj        = pad;          /* ...and its `pad` entry landed in obj */
+}
+
+/* Same, for WeaponObjRecord's own GE_SUBWORD3 group (weaponnum/LinkedWeaponType/timer). */
+static void getv_subword_unfix_wpn(WeaponObjRecord *w, s8 weaponnum, s8 link, s16 timer)
+{
+    w->timer            = (s16)weaponnum;
+    w->LinkedWeaponType = link;
+    w->weaponnum        = (s8)timer;
+}
