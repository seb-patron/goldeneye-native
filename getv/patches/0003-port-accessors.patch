+#include <stdio.h>
+/* GETV_STATE -- one machine-readable line of progress, called by the port each nth frame.
+ *
+ * It lives here rather than in the port layer because the port cannot see struct player or
+ * OBJECTIVESTATUS, and adding game headers to it would tangle the two together for a
+ * diagnostic. The port calls gePortStateDump(frame) through a plain prototype.
+ *
+ * The point is to make a level attempt assertable. Frame counts and triangle counts say the
+ * renderer is busy; they cannot say Bond reached the objective. This prints where each
+ * player is, how many objectives the mission has, each status, and whether the mission is
+ * complete -- which is what a script needs to decide whether a run passed. */
+/* Position of one player, for the script host in getv/port/src/ge_lua.c.
+ *
+ * It lives here rather than in the port layer for the same reason gePortStateDump() does:
+ * struct player is a game type, and the offset of pos within it is not the N64 offset
+ * (the 32-bit pointers ahead of it are 64-bit here), so any port-side copy of that number
+ * would be wrong now or wrong later. Returns 0 when the slot is empty, which a script
+ * sees as nil.
+ *
+ * g_playerPointers, not g_CurrentPlayer: that pointer is swapped as each viewport is
+ * drawn, so in split screen it names whichever player was rendered last. */
+int gePortPlayerPos(int idx, f32 *out)
+{
+    extern struct player *g_playerPointers[4];
+
+    if (idx < 0 || idx > 3 || g_playerPointers[idx] == NULL) {
+        return 0;
+    }
+    /* prop->pos, NOT player->pos.
+     *
+     * player->pos is zeroed at spawn (player.c:160, bondview.c:1423) and only a couple of paths
+     * ever write it, so it reads as a plausible frozen coordinate rather than as nothing. The
+     * world position the game itself maintains is on the prop, written from the collision
+     * record every tick by five sites (bondview2.c:1225, 5108, 9478, 11481, 11517).
+     *
+     * Reading the wrong one cost real time: co-op looked frozen for days -- the players were
+     * walking, with collision_position and theta_transform both advancing -- and the route bot's
+     * distance-to-waypoint never changed, so it steered forever against a stale fix. Measured on
+     * Bunker 1: collision_position moved 530 units while this function returned the same
+     * coordinate 900 times.
+     *
+     * The fallback matters. prop is null between level load and the first spawn, and a player
+     * with no prop has no world position to report -- so refuse, the same as an empty slot,
+     * rather than handing back the stale field and calling it an answer. */
+    if (g_playerPointers[idx]->prop == NULL) {
+        return 0;
+    }
+    out[0] = g_playerPointers[idx]->prop->pos.x;
+    out[1] = g_playerPointers[idx]->prop->pos.y;
+    out[2] = g_playerPointers[idx]->prop->pos.z;
+    return 1;
+}
+
+/* Which way a player is facing, in degrees, for the bot and agent APIs.
+ *
+ * Same lane argument as gePortPlayerPos above: struct player is a game type and the port
+ * layer cannot see it. ge_bot_route.c was dead-reckoning heading from successive positions
+ * because this did not exist, and that estimator has a deadlock in it -- a bot that needs to
+ * turn more than the alignment threshold walks at zero speed, so it never moves, so the
+ * estimate never updates and the turn never completes. Measured on Bunker 1: err stuck at
+ * 142 degrees for 1100 frames with the stick hard over.
+ *
+ * theta_transform is the collision record's forward vector, which is what the walk code
+ * itself steers by (bondview2.c:7781 builds the move offset from f[0] and f[2]). Reading the
+ * same vector the movement uses means heading and travel cannot disagree.
+ *
+ * atan2(x, z) rather than the usual atan2(y, x): the route extractor measures bearings that
+ * way, so the two are directly comparable without a fudge term at the call site.
+ */
+int gePortPlayerAngle(int idx, f32 *out_deg)
+{
+    extern struct player *g_playerPointers[4];
+    f32 fx, fz;
+
+    if (idx < 0 || idx > 3 || out_deg == NULL || g_playerPointers[idx] == NULL) {
+        return 0;
+    }
+
+    fx = g_playerPointers[idx]->field_488.theta_transform.f[0];
+    fz = g_playerPointers[idx]->field_488.theta_transform.f[2];
+
+    /* An all-zero vector has no direction, and returning 0 degrees for it would be a lie the
+     * caller cannot detect. Refuse instead, the way the position accessor refuses an empty
+     * slot. */
+    if (fx == 0.0f && fz == 0.0f) {
+        return 0;
+    }
+
+    *out_deg = (f32) (atan2f(fx, fz) * (180.0 / 3.14159265358979323846));
+    return 1;
+}
+
+
+/* The rest of the state readout the player API declares.
+ *
+ * Same lane argument as the two above, and the same refusal contract: return 0 rather than
+ * writing a zero, so a caller can tell "not available" from "genuinely zero". A learning agent
+ * trained on a health of 0.0 that actually meant "no accessor" is learning from a lie, and the
+ * flags word in GePlayerState exists precisely so that distinction survives.
+ *
+ * Grouped by cluster rather than one call per field: each cluster is one null check and one
+ * struct walk, and the caller wants them together anyway.
+ */
+
+/* Which room the player is standing in.
+ *
+ * From the STAN TILE under their feet, which is the room the engine itself is working in.
+ *
+ * The prop's rooms[] list was the obvious source and it is empty for the player: measured on
+ * Bunker 1 at frames 301, 901 and 1801, rooms[0] is 0xff every time, so GE_ST_ROOM never
+ * appeared in the flags word. That list is maintained for props the room system tracks; the
+ * player is placed by the stan query instead and carries its result on the collision record.
+ *
+ * The tile pointer is null before the first placement and while a player is mid-respawn, and
+ * a tile's room is 0xff when it belongs to no room. Both refuse rather than guessing -- an
+ * agent that reads room 0 for "unknown" will confidently route through the wrong part of the
+ * map, which is the same class of failure as the assumed spawns in tools/dump_spawns.py. */
+int gePortPlayerRoom(int idx, s32 *out_room)
+{
+    extern struct player *g_playerPointers[4];
+    StandTile *tile;
+    u8 room;
+
+    if (idx < 0 || idx > 3 || out_room == NULL || g_playerPointers[idx] == NULL) { return 0; }
+
+    tile = g_playerPointers[idx]->field_488.current_tile_ptr;
+    if (tile == NULL) { return 0; }
+
+    room = tile->room;
+    if (room == 0xff) { return 0; }
+
+    *out_room = (s32) room;
+    return 1;
+}
+
+/* Health, armour and whether the player is down.
+ *
+ * bondhealth/bondarmour rather than apparenthealth/apparentarmour. The apparent pair is what the
+ * HUD bar animates towards, so it lags the real value by however long the bar takes to slide --
+ * fine for drawing, wrong for a bot deciding whether to retreat and wrong for a reward signal.
+ * oldhealth is the previous frame's value and is for computing damage taken, not for reading. */
+int gePortPlayerHealth(int idx, f32 *out_hp, f32 *out_armour, s32 *out_dead)
+{
+    extern struct player *g_playerPointers[4];
+
+    if (idx < 0 || idx > 3 || g_playerPointers[idx] == NULL) { return 0; }
+
+    if (out_hp != NULL)     { *out_hp     = g_playerPointers[idx]->bondhealth; }
+    if (out_armour != NULL) { *out_armour = g_playerPointers[idx]->bondarmour; }
+    if (out_dead != NULL)   { *out_dead   = (g_playerPointers[idx]->bonddead != 0); }
+    return 1;
+}
+
+/* What is in the player's hands.
+ *
+ * Hand 0, the right hand, which is the one a single-wielded weapon occupies -- the left is
+ * ITEM_UNARMED unless the player is dual wielding, which is why a naive read of hands[1] looked
+ * like "no weapon" for most of the game.
+ *
+ * The magazine count is on the hand. The reserve is not: it lives in the player's ammoheldarr,
+ * indexed by AMMO type rather than by weapon, because several weapons share a pool -- so the
+ * weapon has to be mapped through get_ammo_type_for_weapon first. Indexing that array by the
+ * weapon id directly returns a real number belonging to an unrelated ammo type. */
+int gePortPlayerWeapon(int idx, s32 *out_weapon, s32 *out_clip, s32 *out_reserve)
+{
+    extern struct player *g_playerPointers[4];
+    extern s32 get_ammo_type_for_weapon(ITEM_IDS weapon);
+    struct player *p;
+    ITEM_IDS weapon;
+
+    if (idx < 0 || idx > 3 || g_playerPointers[idx] == NULL) { return 0; }
+    p = g_playerPointers[idx];
+    weapon = p->hands[0].weaponnum;
+
+    if (out_weapon != NULL) { *out_weapon = (s32) weapon; }
+    if (out_clip != NULL)   { *out_clip   = p->hands[0].weapon_ammo_in_magazine; }
+    if (out_reserve != NULL) {
+        s32 type = get_ammo_type_for_weapon(weapon);
+        *out_reserve = (type >= 0 && type < 30) ? p->ammoheldarr[type] : 0;
+    }
+    return 1;
+}
+
+/* Kills, deaths and shots fired.
+ *
+ * These live in g_playerPlayerData[], the permanent per-slot record, NOT in struct player --
+ * g_playerPerm is only a cursor into that array pointing at whichever player is current, so
+ * reading through it gives the current viewport's score for every slot asked about.
+ *
+ * Deaths have to be summed rather than read. There is no deaths counter: kill_counts[v] inside
+ * player j's record is "how many times j killed v", so a player's deaths are that column summed
+ * down the whole array, which is exactly what mpmenu.c:398 does when it builds the end-of-game
+ * table. Suicides land in kill_counts[i] of player i's own record and count as a death there,
+ * which matches how the scoreboard reports them.
+ *
+ * Solo has no opponents, so kills and deaths are legitimately 0 there while shots is real. */
+/* Which control style a slot is configured for, and whether that style spans two pads.
+ *
+ * cur_player_get_control_type() reads g_CurrentPlayer, which is a per-viewport cursor -- asking
+ * it about slot 2 while slot 0 is being drawn returns slot 0's answer. This reads the slot.
+ *
+ * The two-pad question matters to anything injecting input. Styles 2.1 Plenty, 2.2 Galore,
+ * 2.3 Domino and 2.4 Goodhead read movement from a SECOND controller at index
+ * playernum + getPlayerCount() (bondview2.c:5371), which is how the engine's twin-stick modes
+ * were built and is what this port defaults to so a modern dual-analog pad maps cleanly. A
+ * caller that writes only the slot's own pad drives the turn and never the walk. */
+int gePortPlayerControlStyle(int idx)
+{
+    extern struct player *g_playerPointers[4];
+
+    if (idx < 0 || idx > 3 || g_playerPointers[idx] == NULL) { return -1; }
+    return (s32) g_playerPointers[idx]->cur_player_control_type_0;
+}
+
+int gePortPlayerUsesTwoPads(int idx)
+{
+    s32 style = gePortPlayerControlStyle(idx);
+
+    return (style == CONTROLLER_CONFIG_PLENTY || style == CONTROLLER_CONFIG_GALORE
+            || style == CONTROLLER_CONFIG_DOMINO || style == CONTROLLER_CONFIG_GOODHEAD);
+}
+
+/* The pad index the movement axes come from for this slot, or the slot itself for a
+ * one-controller style. Mirrors bondview2.c:5371 exactly rather than recomputing the rule. */
+int gePortPlayerMovePad(int idx)
+{
+    if (!gePortPlayerUsesTwoPads(idx)) { return idx; }
+    return idx + (s32) getPlayerCount();
+}
