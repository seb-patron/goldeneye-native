+/* ===================================================================== CLEARANCE
+ *
+ * "Does a body FIT here" -- asked of the engine's own collision, not approximated.
+ *
+ * Everything else in this file answers questions about POINTS. A point is not a body, and the
+ * gap between those two ideas is what strands the CLI player on Train: it steers for a gap
+ * between a crate and a wall that is narrower than Bond, and every reading it has says there is
+ * space, because every reading is about a centre.
+ *
+ * SURFACE_QUEUE 1c used to say to sweep a radius or sample parallel lines either side. Do not:
+ * that approximates this test and misses doors, characters and path blockers entirely. The
+ * engine already ships the exact test and the guard AI runs it before every step it takes
+ * (chr.c:1468) -- a line test to the destination, then a volume test at it.
+ *
+ * THE MASK IN THE GUARD AI DOES NOT INCLUDE WALLS, and that surprised me.
+ *
+ *   CDTYPE_OBJS 0x01  DOORS 0x02  PLAYERS 0x04  CHRS 0x08  PATHBLOCKER 0x10  BG 0x20
+ *
+ * chr.c:1468 passes 0x1f, which is everything EXCEPT CDTYPE_BG -- so the guard's own step test
+ * never asks about background geometry. It does not need to: a guard walks the stan mesh, and
+ * the mesh only exists where there is floor, so walls are implied by the absence of a tile.
+ *
+ * That reasoning does NOT carry over to us. stan snaps to the nearest standable tile rather than
+ * testing a point, so it answers yes almost everywhere -- the Bunker 1 spawn probes as 840x840
+ * units of open floor. Walls are BACKGROUND geometry here, which is exactly why
+ * gePortProbeWalkable had to use CDTYPE_BG to see them at all.
+ *
+ * So the default mask below is 0x3f: the guard's set PLUS the walls it can afford to omit and we
+ * cannot. GETV_STAND_MASK overrides it, because the claim "adding BG to a volume test behaves
+ * sensibly" is an empirical one and the two masks should be comparable in one run rather than
+ * argued about.
+ */
+
+/* stan.c:2073 and stan.c:1686. Declared here rather than including stan's header, for the same
+ * reason gePortProbeWalkable declares bondviewTestLineUnobstructed locally: the header drags in a
+ * chain of constants this translation unit does not otherwise need, and trading a build break for
+ * a coupling is not a trade.
+ *
+ * The last two arguments of stanTestVolume are NOT ymin/ymax. chrGetChrWidthHeight (chr.c)
+ * fills them as height = chrheight - 20 and a third out-param that is literally always 20.0f, and
+ * chr.c:1468 passes them in that order. Naming them ymin/ymax invites someone to pass a floor and
+ * a ceiling, which is a different and wrong question. */
+extern s32 stanTestVolume(StandTile **pTile, f32 x, f32 z, f32 width, s32 cdtypes,
+                          f32 height, f32 foot);
+extern s32 stanTestLineUnobstructed(StandTile **pTile, f32 p_x, f32 p_z, f32 dest_x, f32 dest_z,
+                                    s32 cdtypes, f32 height, f32 a, f32 b, f32 c);
+
+#define GE_STAND_WIDTH   20.0f   /* ChrRecord.chrwidth, chr.c:1936 -- so a gap wants ~40 clear */
+#define GE_STAND_HEIGHT 165.0f   /* chrheight 185 minus the 20 chrGetChrWidthHeight subtracts */
+#define GE_STAND_FOOT    20.0f   /* the "always_20" third out-param, which really is always 20 */
+
+static s32 ge_stand_mask(void)
+{
+    static s32 mask = -1;
+    if (mask < 0) {
+        const char *e = getenv("GETV_STAND_MASK");
+        /* 0x3f, not the guard's 0x1f: see the wall discussion above. */
+        mask = (e != NULL && *e != '\0') ? (s32) strtol(e, NULL, 0) : 0x3f;
+    }
+    return mask;
+}
+
+/* Seed a StandTile for a query at (x,z).
+ *
+ * THE TILE IS AN INPUT. Passing NULL makes every call report obstructed -- the same trap
+ * gePortProbeWalkable documents, and the reason a Bunker 1 reachability map once came back solid
+ * even 60 units from the player.
+ *
+ * Seeded from the point being ASKED ABOUT, not from where the player happens to stand: seeding
+ * every query from the spawn produces answers about the spawn. Returns NULL when it cannot
+ * establish a starting tile, and callers treat that as "cannot say" rather than "blocked" --
+ * those are different, and collapsing them is how an unmeasurable point becomes a fake wall.
+ */
+static StandTile *ge_stand_seed(f32 x, f32 z, f32 *out_y)
+{
+    f32 qx = x, qz = z, y = 0.0f;
+    StandTile *tile = sub_GAME_7F0AFB78(&qx, &y, &qz, 60.0f);
+    if (out_y != NULL) { *out_y = y; }
+    return tile;
+}
+
+/* Can a body of Bond's width stand centred on (x,z)?
+ *
+ *   1  yes, it fits
+ *   0  no, something is in the way
+ *  -1  CANNOT SAY -- no stan tile could be established here
+ *
+ * THREE STATES, DELIBERATELY. A bot that reads "cannot say" as "blocked" walls itself into
+ * the small region it has already measured; one that reads it as "clear" walks into the thing it
+ * failed to see. The caller has to choose, so the distinction is preserved rather than folded
+ * into a bool -- the same reason the sensing API returns masks instead of yes/no.
+ */
+int gePortCanStandAt(f32 x, f32 z)
+{
+    StandTile *tile = ge_stand_seed(x, z, NULL);
+    if (tile == NULL) { return -1; }
+
+    stanResetHits();
+    /* NEGATIVE means it fits. chr.c:1468 tests `< 0` and treats that as room for a body; a
+     * non-negative return is the INDEX of whatever is in the way, so the natural-looking
+     * `if (stanTestVolume(...))` reads exactly backwards. */
+    return (stanTestVolume(&tile, x, z, GE_STAND_WIDTH, ge_stand_mask(),
+                           GE_STAND_HEIGHT, GE_STAND_FOOT) < 0) ? 1 : 0;
+}
+
+/* Can a body walk the straight line from (x0,z0) to (x1,z1)?
+ *
+ * This is the guard AI's pairing, in its order: the line first, then the volume AT THE
+ * DESTINATION. The line test alone is what a point-based planner already does, and it is exactly
+ * what passes a body through a gap it does not fit -- the destination volume test is the half
+ * that makes it about a body.
+ *
+ * Distinct from gePortProbeWalkable, which is not superseded: that one asks bondview with
+ * CDTYPE_BG only, so it answers "is there a wall between these points" and deliberately ignores
+ * characters, because a route planner that treats a passing guard as a wall re-plans forever.
+ * This one asks the full set INCLUDING transients, which is the right question for the next step
+ * and the wrong one for a route. Keep both; they answer different questions.
+ */
+/* The same pairing as gePortPathClear, but reporting which half objected.
+ *
+ * gePortPathClear answers yes or no, which is what a planner wants and what a diagnosis cannot
+ * use. The route audit was calling it and reporting every no as "blocked", including steps the
+ * bot demonstrably walks -- so the interesting question is not whether a step failed but which
+ * of the two tests failed it. A blocked LINE is a wall between the two points. A blocked VOLUME
+ * is the destination waypoint itself sitting somewhere a body does not fit, which says nothing
+ * about the journey and everything about where the waypoint was placed.
+ *
+ * Returns a bitfield: 1 = the line is clear, 2 = the destination has room. Both set means the
+ * step is walkable; -1 means there is no tile to stand a query on.
+ */
+s32 gePortPathClearParts(f32 x0, f32 z0, f32 x1, f32 z1)
+{
+    s32 mask = ge_stand_mask();
+    StandTile *tile = ge_stand_seed(x0, z0, NULL);
+    s32 result = 0;
+
+    if (tile == NULL) { return -1; }
+
+    stanResetHits();
+    if (stanTestLineUnobstructed(&tile, x0, z0, x1, z1, mask,
+                                 GE_STAND_HEIGHT, GE_STAND_FOOT, 0.0f, 1.0f)) {
+        result |= 1;
+    } else {
+        /* The line test walks the tile forward as it goes and leaves it wherever it stopped, so
+         * the volume question has to be re-seeded from the destination to mean anything. */
+        tile = ge_stand_seed(x1, z1, NULL);
+        if (tile == NULL) { return result; }
+    }
+
+    if (stanTestVolume(&tile, x1, z1, GE_STAND_WIDTH, mask, GE_STAND_HEIGHT, GE_STAND_FOOT) < 0) {
+        result |= 2;
+    }
+    return result;
+}
+
+
+/* Which floor tile is at (x, z), by the game's own number for it.
+ *
+ * Every level's floor is a mesh of numbered tiles -- Rare's own ids, straight out of the stan
+ * file -- and until now nothing in the port ever said which one you were standing on. A player
+ * that walks into something can say "there is a wall 96 units ahead", which is true and useless:
+ * it is the same sentence at every wall in the game. Naming the tile turns that into a position
+ * on a map you can hold, and makes "I have been here before" a thing that can be noticed rather
+ * than a thing that has to be inferred from coordinates drifting by twenty units.
+ *
+ * Returns 1 and fills the outputs, or 0 where there is no floor -- which is itself the answer to
+ * "can I stand there", asked a different way.
+ */
+s32 gePortTileAt(f32 x, f32 z, s32 *out_id, s32 *out_room)
+{
+    StandTile *tile = ge_stand_seed(x, z, NULL);
+
+    if (tile == NULL) { return 0; }
+    if (out_id != NULL)   { *out_id = (s32) tile->id; }
+    if (out_room != NULL) { *out_room = (s32) tile->room; }
+    return 1;
+}
+
+
+int gePortPathClear(f32 x0, f32 z0, f32 x1, f32 z1)
+{
+    s32 mask = ge_stand_mask();
+    StandTile *tile = ge_stand_seed(x0, z0, NULL);
+    if (tile == NULL) { return -1; }
+
+    stanResetHits();
+    if (!stanTestLineUnobstructed(&tile, x0, z0, x1, z1, mask,
+                                  GE_STAND_HEIGHT, GE_STAND_FOOT, 0.0f, 1.0f)) {
+        return 0;
+    }
+    /* The tile has been walked forward to the destination end by the line test, which is why it
+     * is passed straight on rather than re-seeded -- re-seeding here would throw away the one
+     * piece of state the pairing depends on. */
+    return (stanTestVolume(&tile, x1, z1, GE_STAND_WIDTH, mask,
+                           GE_STAND_HEIGHT, GE_STAND_FOOT) < 0) ? 1 : 0;
+}
+
+
+/* ---------------------------------------------------------------------------------------------
+ * THE GAME'S OWN NAVIGATION GRAPH.
+ *
+ * GoldenEye SHIPS A PATHFINDER AND WE BUILT A SECOND ONE BESIDE IT. padhalllv.c holds a full
+ * two-level nav system -- waypoints grouped into waygroups, BFS within a group and across groups,
+ * waypointFindRoute, waypointFindNextStepToward, even Rare's own waypointDebugTestRandomRoute --
+ * and the guards have been using it the whole time.
+ *
+ * It also explains a measurement that never made sense. 139 of Train's 180 pads could not be stood
+ * on, which read as "pads are bad waypoints". They are not: a pad is a marker for anything at all,
+ * and only the pads named by g_CurrentSetup.pathwaypoints are NAV pads. We were routing on the
+ * wrong subset and blaming the set.
+ *
+ * These accessors expose the graph as it is -- ids, positions, neighbours, groups -- because it is
+ * already numbered, which is exactly the addressable space a bot or a mod needs: not "north-west"
+ * but "waypoint 41, whose neighbours are 40 and 42, in group 3".
+ * --------------------------------------------------------------------------------------------- */
+
+int gePortNavCount(void)
+{
+    waypoint *node = g_CurrentSetup.pathwaypoints;
+    int n = 0;
+
+    if (node == NULL) { return 0; }
+    /* Terminated by a negative padID, the same way the engine walks it. */
+    while (node->padID >= 0) { n++; node++; }
+    return n;
+}
+
+int gePortNavAt(s32 index, s32 *out_pad, f32 *out_pos, s32 *out_group)
+{
+    waypoint *node = g_CurrentSetup.pathwaypoints;
+    int n = gePortNavCount();
+
+    if (node == NULL || index < 0 || index >= n) { return 0; }
+    node += index;
+
+    if (out_pad != NULL)   { *out_pad = node->padID; }
+    if (out_group != NULL) { *out_group = node->groupNum; }
+    if (out_pos != NULL) {
+        PadRecord *pad = &g_CurrentSetup.pads[node->padID];
+        out_pos[0] = pad->pos.x;
+        out_pos[1] = pad->pos.y;
+        out_pos[2] = pad->pos.z;
+    }
+    return 1;
+}
+
+int gePortNavNeighbours(s32 index, s32 *out, s32 max)
+{
+    waypoint *node = g_CurrentSetup.pathwaypoints;
+    int n = gePortNavCount();
+    int count = 0;
+    s32 *nb;
+
+    if (node == NULL || index < 0 || index >= n || out == NULL) { return 0; }
+    nb = (node + index)->neighbours;
+    if (nb == NULL) { return 0; }
+    while (*nb >= 0 && count < max) { out[count++] = *nb; nb++; }
+    return count;
+}
+
+/* The nearest nav waypoint to a position, as an INDEX into the list above rather than a pointer,
+ * so callers outside the engine can hold on to it. */
+int gePortNavNearest(f32 x, f32 z)
+{
+    waypoint *node = g_CurrentSetup.pathwaypoints;
+    int n = gePortNavCount();
+    int i, best = -1;
+    f32 bestd = -1.0f;
+
+    if (node == NULL) { return -1; }
+    for (i = 0; i < n; i++) {
+        PadRecord *pad = &g_CurrentSetup.pads[node[i].padID];
+        f32 dx = x - pad->pos.x;
+        f32 dz = z - pad->pos.z;
+        f32 d = dx * dx + dz * dz;
+        if (bestd < 0.0f || d < bestd) { bestd = d; best = i; }
+    }
+    return best;
+}
+
+/* The PAD id of the nav waypoint nearest a position. The log names pads rather than our own node
+ * numbers wherever it can: a pad id means something in the level's own setup data, and our node
+ * ids mean something only to us. */
+int gePortNavNearestPad(f32 x, f32 z)
+{
+    s32 pad = -1;
+    int idx = gePortNavNearest(x, z);
+    if (idx < 0) { return -1; }
+    if (!gePortNavAt(idx, &pad, NULL, NULL)) { return -1; }
+    return (int) pad;
+}
+
+/* A route between two waypoint indices, using the ENGINE'S OWN waypointFindRoute -- the same call
+ * the guards route with. Fills out with indices and returns how many it wrote. */
+int gePortNavRoute(s32 from, s32 to, s32 *out, s32 max)
+{
+    waypoint *head = g_CurrentSetup.pathwaypoints;
+    waypoint *arr[64];
+    int n = gePortNavCount();
+    int got, i, wrote = 0;
+
+    if (head == NULL || out == NULL || max <= 0) { return 0; }
+    if (from < 0 || from >= n || to < 0 || to >= n) { return 0; }
+
+    got = waypointFindRoute(head + from, head + to, arr, 64);
+    if (got <= 0) { return 0; }
+
+    for (i = 0; i < got && wrote < max; i++) {
+        if (arr[i] == NULL) { continue; }
+        out[wrote++] = (s32) (arr[i] - head);
+    }
+    return wrote;
+}
+
+
+
+/* ---------------------------------------------------------------------------------------------
+ * OPEN A DOOR THE WAY THE GUARDS DO.
+ *
+ * THE BOT HAS BEEN PRESSING THE PLAYER'S USE BUTTON AND THE GUARDS NEVER DO. Measured on Train:
+ * 1,305 USE presses against one door, 343 door contacts, and it never got through -- because the
+ * player path (doorTestForInteract, propobj.c:14411) additionally demands PROPFLAG_ONSCREEN and a
+ * maxFrac above zero, which is a statement about the CAMERA, and a bot walking at a door in the
+ * dark satisfies neither reliably.
+ *
+ * Perfect Dark is what pointed at this. Its chrOpenDoor (chraction.c:12221) does not simulate a
+ * button at all: it sweeps a cylinder along the movement it wants to make with CDTYPE_CLOSEDDOORS,
+ * checks the door is not flagged AICANNOTUSE, and then asks the door to open --
+ * doorsChooseSwingDirection followed by doorsRequestMode(DOORMODE_OPENING).
+ *
+ * GoldenEye has the same path and its own guards use it, chraction.c:9219: find the door along the
+ * intended movement with sub_GAME_7F0B1410, skip PROPFLAG_DOOR_OPENTOFRONT, require the same 200
+ * units, then doorsChooseSwingDirection and doorActivate. So nothing needs porting -- it needed
+ * finding, and PD is where it was legible.
+ *
+ * Returns 1 if a door was asked to open, 0 if there was nothing to open, -1 if there is no player,
+ * and -2 if the door is locked and the bot is not carrying its key.
+ * --------------------------------------------------------------------------------------------- */
+int gePortOpenDoorAhead(s32 idx, f32 to_x, f32 to_z)
+{
+    PropRecord *self;
+    PropRecord *hit;
+    f32 dx, dy, dz;
+
+    if (idx < 0 || idx >= 4 || g_playerPointers[idx] == NULL) { return -1; }
+    self = g_playerPointers[idx]->prop;
+    if (self == NULL || self->stan == NULL) { return -1; }
+
+    /* 0x5000 is the cdtype mask the guard path passes -- the doors it is allowed to consider. */
+    hit = sub_GAME_7F0B1410(self->stan, self->pos.f[0], self->pos.f[2], to_x, to_z, 0x5000);
+    if (hit == NULL || hit->door == NULL) { return 0; }
+
+    /* A door that opens to its front is one the engine swings for whoever is in front of it; the
+     * guard path skips those rather than asking twice. */
+    if (hit->obj != NULL && (hit->obj->flags2 & PROPFLAG_DOOR_OPENTOFRONT)) { return 0; }
+
+    dx = hit->pos.f[0] - self->pos.f[0];
+    dy = hit->pos.f[1] - self->pos.f[1];
+    dz = hit->pos.f[2] - self->pos.f[2];
+    if (((dx * dx) + (dy * dy) + (dz * dz)) >= 40000.0f) { return 0; }   /* 200 units, as the guards */
+
+    /* THE KEY IS NOT OPTIONAL, AND doorActivate DOES NOT CHECK IT.
+     *
+     * doorActivate swings whatever it is handed. The check lives one level up, in the player's
+     * interact path (propobj.c:14591): a door with keyflags of zero is unlocked, otherwise the
+     * player must be CARRYING those key flags. Calling doorActivate without repeating that test
+     * would let the bot walk through Train's locked doors with no key at all -- which is not a bot
+     * that plays the game, it is a bot that ignores it, and every route it then found would be a
+     * route no player could walk.
+     *
+     * Train is exactly where this bites: a guard carries the door key, so the honest sequence is
+     * kill the guard, pick up the key, then the door opens. Refusing here is what forces the bot
+     * to go and do that.
+     */
+    if (hit->door->keyflags != 0 && bondinvCheckHasKeyFlags(hit->door->keyflags) == 0) {
+        return -2;   /* locked, and we do not have its key */
+    }
+
+    doorsChooseSwingDirection(self, hit->door);
+    doorActivate(hit->door, 1);
+    return 1;
+}
+
+
+
+/* ---------------------------------------------------------------------------------------------
+ * WHERE THE OBSTACLE'S EDGES ARE -- PORTED FROM PERFECT DARK, ONTO GOLDENEYE'S OWN DATA.
+ *
+ * THIS IS THE "IT TURNED RIGHT WHEN IT SHOULD HAVE TURNED LEFT" BUG, AND RARE FIXED IT IN 2000.
+ *
+ * Our follower asks "which heading is clearest" and sweeps for an answer, which is a guess dressed
+ * as a measurement: the clearest heading from where the bot happens to face can be the opposite
+ * side of the crate from where it needs to go. Perfect Dark never asks that question.
+ * chrNavCanSeeNextPos (chraction.c:11808) casts the movement line offset to each shoulder by the
+ * body radius, and when one collides it calls cdGetEdge to get the EDGE of what blocked it --
+ * returning obstacleleft and obstacleright, the actual sides of the actual obstacle. chrNavTryObstacle
+ * then aims at one side with a clearance of radius * 1.26. Left and right stop being a guess.
+ *
+ * GoldenEye has the same primitive and it is even named the same in Rare's own debug strings:
+ * stan.c saves stanSavedColl_tile and stanSavedColl_pointI on a failed line test, exposed through
+ * functions whose DEBUG text reads "Don't call stanCircleLegalHit()!" and
+ * "Don't call stanCircleLegalHitEdge()!". The blocking edge is that tile's point pair.
+ *
+ * So this is a port of PD's IDEA onto GE's DATA, not a copy of PD's code -- the collision calls
+ * are different and pretending otherwise would produce something that compiles and lies.
+ *
+ * Returns 1 when blocked and both edge points were written, 0 when the way is clear.
+ * --------------------------------------------------------------------------------------------- */
+int gePortObstacleEdge(f32 x0, f32 z0, f32 x1, f32 z1, f32 *out_left, f32 *out_right)
+{
+    s32 mask = ge_stand_mask();
+    StandTile *tile = ge_stand_seed(x0, z0, NULL);
+    StandTile *hit;
+    s32 edge, count, a, b;
+
+    if (tile == NULL) { return 0; }
+
+    /* THE STAN MESH IS THE FLOOR, NOT THE FURNITURE. First version asked
+     * stanTestLineUnobstructed alone and got "clear" 114 times out of 114 while the bot was
+     * pressed against a crate: crates and walls live in OBJECT and BG collision, and stan carries
+     * the standable surface. Asking the floor where the crate is will always answer nothing.
+     *
+     * So the prop sweep runs FIRST -- sub_GAME_7F0B1410 returns the actual blocking prop, which is
+     * the same call the guards use to find a door -- and its bounding radius gives the two sides.
+     * The stan edge is the fallback for geometry that is genuinely part of the walkable mesh. */
+    {
+        PropRecord *obs = sub_GAME_7F0B1410(tile, x0, z0, x1, z1,
+                                            CDTYPE_OBJS | CDTYPE_BG | CDTYPE_PATHBLOCKER);
+        if (obs != NULL) {
+            f32 dx = x1 - x0, dz = z1 - z0;
+            f32 len = sqrtf(dx * dx + dz * dz);
+            f32 px, pz;
+            f32 hx = 0.0f, hz = 0.0f, r = 0.0f;
+
+            if (len < 1.0f) { return 0; }
+            dx /= len;
+            dz /= len;
+
+            /* How wide the thing actually is, from its own bounding box. Falling back to a fixed
+             * width when the extent will not resolve errs WIDE on purpose: swinging too far around
+             * a crate costs a little distance, clipping its corner costs the whole run. */
+            if (!gePortPropExtent(obs, &hx, &hz, &r) || r <= 1.0f) {
+                r = 100.0f;
+            }
+
+            /* The two sides are the obstacle's centre pushed perpendicular to the direction of
+             * travel. Perpendicular rather than axis-aligned, because a crate approached diagonally
+             * presents a corner, and its x extent is not what is in the way. */
+            px = -dz;
+            pz = dx;
+
+            if (out_left != NULL) {
+                out_left[0] = obs->pos.f[0] + px * r;
+                out_left[1] = obs->pos.f[2] + pz * r;
+            }
+            if (out_right != NULL) {
+                out_right[0] = obs->pos.f[0] - px * r;
+                out_right[1] = obs->pos.f[2] - pz * r;
+            }
+            return 1;
+        }
+    }
+
+    stanResetHits();
+    if (stanTestLineUnobstructed(&tile, x0, z0, x1, z1, mask,
+                                 GE_STAND_HEIGHT, GE_STAND_FOOT, 0.0f, 1.0f)) {
+        return 0;   /* nothing in the way, so there are no edges to report */
+    }
+
+    hit = sub_GAME_7F0B1CE0();     /* stanCircleLegalHit -- the tile that stopped the line */
+    edge = sub_GAME_7F0B1CEC();    /* stanCircleLegalHitEdge -- which of its edges */
+    if (hit == NULL) { return 0; }
+
+    /* The engine reads the point count off the tail half-word and masks it itself rather than
+     * going through the bitfield union, so this does the same -- a struct path that differs from
+     * the one every other reader uses is a struct path that drifts. */
+    count = hit->tail.hdrTail.pointCount & 0xF;
+    if (count <= 0) { return 0; }
+
+    /* An edge is a point and its successor, wrapping. Reading pointI+1 without the wrap walks off
+     * the end of the last tile in the list, which is a crash that only happens on the geometry a
+     * bot reaches last. */
+    a = edge % count;
+    b = (a + 1) % count;
+
+    if (out_left != NULL) {
+        out_left[0] = (f32) hit->points[a].x;
+        out_left[1] = (f32) hit->points[a].z;
+    }
+    if (out_right != NULL) {
+        out_right[0] = (f32) hit->points[b].x;
+        out_right[1] = (f32) hit->points[b].z;
+    }
+    return 1;
+}
+
+#endif
