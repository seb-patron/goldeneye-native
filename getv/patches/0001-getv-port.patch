+        nxt  = ge_be32(f + 12);
+        chld = ge_be32(f + 20);
+        if (nxt  && sp < GE_MODEL_MAXNODES - 1) { stack[sp++] = nxt; }
+        if (chld && sp < GE_MODEL_MAXNODES - 1) { stack[sp++] = chld; }
+    }
+
+    /* Pass 2 -- links and rodata, now that every node has an address. */
+    for (i = 0; i < ge_conv_count; i++) {
+        const u8  *f  = (const u8 *)(base + (ge_conv_off[i] - GE_MODEL_VMA));
+        ModelNode *nn = ge_conv_new[i];
+        u32 type = nn->Opcode & 0xff;
