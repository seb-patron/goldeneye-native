index 0a84cd5..d4f4663 100644
--- a/include/PR/os.h
+++ b/include/PR/os.h
@@ -845,11 +845,31 @@ extern void		osSetTLBASID(s32);
 extern u32		 osVirtualToPhysical(void *);
 extern void *		 osPhysicalToVirtual(u32);
 
+#ifdef GE_PORT_NATIVE
+/* tvOS port: there is no virtual/physical split, and the declared u32 return
+ * truncates a 64-bit pointer. Shadow both with identity macros so callers keep a
+ * real pointer. Matches OS_K0_TO_PHYSICAL and the R4300 K0/K1 macros. */
+#define osVirtualToPhysical(x)  ((void *)(x))
+#define osPhysicalToVirtual(x)  ((void *)(x))
+#endif
+
+#ifdef GE_PORT_NATIVE
+/* tvOS port: the N64 forms map a KSEG0/KSEG1 virtual address to a physical one for
+ * the RDP/RSP, and truncate to u32 on the way. A native port has no such address
+ * spaces and Fast3D consumes real pointers, so these are the identity - anything
+ * else would truncate a 64-bit pointer. */
+#define	OS_K0_TO_PHYSICAL(x)	(x)
+#define	OS_K1_TO_PHYSICAL(x)	(x)
+
+#define	OS_PHYSICAL_TO_K0(x)	((void *)(x))
+#define	OS_PHYSICAL_TO_K1(x)	((void *)(x))
+#else
 #define	OS_K0_TO_PHYSICAL(x)	(u32)(((char *)(x)-0x80000000))
 #define	OS_K1_TO_PHYSICAL(x)	(u32)(((char *)(x)-0xa0000000))
 
 #define	OS_PHYSICAL_TO_K0(x)	(void *)(((u32)(x)+0x80000000))
 #define	OS_PHYSICAL_TO_K1(x)	(void *)(((u32)(x)+0xa0000000))
+#endif
 
