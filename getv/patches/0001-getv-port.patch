+        nn->Parent = ge_conv_lookup(ge_be32(f + 8));
+        nn->Next   = ge_conv_lookup(ge_be32(f + 12));
+        nn->Prev   = ge_conv_lookup(ge_be32(f + 16));
+        nn->Child  = ge_conv_lookup(ge_be32(f + 20));
+
