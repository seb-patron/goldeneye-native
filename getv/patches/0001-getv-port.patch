+    while (sp > 0 && ge_conv_count < GE_MODEL_MAXNODES) {
+        u32 off = stack[--sp];
+        const u8 *f;
+        ModelNode *nn;
+        u32 nxt, chld;
+
+        if (off < GE_MODEL_VMA || ge_conv_lookup(off) != NULL) {
+            continue;
+        }
+        f = (const u8 *)(base + (off - GE_MODEL_VMA));
+        nn = mempAllocBytesInBank(sizeof(ModelNode), MEMPOOL_STAGE);
+        if (nn == NULL) {
