+        }
+        bzero(nn, sizeof(ModelNode));
+        nn->Opcode = ge_be16(f);
+
+        ge_conv_off[ge_conv_count] = off;
+        ge_conv_new[ge_conv_count] = nn;
+        ge_conv_count++;
