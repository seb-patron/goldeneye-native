+        if ((type == MODELNODE_OPCODE_HEADER || type == MODELNODE_OPCODE_OP20)
+            && nn->Data != NULL) {
+            u32 fg = (u32)(uintptr_t)nn->Data->Header.FirstGroupNode;
+            nn->Data->Header.FirstGroupNode = fg ? ge_conv_lookup(fg) : NULL;
+        }
+        if (type == MODELNODE_OPCODE_LOD && nn->Data != NULL) {
+            u32 af = (u32)(uintptr_t)nn->Data->LOD.Affects;
+            nn->Data->LOD.Affects = af ? ge_conv_lookup(af) : NULL;
+        }
