+/* Moved ge_fov_scale to file scope for this alone: F5/F6 (gfx_sdl2.c's onkeydown) need to
+ * change FOV live during gameplay, and the projection is already recomputed from
+ * gePortFovScale() fresh every frame per-viewport (this file, viSetupCurrentPlayerView) --
+ * see that comment for why only the multiplier is scaled, never the stored fovy. So making
+ * this live needs nothing downstream to be told to recompute; it already does, every frame,
+ * as a side effect of normal rendering. Bypasses the GETV_FOV environment read entirely
+ * once called -- the keybinding, not the launcher, owns the value from that point on for
+ * this process.
+ *
+ * Originally aimed at an in-game Watch settings page instead of a keybinding; dropped that
+ * route because options.h's WATCH_NUMBER_SCREENS carries an explicit "do not change this
+ * value until player struct is fully shiftable" from the decomp itself, and a live FOV
+ * control does not need a new Watch page to reach this function -- it needs nothing more
+ * than what is here. */
+void gePortSetFovScale(f32 new_scale)
+{
+    if (new_scale < 0.5f) { new_scale = 0.5f; }
+    if (new_scale > 1.6f) { new_scale = 1.6f; }
+    ge_fov_scale = new_scale;
+    /* No fflush(stdout): this file's printf is the decomp's own stdio shadow, not the
+     * real <stdio.h> -- stdout as a FILE* is not declared here, and adding the real
+     * header to a game-batch file is the exact trap $gameFlags's own comment (build
+     * scripts) documents: it lets the real header win over the shadow that is supposed
+     * to for every other translation unit compiled alongside this one. */
+}
