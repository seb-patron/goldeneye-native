diff --git a/assets/font/fontBankGothic.c b/assets/font/fontBankGothic.c
index 8b6c07f..cf100f7 100644
--- a/assets/font/fontBankGothic.c
+++ b/assets/font/fontBankGothic.c
@@ -393,3 +393,18 @@ u32 fontBankGothic_fontbytes[] =
 
 
 
+
+/* tvOS port: the N64 linker placed this file's .data into one contiguous ROM
+ * segment, and the game copies that whole blob out with romCopy(). Separate C
+ * arrays carry no adjacency guarantee, so the port concatenates them itself --
+ * these exporters exist because sizeof() is only visible inside this TU. */
+const unsigned int ge_fontBankGothic_sizes[3] = {
+    sizeof(fontBankGothic_kerning),
+    sizeof(fontBankGothic_fontchartable),
+    sizeof(fontBankGothic_fontbytes),
+};
+void *const ge_fontBankGothic_parts[3] = {
+    fontBankGothic_kerning,
+    fontBankGothic_fontchartable,
+    fontBankGothic_fontbytes,
+};
