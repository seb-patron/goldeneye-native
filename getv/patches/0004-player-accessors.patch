+}
+
+/* GETV-OBJENDIAN -- `text` and `difficulty` read the wrong half-word / wrong byte on
+ * little-endian.
+ *
+ * The data: a setup file's propDefs are emitted as a native `s32 words[]` array
+ * (assets/obseg/setup/UsetupdamZ.c), and gePropdefsConvertToNative() copies an
+ * ObjectiveStart record's four words VERBATIM into the native record
+ * (ge_propdef_layout.inc.c: PROPDEF_OBJECTIVE_START = {4 filewords, 6 natwords,
+ * ge_pdefsegs_MissionObjectiveRecord_4 = {0,0,16}}). So the four words arrive as
+ * little-endian u32 values with their correct numeric content:
+ *     word0 @0 = header/id      word1 @4 = menu
+ *     word2 @8 = TextID         word3 @12 = MinDifficulty
+ *
+ * The read: `struct objective_entry` (bondtypes.h:4034) is the N64 layout, where the
+ * sub-word fields sit at the big-endian positions inside those words:
+ *     u16 text       @0xa  = the low half of the word at 0x8   -> LE it is at 0x8
+ *     s8  difficulty @0xf  = the low byte of the word at 0xc   -> LE it is at 0xc
+ * Reading them at 0xa / 0xf on arm64 therefore yields the high half / high byte, which
+ * for every real record is zero. On DAM (stage 33) all four objectives read
+ * `text=0 difficulty=0` where the records hold TextID 11286,11287,11288,11289 and
+ * MinDifficulty 1,2,2,0.
+ *
+ * Consequences, both user-visible: the watch objectives screen renders no text
+ * (langGet(0)), and get_difficulty_for_objective() returns 0 for everything, so every
+ * `objdiff <= curdiff` filter passes and the Agent / 00 Agent objective sets are wrong.
+ *
+ * Read the word and narrow, which is endian-independent and is exactly the N64
+ * semantics. `struct watchMenuObjectiveText` (the watch briefing text) is the same
+ * 16-byte record with the same `u16 reserved; u16 text;` pair and the same bug, so it
+ * gets the same accessor.
+ *
+ * GETV_OBJENDIAN=0 restores the raw struct read for A/B on one binary.
+ * These are globals, not statics: a static inlines at -O1 and leaves no symbol for
+ * `nm -gU`. */
+s32 geObjEndianFlag = -1;
+
+s32 geObjEndianOn(void)
+{
+    if (geObjEndianFlag < 0) {
+        const char *e = getenv("GETV_OBJENDIAN");
+        geObjEndianFlag = (e && e[0] == '0') ? 0 : 1;
+    }
+    return geObjEndianFlag;
+}
+
+/* TextID: the low u16 of the record's third word. */
+u16 geObjText(const void *rec)
+{
+    if (!geObjEndianOn()) {
+        return ((const struct objective_entry *) rec)->text;
+    }
+    return (u16) ((const u32 *) rec)[2];
+}
+
+/* MinDifficulty: the low s8 of the record's fourth word. */
+s8 geObjDifficulty(const void *rec)
+{
+    if (!geObjEndianOn()) {
+        return ((const struct objective_entry *) rec)->difficulty;
+    }
+    return (s8) (((const u32 *) rec)[3] & 0xff);
+}
+
+/* GETV-OBJENDIAN, third field -- `unkD`.
+ *
+ * `text` and `difficulty` are fixed above; `unkD` has the same shape. It is 0 on DAM
+ * under either reading, but a scan of all 38 U setup files finds four ObjectiveStart
+ * records whose fourth word is 256 (0x00000100) rather than 0/1/2 --
+ *     UsetuparkZ.c:550   objective 4, text 3124
+ *     UsetupcaveZ.c:587  objective 4, text 7192
+ *     UsetuppeteZ.c:424  objective 2, text 25626
+ *     u/UsetupsiloZ.c:420 objective 4, text 34838
+ * (the other 76 ObjectiveStart records hold 0, 1 or 2, and all 105
+ * WatchMenuObjectiveText records hold 0.)
+ *
+ * The field's offset: `struct objective_entry` is
+ *     u32 id@0; enum menu@4; u16 reserved@8; u16 text@0xa; u16 unkC@0xc;
+ *     u8 unkD@0xe; s8 difficulty@0xf
+ * -- unkD's `// d` comment is wrong, natural alignment puts it at 0xe, and the
+ * _Static_assert below is armed to keep it honest. On the big-endian N64, byte 0xe is
+ * (word3 >> 8) & 0xff, so word3 == 0x100 gives unkD == 1. Reading the struct field on
+ * arm64 yields (word3 >> 16) & 0xff == 0 instead.
+ *
+ * This is a live path, not a dead field: cleanupObjectives()
+ * (cleanup_objectives.c:12) tests `unkD & 1` and force-completes those objectives; it
+ * is called from lvlUnloadStageTextData() (lv.c:1753) at the end of every stage. All
+ * four affected records are the last objective of their level -- the "escape"
+ * objective that completes when the mission ends. Under the raw read the flag is 0 on
+ * arm64, so those four objectives are never force-completed at unload.
+ *
+ * Read the word and narrow, exactly as above. GETV_OBJENDIAN=0 restores the raw read. */
+u8 geObjUnkD(const void *rec)
+{
+    if (!geObjEndianOn()) {
+        return ((const struct objective_entry *) rec)->unkD;
+    }
+    return (u8) ((((const u32 *) rec)[3] >> 8) & 0xff);
+}
+_Static_assert(__builtin_offsetof(struct objective_entry, unkD) == 0xe,
+               "objective_entry layout changed: unkD is no longer at 0xe");
+_Static_assert(__builtin_offsetof(struct objective_entry, difficulty) == 0xf,
+               "objective_entry layout changed: difficulty is no longer at 0xf");
+#endif
+
 
 
