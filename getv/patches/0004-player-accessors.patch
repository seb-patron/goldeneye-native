+
+/* Can a body stand here? The game's own answer, for bots and agents.
+ *
+ * Every navigation attempt so far has been planar: the waypoint graph carries y but routes on
+ * x and z alone, and the follower's obstacle handling is a blind turn-and-hope. That is fine
+ * until a level has stairs, and then it is hopeless -- Bunker 1's spawn is at y=340 and both of
+ * its portals are at y=93, so a bot that only reasons in plan view walks at a doorway through a
+ * floor.
+ *
+ * The engine already knows. sub_GAME_7F0AFB78 is the stan query the spawn placement uses: hand
+ * it a position and a radius and it snaps to the nearest standable tile, ADJUSTING Y to that
+ * tile's height, or returns NULL when there is nothing to stand on. That is exactly the
+ * question local navigation needs, and it costs one call.
+ *
+ * The y it writes back is the useful half. A caller probing ahead gets both "is there floor" and
+ * "at what height", which is what turns a planar walk into one that can find a stairway.
+ *
+ * ⚠️ Standable is not the same as reachable. The tile on the far side of a wall is standable and
+ * a body still cannot walk to it, so this answers "is there floor there", not "can I get there".
+ * Used as a reachability test it will confidently walk into walls -- which is the mistake the
+ * distance-based spawn links made in a different form.
+ */
+int gePortProbeStandable(f32 x, f32 y, f32 z, f32 radius, f32 *out_y, s32 *out_room)
+{
+    f32 px = x, py = y, pz = z;
+    StandTile *tile = sub_GAME_7F0AFB78(&px, &py, &pz, radius);
+
+    if (tile == NULL) {
+        return 0;
+    }
+    if (out_y != NULL)    { *out_y = py; }
+    if (out_room != NULL) { *out_room = (tile->room == 0xff) ? -1 : (s32) tile->room; }
+    return 1;
+}
+
+
+/* Can a body actually WALK from here to there? The engine's own line test.
+ *
+ * 🔴 gePortProbeStandable is not this, and mistaking the two wasted a long pass. That query SNAPS
+ * to the nearest standable tile within its radius rather than testing the point, so it answers
+ * yes almost everywhere -- a floor map of the Bunker 1 spawn came back as 840x840 units of open
+ * floor with no wall anywhere, at a probe radius of 8. Stan is the navigation and height mesh.
+ * IT DOES NOT KNOW ABOUT WALLS. Walls are background geometry, and they are what refuses the
+ * move that stan happily says is standable.
+ *
+ * bondviewTestLineUnobstructed is the test the game itself uses (bondview2.c:2262 for the tank),
+ * and CDTYPE_BG is the term that brings the walls in. Doors and path blockers are included too,
+ * because a bot that routes through a closed door has not found a path either.
+ *
+ * ⚠️ Chrs and players are deliberately NOT included. Another body standing in the way is a
+ * transient, and a route planner that treats it as a wall will re-plan every time a guard walks
+ * past.
+ */
+int gePortProbeWalkable(f32 from_x, f32 from_z, f32 to_x, f32 to_z)
+{
+    /* Declared here rather than by including bondview_internal.h: that header needs a chain of
+     * bondview constants this translation unit does not pull in, and dragging them in for one
+     * prototype trades a build break for a coupling. Signature copied from bondview2.c:2213. */
+    extern s32 bondviewTestLineUnobstructed(StandTile **pTile, f32 p_x, f32 p_z,
+                                            f32 dest_x, f32 dest_z, s32 cdtypes,
+                                            struct coord3d *coord_p, struct coord3d *coord_dest);
+    extern struct player *g_playerPointers[4];
+    StandTile *tile;
+    struct coord3d a, b;
+    f32 y = 0.0f;
+
+    /* 🔑 THE TILE IS AN INPUT, NOT JUST AN OUTPUT, and passing NULL makes every call fail.
+     *
+     * The game's own caller seeds it (bondview2.c:2262 passes a tile it already holds): the walk
+     * starts from a known tile and the test steps outwards from there. With NULL it has nowhere
+     * to start and reports everything obstructed -- a reachability map of the Bunker 1 spawn came
+     * back solid 'x', including cells 60 units away that the player can plainly walk to.
+     *
+     * Seeded from player 0's collision record, falling back to a stan lookup at the start point
+     * for a caller asking about somewhere the player is not standing. */
+    {
+        /* Seed from the START OF THIS LINE, not from wherever player 0 happens to be standing.
+         *
+         * Using the player's tile is right for a bot asking about its own next step and wrong
+         * for everything else -- an edge validator testing two waypoints across the map would
+         * seed every pair from the spawn, and the answers stop being about the pair at all. It
+         * measured 98% of Bunker 1's pairs walkable that way, which is a number about the seed
+         * rather than the level.
+         *
+         * The player's tile is still the fallback, because a caller asking about a point with no
+         * stan under it is usually asking from where the player is. */
+        f32 qx = from_x, qz = from_z;
+        f32 sdx, sdz;
+
+        tile = sub_GAME_7F0AFB78(&qx, &y, &qz, 60.0f);
+
+        /* ⚠️ THE LOOKUP SNAPS, AND A LONG SNAP IS A WRONG ANSWER.
+         *
+         * sub_GAME_7F0AFB78 moves the point it is given to the nearest standable tile, and
+         * "nearest" can be on the FAR SIDE OF A WALL. Seeded from that tile the line test then
+         * starts somewhere the caller never asked about and reports a walk that does not exist:
+         * the Bunker 1 spawn measured a clear 1109-unit line to a portal that a reachability map
+         * drawn from the player's own tile shows is behind a wall.
+         *
+         * If the snap moved the point appreciably, we could not establish where the walk starts,
+         * so refuse. An unmeasurable edge must not be reported as a walkable one -- that is how
+         * an assumption gets laundered into a measurement. */
+        sdx = qx - from_x;
+        sdz = qz - from_z;
+        {
+            /* How far the snap may move the start before the answer stops being about the point
+             * that was asked for. GETV_WALK_SNAP makes it explicit because it is a real accuracy
+             * dial, not a constant, and the three settings measure three different things on
+             * Bunker 1's 2926 pairs:
+             *
+             *   no guard at all   73% walkable  -- includes lines through walls, seeded from a
+             *                                      tile the snap found on the far side
+             *   30 units           4% walkable  -- so strict that almost no pad qualifies, since
+             *                                      waypoints are PAD positions and pads are
+             *                                      frequently not on the stan mesh at all
+             *   60 units (default)              -- the same radius the lookup itself uses
+             *
+             * ⚠️ None of these is ground truth. The only seed known to be correct is the tile a
+             * body is actually standing on, which is why a reachability map drawn from the
+             * player disagrees with all of them. Treat this as a filter that removes obvious
+             * nonsense, not as proof an edge is walkable. */
+            static f32 snap_max = -1.0f;
+            if (snap_max < 0.0f) {
+                const char *e = getenv("GETV_WALK_SNAP");
+                /* DEFAULT OFF. Every tolerance tried rejected every edge on Bunker 1 -- 0 of
+                 * 2926 at 30, 60 and 120 units alike -- which says the snap routinely moves the
+                 * point further than any of them, not that the level is sealed. Shipping it on
+                 * would replace a flawed measurement with an empty one, and an empty one still
+                 * looks like a result. Left available for investigation, and OFF until the snap
+                 * distance itself is understood. */
+                snap_max = (e != NULL && *e != '\0') ? (f32) atof(e) : 0.0f;
+            }
+            if (snap_max > 0.0f && tile != NULL
+                && ((sdx * sdx) + (sdz * sdz)) > (snap_max * snap_max)) {
+                tile = NULL;
+            }
+        }
+
+        if (tile == NULL && g_playerPointers[0] != NULL) {
+            /* Only when the caller is asking from where the player actually stands: that tile is
+             * known-good, and it is the one case a snap cannot improve on. */
+            f32 px = g_playerPointers[0]->field_488.collision_position.f[0];
+            f32 pz = g_playerPointers[0]->field_488.collision_position.f[2];
+            f32 pdx = px - from_x, pdz = pz - from_z;
+            if (((pdx * pdx) + (pdz * pdz)) <= (60.0f * 60.0f)) {
+                tile = g_playerPointers[0]->field_488.current_tile_ptr;
+            }
+        }
+        if (tile == NULL) {
+            return 0;   /* cannot establish a start: not a walk to measure */
+        }
+    }
+
+    a.f[0] = from_x; a.f[1] = 0.0f; a.f[2] = from_z;
+    b.f[0] = to_x;   b.f[1] = 0.0f; b.f[2] = to_z;
+
+    /* 🔑 DOORS ARE NOT WALLS, and including them made a room with two doorways look sealed.
+     *
+     * A reachability map of the Bunker 1 spawn with CDTYPE_DOORS in the mask came back as a
+     * closed corridor 120 units wide and 480 long -- which matched the bot being pinned at
+     * x=-1361 and looked like a convincing explanation, and was wrong. A player walks through a
+     * door by opening it, so for anything asking "can I get there" a door is a passage. Leaving
+     * it in tells a route planner the level is a set of sealed boxes.
+     *
+     * CDTYPE_PATHBLOCKER stays: that is glass and scenery flagged as genuinely impassable, which
+     * is the one thing in this family that really does stop a body. */
+    return bondviewTestLineUnobstructed(&tile, from_x, from_z, to_x, to_z,
+                                        CDTYPE_BG | CDTYPE_PATHBLOCKER,
+                                        &a, &b) != 0;
+}
+
+
+/* Put player 0 on a given spot, for measurement. NOT a gameplay teleport.
+ *
+ * This exists because the walkability line test is seeded from a stan tile and the seed decides
+ * the answer -- 98%, 73% or 0% walkable on the same 2926 Bunker 1 pairs depending only on where
+ * the test started from. The only seed known to be correct is the tile a body is actually
+ * standing on, so the way to measure an edge honestly is to stand at one end of it.
+ *
+ * change_player_pos_to_target is the game's own placement, the one spawn uses, and it takes the
+ * tile explicitly rather than snapping -- so the caller controls which surface the player lands
+ * on instead of the query guessing.
+ *
+ * ⚠️ RETURNS WHERE IT ACTUALLY LANDED, and callers must check. A placement that is clamped or
+ * refused leaves the player at the old position, and a validator that assumes it moved then
+ * seeds every subsequent edge from the wrong place and reports confident, plausible, wrong
+ * verdicts -- while the run completes and prints a percentage. That failure has already happened
+ * twice on this project in other forms.
+ */
+int gePortTeleportProbe(f32 x, f32 y, f32 z, f32 *out_x, f32 *out_y, f32 *out_z)
+{
+    extern struct player *g_playerPointers[4];
+    extern void change_player_pos_to_target(struct collision434 *col, coord3d *pos, StandTile *stan);
+    struct player *p = g_playerPointers[0];
+    StandTile *tile;
+    coord3d target;
+    f32 qx = x, qy = y, qz = z;
+
+    if (p == NULL) { return 0; }
+
+    /* Snap ONCE, deliberately, and keep what it found. The caller wants the surface nearest the
+     * node; what it must not have is a different surface chosen per edge later. */
+    tile = sub_GAME_7F0AFB78(&qx, &qy, &qz, 60.0f);
+    if (tile == NULL) { return 0; }
+
+    target.f[0] = qx;
+    target.f[1] = qy;
+    target.f[2] = qz;
+    change_player_pos_to_target(&p->field_488, &target, tile);
+
+    if (p->prop != NULL) {
+        p->prop->pos.x = qx;
+        p->prop->pos.y = qy;
+        p->prop->pos.z = qz;
+    }
+
+    if (out_x != NULL) { *out_x = p->field_488.collision_position.f[0]; }
+    if (out_y != NULL) { *out_y = p->field_488.collision_position.f[1]; }
+    if (out_z != NULL) { *out_z = p->field_488.collision_position.f[2]; }
+    return 1;
+}
+
+
+/* WHAT is in the way, not merely whether something is. The sensing primitive.
+ *
+ * gePortProbeWalkable answers yes or no, and a bot that only knows "blocked" behaves the same
+ * way at a wall, a crate and a closed door -- when the right response to each is completely
+ * different: turn, shoot or step around, press the action button. Every obstacle recovery
+ * written so far has been a guess for exactly this reason.
+ *
+ * bondviewTestLineUnobstructed takes a collision-type mask, so asking it once per category tells
+ * the caller what kind of thing stopped the line. Four calls, and the answer is a bitmask rather
+ * than a verdict, so a caller can decide which categories it cares about instead of accepting
+ * ours -- a door is an obstacle to a route planner and an opportunity to a bot with a hand.
+ *
+ * Returns GE_SENSE_CLEAR (0) when nothing blocks.
+ *
+ * ⚠️ Seeded from the tile under `from`, so it inherits the seeding rule the edge validator
+ * learned the hard way: this is honest when asked from where a body is standing and guesswork
+ * when asked about a point nobody is at.
+ */
+int gePortSenseLine(f32 from_x, f32 from_z, f32 to_x, f32 to_z)
+{
+    extern struct player *g_playerPointers[4];
+    extern s32 bondviewTestLineUnobstructed(StandTile **pTile, f32 p_x, f32 p_z,
+                                            f32 dest_x, f32 dest_z, s32 cdtypes,
+                                            struct coord3d *coord_p, struct coord3d *coord_dest);
+    static const s32 kinds[4] = {
+        CDTYPE_BG,                                   /* 1: level geometry -- turn or go around */
+        CDTYPE_DOORS,                                /* 2: openable -- press the action button */
+        CDTYPE_OBJS | CDTYPE_PATHBLOCKER,            /* 4: crates and scenery -- shoot or skirt */
+        CDTYPE_CHRS | CDTYPE_PLAYERS                 /* 8: a body -- wait, or shoot it */
+    };
+    StandTile *seed;
+    coord3d a, b;
+    f32 qx = from_x, qy = 0.0f, qz = from_z;
+    s32 result = 0;
+    s32 i;
+
+    seed = sub_GAME_7F0AFB78(&qx, &qy, &qz, 60.0f);
+    if (seed == NULL && g_playerPointers[0] != NULL) {
+        seed = g_playerPointers[0]->field_488.current_tile_ptr;
+    }
+    if (seed == NULL) { return 0; }
+
+    a.f[0] = from_x; a.f[1] = 0.0f; a.f[2] = from_z;
+    b.f[0] = to_x;   b.f[1] = 0.0f; b.f[2] = to_z;
+
+    for (i = 0; i < 4; i++) {
+        StandTile *t = seed;
+        if (bondviewTestLineUnobstructed(&t, from_x, from_z, to_x, to_z, kinds[i], &a, &b) == 0) {
+            result |= (1 << i);
+        }
+    }
+    return result;
+}
+
+/* Can this character see the player? The AI's own question, asked from the character.
+ *
+ * Sight in this engine is a clear line plus a facing cone; the line is what the AI opcodes
+ * ultimately reduce to. Characters and players are excluded from the mask deliberately -- another
+ * guard standing between them does not make the player unseen, it makes the shot awkward.
+ *
+ * ⚠️ This is line of sight, NOT whether the guard is currently looking. Alertness and
+ * lastseetarget60 from the enemy API answer that, and conflating the two produces a bot that
+ * hides from a guard facing the other way and strolls past one that is staring at it.
+ */
+int gePortSenseVisibleTo(s32 chr_index, s32 player_index)
+{
+    extern ChrRecord *g_ChrSlots;
+    extern s32 g_NumChrSlots;
+    extern struct player *g_playerPointers[4];
+    ChrRecord *chr;
+    struct player *p;
+
+    if (chr_index < 0 || chr_index >= (s32) g_NumChrSlots) { return 0; }
+    if (player_index < 0 || player_index > 3) { return 0; }
+
+    chr = &g_ChrSlots[chr_index];
+    p = g_playerPointers[player_index];
+    if (chr->model == NULL || chr->prop == NULL || p == NULL || p->prop == NULL) { return 0; }
+
+    return (gePortSenseLine(chr->prop->pos.x, chr->prop->pos.z,
+                            p->prop->pos.x, p->prop->pos.z)
+            & (1 | 4)) == 0;   /* geometry and solid props block sight; doors and bodies do not */
+}
+
+
+/* Which way a character is FACING, so line of sight can become attention.
+ *
+ * geSenseVisibleTo answers whether the line is clear, and a guard facing away has a clear line
+ * and is not looking. Without this a bot hides from a guard staring at the far wall and walks
+ * past one watching the door. Degrees, atan2(x, z), matching every other angle in these APIs.
+ */
+int gePortEnemyFacing(s32 chr_index, f32 *out_deg)
+{
+    extern ChrRecord *g_ChrSlots;
+    extern s32 g_NumChrSlots;
+    ChrRecord *chr;
+
+    if (out_deg == NULL || chr_index < 0 || chr_index >= (s32) g_NumChrSlots) { return 0; }
+    chr = &g_ChrSlots[chr_index];
+    if (chr->model == NULL || chr->prop == NULL) { return 0; }
+
+    /* ⚠️ REFUSES, and deliberately. ChrRecord exposes no facing field I have been able to find:
+     * the visible rotation is built per frame in chr.c's draw path from aimsideback and the
+     * animation, and none of it is stored anywhere a caller can read.
+     *
+     * Returning 0 rather than a plausible number is the whole point. geSenseNoticedBy checks
+     * this return and falls back to line of sight, so a bot gets the honest answer -- "I can be
+     * seen if it is looking" -- instead of a facing derived from something that is not facing.
+     * A wrong cone is worse than no cone: it produces confident stealth decisions that are
+     * exactly backwards, and nothing downstream could tell.
+     *
+     * FINDING THE REAL FIELD IS A QUEUE ITEM. chr.c:2319 reads chr->aimsideback into a yrot when
+     * building the model matrix, which is where the answer probably starts. */
+    (void) chr;
+    (void) out_deg;
+    return 0;
+}
+
+/* HOW BIG a prop is, not just where it is.
+ *
+ * Everything the navigation layer has reported so far has been a POINT. A crate reported as "278
+ * away" is 278 to its CENTRE, and a bot that stops when the point is still ahead has already
+ * walked into the corner of it -- which is exactly how the CLI player got trapped on Train while
+ * the report insisted there was room.
+ *
+ * The engine knows the answer: every object carries a model bounding box, and chrai.h exposes the
+ * accessors the AI uses to reason about it. This returns the horizontal half-extents and a radius,
+ * so a caller can subtract the thing's own size before deciding it has room to pass.
+ *
+ * ⚠️ Returns the MODEL box, unrotated. A long crate turned forty-five degrees occupies more
+ * width than its half-extent suggests, and the radius is the honest figure to steer by until
+ * someone needs the oriented box. Reporting both lets the caller choose which lie to accept.
+ */
+int gePortPropExtent(void *prop_ptr, f32 *out_hx, f32 *out_hz, f32 *out_radius)
+{
+    extern struct ModelRoData_BoundingBoxRecord *chrobjGetBboxFromObjectRecord(ObjectRecord *);
+    extern f32 chrpropBBOXGetXmin(struct ModelRoData_BoundingBoxRecord *);
+    extern f32 chrpropBBOXGetZmin(struct ModelRoData_BoundingBoxRecord *);
+    PropRecord *pr = (PropRecord *) prop_ptr;
+    struct ModelRoData_BoundingBoxRecord *bb;
+    f32 hx, hz;
+
+    if (pr == NULL || pr->obj == NULL) { return 0; }
+    bb = chrobjGetBboxFromObjectRecord(pr->obj);
+    if (bb == NULL) { return 0; }
+
+    /* The mins are negative offsets from the model origin, so their magnitude is the half-extent
+     * on that axis. Using the min alone assumes a centred model, which every crate in this game
+     * is; an off-centre one would report a radius that is too small on one side, and that is a
+     * reason to prefer the radius over the half-extents rather than to guess a correction. */
+    hx = chrpropBBOXGetXmin(bb);
+    hz = chrpropBBOXGetZmin(bb);
+    if (hx < 0.0f) { hx = -hx; }
+    if (hz < 0.0f) { hz = -hz; }
+
+    if (out_hx != NULL)     { *out_hx = hx; }
+    if (out_hz != NULL)     { *out_hz = hz; }
+    if (out_radius != NULL) { *out_radius = (f32) sqrt((double) ((hx * hx) + (hz * hz))); }
+    return 1;
+}
+
+
+/* Has an objective been DONE? The question nothing could answer until now.
+ *
+ * Every measurement on this project has been about getting somewhere. None of it could tell
+ * success from arrival, so a bot could not know it had finished and neither could a test -- and
+ * "the bot reached the brake unit" is a different claim from "the bot destroyed it".
+ *
+ * 0 incomplete, 1 complete, 2 failed, matching OBJECTIVESTATUS. Returns 0 rather than a status
+ * for an index the level does not have, so a caller cannot mistake "no such objective" for
+ * "not done yet" -- they mean opposite things to anything deciding whether to keep playing.
+ *
+ * ⚠️ get_status_of_objective RECOMPUTES rather than reading a cached flag, so this is a real
+ * evaluation each call and not free. Once a second is plenty; per frame is waste.
+ */
+int gePortObjectiveStatus(s32 index, s32 *out_status)
+{
+    extern s32 objective_count;
+    extern OBJECTIVESTATUS get_status_of_objective(s32 objectiveNum);
+
+    if (out_status == NULL || index < 0 || index > objective_count) { return 0; }
+    *out_status = (s32) get_status_of_objective(index);
+    return 1;
+}
+
+int gePortObjectiveCount(void)
+{
+    extern s32 objective_count;
+
+    /* objective_count is the last INDEX, not a count -- the game's own loops run i <= count
+     * (objective_status.c:505). Returning it unadjusted would make every caller miss the final
+     * objective, which on most levels is the one that ends the mission. */
+    return (s32) objective_count + 1;
+}
+
+
+int gePortPlayerScore(int idx, s32 *out_kills, s32 *out_deaths, s32 *out_shots)
+{
+    extern struct player_data g_playerPlayerData[4];
+    extern struct player *g_playerPointers[4];
+    s32 j;
+
+    if (idx < 0 || idx > 3 || g_playerPointers[idx] == NULL) { return 0; }
+
+    if (out_kills != NULL)  { *out_kills = g_playerPlayerData[idx].kill_count; }
+    if (out_shots != NULL)  { *out_shots = g_playerPlayerData[idx].shot_count[SHOT_REGISTER_TOTAL]; }
+    if (out_deaths != NULL) {
+        s32 deaths = 0;
+        for (j = 0; j < 4; j++) { deaths += g_playerPlayerData[j].kill_counts[idx]; }
+        *out_deaths = deaths;
+    }
+    return 1;
+}
+
+
+/* Live enemy state, for getv/port/src/ge_enemy_api.c. See docs/ENEMY_API.md.
+ *
+ * Here for the same reason gePortPlayerPos is: ChrRecord is a game type, the port layer is
+ * compiled without the decomp's include path, and any port-side copy of a field offset would be
+ * wrong now or wrong later.
+ *
+ * A FLAT FLOAT ARRAY rather than a shared struct, matching gePortPlayerPos. A struct would need a
+ * header both sides include, which is precisely the coupling this shape avoids.
+ */
+int gePortEnemyCount(void)
+{
+    extern s32 g_NumChrSlots;
+    return (int) g_NumChrSlots;
+}
+
+int gePortEnemyAt(int index, f32 *out, int count)
+{
+    extern ChrRecord *g_ChrSlots;
+    extern s32 g_NumChrSlots;
+    ChrRecord *chr;
+
+    if (out == NULL || index < 0 || index >= (int) g_NumChrSlots) {
+        return 0;
+    }
+    /* REFUSE rather than write what fits. The caller passes its array length so that adding a
+     * field here can never silently shift every reader by one slot -- a failure that is quiet and
+     * total, since every field would then read as its neighbour and nothing would error. */
+    if (count < 14) {
+        return 0;
+    }
+
+    chr = &g_ChrSlots[index];
+    if (chr->model == NULL) {
+        return 0;   /* free slot: chr.c:1775 counts these by model == 0 */
+    }
+    if (chr->prop == NULL) {
+        return 0;   /* no prop, no position, and everything below would be a null deref */
+    }
+
+    out[0]  = chr->prop->pos.x;
+    out[1]  = chr->prop->pos.y;
+    out[2]  = chr->prop->pos.z;
+
+    /* Damage TAKEN and the threshold to die, not health remaining. The port inverts it at the
+     * boundary so no caller has to remember which way round it is; getting that backwards reads a
+     * dying guard as a healthy one. */
+    out[3]  = chr->damage;
+    out[4]  = chr->maxdamage;
+
+    out[5]  = (f32) chr->alertness;
+    out[6]  = chr->hearingscale;
+
+    /* Where this character believes its target is, and how stale that belief is. The gap between
+     * this and where the player actually stands is the whole basis for deciding to break contact
+     * -- see docs/ENEMY_API.md. */
+    out[7]  = chr->lastknowntargetpos.x;
+    out[8]  = chr->lastknowntargetpos.y;
+    out[9]  = chr->lastknowntargetpos.z;
+    out[10] = (f32) chr->lastseetarget60;
+    out[11] = (f32) chr->lastheartarget60;
+
+    out[12] = (f32) chr->chrnum;
+    out[13] = (chr->actiontype != ACT_DEAD) ? 1.0f : 0.0f;
+
+    /* A MASK of what was filled, not a bool. A build that could reach position but not alertness
+     * should say so, rather than letting a bot read every guard as oblivious.
+     *
+     * 🔑 BELIEF IS CONDITIONAL, AND THAT IS THE POINT OF THE MASK.
+     *
+     * lastknowntargetpos is (0,0,0) on a guard that has never seen or heard anyone, and zero is a
+     * REAL COORDINATE -- it is a corner of the level. Reporting it as a belief makes every
+     * unalerted guard on the map appear to be heading for the origin, and geEnemyThreatAt counts
+     * them all. Measured on Train: waypoint 0 came back "contested by 40" out of roughly 40
+     * guards, on a level where nobody had seen the player yet, and the follower spent its whole
+     * run in 180-frame holds instead of walking.
+     *
+     * lastseetarget60 and lastheartarget60 are when the guard last saw or heard the target. Both
+     * zero means it never has, so there is no belief to report and the flag stays clear. A caller
+     * checking GE_EN_BELIEF then gets the honest answer rather than a coordinate that happens to
+     * exist. */
+    {
+        s32 mask = 1 | 2 | 4;
+
+        if (chr->lastseetarget60 != 0 || chr->lastheartarget60 != 0) {
+            mask |= 8;
+        }
+        return mask;
+    }
+}
+
+
+void gePortStateDump(int frame)
+{
+    s32 i;
+    s32 n = getPlayerCount();
+
+    /* Why the co-op players do not move, if they do not.
+     *
+     * lvlManageMpGame() (lv.c:1098) sets g_ClockTimer to 0 whenever controls are locked or
+     * the game is paused, and to speedgraphframes otherwise. A zero clock means zero delta,
+     * and zero delta freezes every player including player 0 while rendering carries on
+     * normally -- which is exactly the reported symptom: p0 travels 72.5 units in co-op
+     * against 16930 solo, and separating the spawns (GETV_COOP_SPREAD) did not change it.
+     *
+     * Printed rather than assumed, because the alternative explanations -- no input reaching
+     * players 1-3, spawn collision, missing pads -- have already been ruled out one at a
+     * time and this is the next candidate rather than a conclusion. */
+    {
+        extern s32 g_ControlsLockedFlag;
+        extern s32 g_ClockTimer;
+        extern s32 checkGamePaused(void);
+        printf("[getv][state] locked=%d paused=%d clock=%d",
+               (int) g_ControlsLockedFlag, (int) checkGamePaused(), (int) g_ClockTimer);
+    }
+    printf("[getv][state] f=%d players=%d", frame, (int) n);
+
+    /* Every player, not g_CurrentPlayer. That pointer is swapped as each viewport is drawn,
+     * so in split screen it names whichever player was rendered last -- reading it made
+     * co-op look motionless when the truth was that consecutive samples described different
+     * players. g_playerPointers is the stable array. */
+    {
+        extern struct player *g_playerPointers[4];
+        s32 p;
+        for (p = 0; p < 4; p++) {
+            if (g_playerPointers[p] == NULL) {
+                continue;
+            }
+            printf(" p%d=%.1f,%.1f,%.1f", (int) p,
+                   (double) g_playerPointers[p]->pos.x,
+                   (double) g_playerPointers[p]->pos.y,
+                   (double) g_playerPointers[p]->pos.z);
+        }
+    }
+    printf(" objectives=%d status=", (int) objective_count);
+    if (objective_count <= 0) {
+        printf("-");
+    } else {
+        for (i = 0; i < objective_count && i < OBJECTIVES_MAX; i++) {
+            printf("%d", (int) objectiveStatuses[i]);
+        }
+    }
+    printf(" complete=%d\n", objectiveIsAllComplete() ? 1 : 0);
+    fflush(stdout);
+}
+#endif
