+extern char *getenv(const char *);
+extern s32 objectiveregisters1;
+
+s32 g_geObjDbgEvals;
+
+s32 ge_obj_dbg(void)
+{
+    static s32 cached = -1;
+    if (cached < 0) { const char *e = getenv("GETV_OBJ_DEBUG"); cached = (e && *e == '1'); }
