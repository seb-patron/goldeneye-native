+#ifdef GE_PORT_NATIVE
+/* Death causes can be delayed by ACT_PREARGH and scripted deaths have no weapon call site at
+ * all. Observe each slot once after propsTick, when actiontype is authoritative, and combine it
+ * with the most recent hit context recorded at the real damage path. */
+static void gePortGibsDeathTick(void)
+{
+    s32 i;
+
+    if (gePortGibsMode() == 0) {
+        return;
+    }
+
+    for (i = 0; i < g_NumChrSlots && i < GE_HORDE_MARKS; i++) {
+        ChrRecord *chr = &g_ChrSlots[i];
+        s32 dying;
+
+        if (chr->model == NULL || chr->prop == NULL || chr->prop->type != PROP_TYPE_CHR) {
+            ge_gib_dead_mark[i] = 0;
+            continue;
+        }
+
+        dying = chr->actiontype == ACT_DIE || chr->actiontype == ACT_DEAD;
+        if (!dying) {
+            ge_gib_dead_mark[i] = 0;
+            continue;
+        }
+        if (ge_gib_dead_mark[i]) {
+            continue;
+        }
+        ge_gib_dead_mark[i] = 1;
+
+        {
+            s32 cause = 0;
+            f32 damage = 0.0f;
+            coord3d impulse = chr->fallspeed;
+
+            gePortGibsGetLastHit(chr, &cause, &damage,
+                                 &impulse.f[0], &impulse.f[1], &impulse.f[2]);
+            if (gePortGibsShouldSpawn(cause, 1, damage)) {
+                gePortGibCharacterDeath(chr, &impulse);
+            }
+        }
+    }
+}
+
+/* A fatal explosion is awkward to aim at a guard reproducibly in a headless run. This gate
+ * drives the real explosion-death function against the first eligible guard once, then reports
+ * both halves of the visible contract: the intact model is transparent and twelve marked chunks
+ * entered the renderer's bounded particle pool. It is inert unless explicitly requested. */
+static void gePortGibsSelftestTick(void)
+{
+    static s32 tick;
+    static s32 at = -2;
+
+    if (at == -2) {
+        const char *value = getenv("GETV_GIBS_SELFTEST");
+        at = (value != NULL && *value != '\0') ? atoi(value) : -1;
+    }
+    tick++;
+    if (at <= 0 || tick != at) {
+        return;
+    }
+
+    {
+        s32 i;
+        for (i = 0; i < g_NumChrSlots; i++) {
+            ChrRecord *chr = &g_ChrSlots[i];
+            if (chr->model != NULL && chr->prop != NULL && chr->prop->stan != NULL &&
+                chr->actiontype != ACT_DIE && chr->actiontype != ACT_DEAD &&
+                chr->prop->type == PROP_TYPE_CHR) {
+                coord3d source = chr->prop->pos;
+                s32 killed;
+
+                source.f[0] -= 1.0f;
+                killed = chrlvExplosionDamage(chr, &source, 4.0f, 0);
+                if (killed) {
+                    gePortGibsRecordHit(chr, 1, 4.0f,
+                                        chr->fallspeed.f[0], chr->fallspeed.f[1],
+                                        chr->fallspeed.f[2]);
+                    if (gePortGibsShouldSpawn(1, 1, 4.0f)) {
+                        gePortGibCharacterDeath(chr, &chr->fallspeed);
+                    }
+                }
+                printf("[getv][gibs] selftest: slot %d killed=%d alpha=%u chunks=%d\n",
+                       i, killed, (u32)chr->fadealpha, explosionCountGibParticles());
+                return;
+            }
+        }
+    }
+
+    printf("[getv][gibs] selftest: no eligible guard among %d slots at tick %d\n",
+           (s32)g_NumChrSlots, at);
+}
