+#ifdef GE_PORT_NATIVE
+/* The first gib pass deliberately reuses the engine's short-lived shrapnel pool. It gives the
+ * effect rotation, gravity, a fixed memory ceiling and both renderers for free, while the marker
+ * in unk34 keeps its state distinguishable for the headless integration check. See docs/GIBS.md
+ * for the boundary where persistent colliding body parts should become their own prop type. */
+void explosionInitGibParticles(coord3d *spawnpos, coord3d *blastvel, s32 count, u32 seed)
+{
+    s32 i;
+
+    if (g_FlyingParticlesBuffer == NULL || max_particles <= 0 || count <= 0) {
+        return;
+    }
+
+    seed ^= 0x9e3779b9U;
+    if (seed == 0) {
+        seed = 1;
+    }
+
+    for (i = 0; i < count; i++) {
+        struct FlyingParticles *particle = &g_FlyingParticlesBuffer[g_NumParticleEntries];
+        f32 rx = geGibRandUnit(&seed) * 2.0f - 1.0f;
+        f32 ry = geGibRandUnit(&seed);
+        f32 rz = geGibRandUnit(&seed) * 2.0f - 1.0f;
+        f32 size = 9.0f + geGibRandUnit(&seed) * 7.0f;
+        s16 texs = (s16)((geGibRand(&seed) & 3U) << 8);
+        s16 text = (s16)((geGibRand(&seed) & 3U) << 8);
+        s32 v;
+
+        particle->unk00 = 1;
+        particle->unk34 = GE_FLYING_PARTICLE_GIB;
+        particle->position.f[0] = spawnpos->f[0] + rx * 28.0f;
+        particle->position.f[1] = spawnpos->f[1] + ry * 55.0f;
+        particle->position.f[2] = spawnpos->f[2] + rz * 28.0f;
+
+        particle->position_drift.f[0] = rx * 2.8f + blastvel->f[0] * 0.35f;
+        particle->position_drift.f[1] = 5.5f + ry * 5.5f + blastvel->f[1] * 0.20f;
+        particle->position_drift.f[2] = rz * 2.8f + blastvel->f[2] * 0.35f;
+
+        particle->vertex_list[0].v.ob[0] = (s16)size;
+        particle->vertex_list[0].v.ob[1] = 0;
+        particle->vertex_list[0].v.ob[2] = (s16)(size * 0.75f);
+        particle->vertex_list[1].v.ob[0] = (s16)(size * 0.65f);
+        particle->vertex_list[1].v.ob[1] = 0;
+        particle->vertex_list[1].v.ob[2] = (s16)-size;
+        particle->vertex_list[2].v.ob[0] = (s16)-size;
+        particle->vertex_list[2].v.ob[1] = 0;
+        particle->vertex_list[2].v.ob[2] = (s16)(size * -0.70f);
+        particle->vertex_list[3].v.ob[0] = (s16)(size * -0.70f);
+        particle->vertex_list[3].v.ob[1] = 0;
+        particle->vertex_list[3].v.ob[2] = (s16)size;
+
+        particle->vertex_list[0].v.tc[0] = texs + 0xe0;
+        particle->vertex_list[0].v.tc[1] = text + 0xe0;
+        particle->vertex_list[1].v.tc[0] = texs + 0xe0;
+        particle->vertex_list[1].v.tc[1] = text;
+        particle->vertex_list[2].v.tc[0] = texs;
+        particle->vertex_list[2].v.tc[1] = text;
+        particle->vertex_list[3].v.tc[0] = texs;
+        particle->vertex_list[3].v.tc[1] = text + 0xe0;
+
+        for (v = 0; v < 4; v++) {
+            u8 shade = (u8)(geGibRand(&seed) & 0x1fU);
+            particle->vertex_list[v].v.cn[0] = (u8)(0x70 + shade);
+            particle->vertex_list[v].v.cn[1] = (u8)(shade >> 2);
+            particle->vertex_list[v].v.cn[2] = (u8)(shade >> 3);
+            particle->vertex_list[v].v.cn[3] = 0xdc;
+        }
+
+        particle->rotation.f[0] = geGibRandUnit(&seed) * M_TAU_F;
+        particle->rotation.f[1] = geGibRandUnit(&seed) * M_TAU_F;
+        particle->rotation.f[2] = geGibRandUnit(&seed) * M_TAU_F;
+        particle->rotation_drift.f[0] = (geGibRandUnit(&seed) - 0.5f) * 0.20f;
+        particle->rotation_drift.f[1] = (geGibRandUnit(&seed) - 0.5f) * 0.20f;
+        particle->rotation_drift.f[2] = (geGibRandUnit(&seed) - 0.5f) * 0.20f;
+
+        g_NumParticleEntries++;
+        if (g_NumParticleEntries >= max_particles) {
+            g_NumParticleEntries = 0;
+        }
+    }
+}
