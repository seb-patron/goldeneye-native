+#ifdef GE_PORT_NATIVE
+/* A fatal explosion is awkward to aim at a guard reproducibly in a headless run. This gate
+ * drives the real explosion-death function against the first eligible guard once, then reports
+ * both halves of the visible contract: the intact model is transparent and eight marked chunks
+ * entered the renderer's bounded particle pool. It is inert unless explicitly requested. */
+static void gePortGibsSelftestTick(void)
+{
+    static s32 tick;
+    static s32 at = -2;
+
+    if (at == -2) {
+        const char *value = getenv("GETV_GIBS_SELFTEST");
+        at = (value != NULL && *value != '\0') ? atoi(value) : -1;
+    }
+    tick++;
+    if (at <= 0 || tick != at) {
+        return;
+    }
+
+    {
+        s32 i;
+        for (i = 0; i < g_NumChrSlots; i++) {
+            ChrRecord *chr = &g_ChrSlots[i];
+            if (chr->model != NULL && chr->prop != NULL && chr->prop->stan != NULL &&
+                chr->actiontype != ACT_DIE && chr->actiontype != ACT_DEAD &&
+                chr->prop->type == PROP_TYPE_CHR) {
+                coord3d source = chr->prop->pos;
+                s32 killed;
+
+                source.f[0] -= 1.0f;
+                killed = chrlvExplosionDamage(chr, &source, 4.0f, 0);
+                if (killed) {
+                    gePortGibExplosionDeath(chr);
+                }
+                printf("[getv][gibs] selftest: slot %d killed=%d alpha=%u chunks=%d\n",
+                       i, killed, (u32)chr->fadealpha, explosionCountGibParticles());
+                return;
+            }
+        }
+    }
+
+    printf("[getv][gibs] selftest: no eligible guard among %d slots at tick %d\n",
+           (s32)g_NumChrSlots, at);
+}
+#endif
