+struct GeGibPhysics {
+    StandTile *stan;
+    f32 floor_offset;
+    s32 settled_at;
+    u8 settled;
+    u8 bounces;
+};
+
+static struct GeGibPhysics ge_gib_physics[MAX_FLYING_PARTICLES];
+static s32 ge_gib_selftest_age = -1;
+
+/* Cosmetic randomness must not advance randomGetNext(). That generator also drives gameplay,
+ * so spending extra draws on an optional effect would change later AI decisions and could
+ * desynchronise a lockstep session whose peers chose different visual settings. */
+static u32 geGibRand(u32 *state)
+{
+    u32 x = *state;
+    x ^= x << 13;
+    x ^= x >> 17;
+    x ^= x << 5;
+    *state = x;
+    return x;
+}
+
+static f32 geGibRandUnit(u32 *state)
+{
+    return (f32)(geGibRand(state) & 0xffffU) * (1.0f / 65535.0f);
+}
+
+static s32 geGibIsActive(s32 index)
+{
+    return g_FlyingParticlesBuffer[index].unk00 > 0
+        && g_FlyingParticlesBuffer[index].unk34 == GE_FLYING_PARTICLE_GIB;
+}
+
+static s32 geGibEffectiveCap(void)
+{
+    s32 cap = max_particles - GE_GIB_RETAIL_RESERVE;
+
+    if (cap < 1) {
+        cap = max_particles / 2;
+    }
+    if (cap > GE_GIB_ACTIVE_CAP) {
+        cap = GE_GIB_ACTIVE_CAP;
+    }
+    return cap > 0 ? cap : 1;
+}
+
+/* Retail debris still uses its circular allocation order, but cannot erase a persistent gib.
+ * The gib cap always leaves a slice of the pool available, so this scan terminates quickly. */
+static void geSelectRetailParticleSlot(void)
+{
+    s32 offset;
+
+    for (offset = 0; offset < max_particles; offset++) {
+        s32 index = (g_NumParticleEntries + offset) % max_particles;
+        if (!geGibIsActive(index)) {
+            g_NumParticleEntries = index;
+            ge_gib_physics[index].stan = NULL;
+            ge_gib_physics[index].settled = 0;
+            ge_gib_physics[index].settled_at = 0;
+            ge_gib_physics[index].bounces = 0;
+            return;
+        }
+    }
+}
+
+static s32 geSelectGibParticleSlot(void)
+{
+    s32 active = 0;
+    s32 inactive = -1;
+    s32 retail = -1;
+    s32 oldest = -1;
+    s32 oldest_settled = -1;
+    s32 oldest_age = -1;
+    s32 oldest_settled_age = -1;
+    s32 offset;
+
+    for (offset = 0; offset < max_particles; offset++) {
+        s32 index = (g_NumParticleEntries + offset) % max_particles;
+        struct FlyingParticles *particle = &g_FlyingParticlesBuffer[index];
+
+        if (geGibIsActive(index)) {
+            active++;
+            if (particle->unk00 > oldest_age) {
+                oldest = index;
+                oldest_age = particle->unk00;
+            }
+            if (ge_gib_physics[index].settled && particle->unk00 > oldest_settled_age) {
+                oldest_settled = index;
+                oldest_settled_age = particle->unk00;
+            }
+        } else if (particle->unk00 <= 0 && inactive < 0) {
+            inactive = index;
+        } else if (retail < 0) {
+            retail = index;
+        }
+    }
+
+    if (active >= geGibEffectiveCap()) {
+        return oldest_settled >= 0 ? oldest_settled : oldest;
+    }
+    if (inactive >= 0) {
+        return inactive;
+    }
+    if (retail >= 0) {
+        return retail;
+    }
+    return oldest >= 0 ? oldest : 0;
+}
