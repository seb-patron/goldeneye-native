+#ifdef GE_PORT_NATIVE
+/* One Quake-like visual is shared by every policy: irregular solid chunks with strong launch
+ * velocity, wall/floor response, several bounces, then a long-lived settled state. The chunks
+ * remain cosmetic and use a bounded sidecar instead of consuming gameplay prop slots. */
+void explosionInitGibParticles(coord3d *spawnpos, coord3d *blastvel, StandTile *stan,
+                               s32 count, u32 seed)
+{
+    f32 blastlen;
+    f32 blastx = 0.0f;
+    f32 blasty = 0.0f;
+    f32 blastz = 0.0f;
+    s32 i;
+
+    if (g_FlyingParticlesBuffer == NULL || max_particles <= 0 || count <= 0) {
+        return;
+    }
+
+    if (getenv("GETV_GIBS_SELFTEST") != NULL && ge_gib_selftest_age == -1) {
+        ge_gib_selftest_age = 0;
+    }
+
+    blastlen = sqrtf(blastvel->f[0] * blastvel->f[0]
+                   + blastvel->f[1] * blastvel->f[1]
+                   + blastvel->f[2] * blastvel->f[2]);
+    if (blastlen > 0.01f) {
+        blastx = blastvel->f[0] / blastlen;
+        blasty = blastvel->f[1] / blastlen;
+        blastz = blastvel->f[2] / blastlen;
+    }
+
+    seed ^= 0x9e3779b9U;
+    if (seed == 0) {
+        seed = 1;
+    }
+
+    for (i = 0; i < count; i++) {
+        s32 index = geSelectGibParticleSlot();
+        struct FlyingParticles *particle = &g_FlyingParticlesBuffer[index];
+        struct GeGibPhysics *physics = &ge_gib_physics[index];
+        f32 rx = geGibRandUnit(&seed) * 2.0f - 1.0f;
+        f32 ry = geGibRandUnit(&seed);
+        f32 rz = geGibRandUnit(&seed) * 2.0f - 1.0f;
+        f32 size = i < 4
+            ? 24.0f + geGibRandUnit(&seed) * 10.0f
+            : 14.0f + geGibRandUnit(&seed) * 9.0f;
+        s16 texs = (s16)((geGibRand(&seed) & 3U) << 8);
+        s16 text = (s16)((geGibRand(&seed) & 3U) << 8);
+        s32 v;
+
+        particle->unk00 = 1;
+        particle->unk34 = GE_FLYING_PARTICLE_GIB;
+        particle->position.f[0] = spawnpos->f[0] + rx * 24.0f;
+        particle->position.f[1] = spawnpos->f[1] + 12.0f + ry * 48.0f;
+        particle->position.f[2] = spawnpos->f[2] + rz * 24.0f;
+
+        particle->position_drift.f[0] = rx * 5.8f + blastx * 3.5f;
+        particle->position_drift.f[1] = 7.0f + ry * 6.0f + blasty * 2.0f;
+        particle->position_drift.f[2] = rz * 5.8f + blastz * 3.5f;
+
+        particle->vertex_list[0].v.ob[0] = 0;
+        particle->vertex_list[0].v.ob[1] = (s16)size;
+        particle->vertex_list[0].v.ob[2] = 0;
+        particle->vertex_list[1].v.ob[0] = (s16)(size * -1.0f);
+        particle->vertex_list[1].v.ob[1] = (s16)(size * -0.4f);
+        particle->vertex_list[1].v.ob[2] = (s16)(size * -0.7f);
+        particle->vertex_list[2].v.ob[0] = (s16)(size * 0.8f);
+        particle->vertex_list[2].v.ob[1] = (s16)(size * -0.4f);
+        particle->vertex_list[2].v.ob[2] = (s16)(size * -0.5f);
+        particle->vertex_list[3].v.ob[0] = 0;
+        particle->vertex_list[3].v.ob[1] = (s16)(size * -0.4f);
+        particle->vertex_list[3].v.ob[2] = (s16)size;
+
+        particle->vertex_list[0].v.tc[0] = texs + 0xe0;
+        particle->vertex_list[0].v.tc[1] = text + 0xe0;
+        particle->vertex_list[1].v.tc[0] = texs + 0xe0;
+        particle->vertex_list[1].v.tc[1] = text;
+        particle->vertex_list[2].v.tc[0] = texs;
+        particle->vertex_list[2].v.tc[1] = text;
+        particle->vertex_list[3].v.tc[0] = texs;
+        particle->vertex_list[3].v.tc[1] = text + 0xe0;
+
+        for (v = 0; v < 4; v++) {
+            u8 shade = (u8)(geGibRand(&seed) & 0x1fU);
+            particle->vertex_list[v].v.cn[0] = (u8)(0xa0 + shade);
+            particle->vertex_list[v].v.cn[1] = (u8)(0x10 + (shade >> 1));
+            particle->vertex_list[v].v.cn[2] = (u8)(0x08 + (shade >> 2));
+            particle->vertex_list[v].v.cn[3] = 0xff;
+        }
+
+        particle->rotation.f[0] = geGibRandUnit(&seed) * M_TAU_F;
+        particle->rotation.f[1] = geGibRandUnit(&seed) * M_TAU_F;
+        particle->rotation.f[2] = geGibRandUnit(&seed) * M_TAU_F;
+        particle->rotation_drift.f[0] = (geGibRandUnit(&seed) - 0.5f) * 0.20f;
+        particle->rotation_drift.f[1] = (geGibRandUnit(&seed) - 0.5f) * 0.20f;
+        particle->rotation_drift.f[2] = (geGibRandUnit(&seed) - 0.5f) * 0.20f;
+
+        physics->stan = stan;
+        physics->floor_offset = size * 0.4f;
+        physics->settled_at = 0;
+        physics->settled = 0;
+        physics->bounces = 0;
+        if (physics->stan == NULL) {
+            f32 floory;
+            physics->stan = stanFindTileBelowPos(&particle->position, NULL, &floory);
+        }
+
+        g_NumParticleEntries = index + 1;
+        if (g_NumParticleEntries >= max_particles) {
+            g_NumParticleEntries = 0;
+        }
+    }
+}
+
+s32 explosionCountGibParticles(void)
+{
+    s32 i;
+    s32 count = 0;
+
+    if (g_FlyingParticlesBuffer == NULL) {
+        return 0;
+    }
+    for (i = 0; i < max_particles; i++) {
+        if (g_FlyingParticlesBuffer[i].unk00 > 0 &&
+            g_FlyingParticlesBuffer[i].unk34 == GE_FLYING_PARTICLE_GIB) {
+            count++;
+        }
+    }
+    return count;
+}
+
+static void geGibSetAlpha(struct FlyingParticles *particle, u8 alpha)
+{
+    s32 i;
+    for (i = 0; i < 4; i++) {
+        particle->vertex_list[i].v.cn[3] = alpha;
+    }
+}
+
+static void geGibUpdateOne(s32 index, s32 steps)
+{
+    struct FlyingParticles *particle = &g_FlyingParticlesBuffer[index];
+    struct GeGibPhysics *physics = &ge_gib_physics[index];
+    s32 j;
+
+    if (physics->settled) {
+        s32 settled_ticks = particle->unk00 - physics->settled_at;
+
+        if (settled_ticks >= GE_GIB_SETTLED_TICKS + GE_GIB_FADE_TICKS) {
+            particle->unk00 = 0;
