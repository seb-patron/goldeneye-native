+/* Cosmetic randomness must not advance randomGetNext(). That generator also drives gameplay,
+ * so spending extra draws on an optional effect would change later AI decisions and could
+ * desynchronise a lockstep session whose peers chose different visual settings. */
+static u32 geGibRand(u32 *state)
+{
+    u32 x = *state;
+    x ^= x << 13;
+    x ^= x >> 17;
+    x ^= x << 5;
+    *state = x;
+    return x;
+}
+
+static f32 geGibRandUnit(u32 *state)
+{
+    return (f32)(geGibRand(state) & 0xffffU) * (1.0f / 65535.0f);
+}
