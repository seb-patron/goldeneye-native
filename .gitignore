# ---- editor and tooling state ----
# Secrets - never commit
*.pem
*.key
*.p12
*.ppk
*.mobileprovision
.env
.env.*
id_rsa*
id_ed25519*
*credentials*.json

# Local editor/tool state

# Dependencies / build output
node_modules/
venv/
.venv/
__pycache__/
*.pyc
.pytest_cache/
dist/
.next/
DerivedData/

# OS junk
.DS_Store
Thumbs.db
# ---- end editor and tooling state ----

# Xcode / tvOS
DerivedData/
*.xcarchive
build/

# Vendored upstream sources - fetched by tvos/build.sh, never committed.
# Our changes to them live in tvos/patches/, not here.
vendor/
deps/

# Generated by xcodegen from tvos/project.yml - do not commit, regenerate.
tvos/PerfectDarkTV.xcodeproj/
tvos/Sources/Info.plist

# Xcode build output
build-device/
build-sim/

# ROMs and any derived game assets - NEVER commit
roms/
*.z64
*.n64
*.v64
*.elf

# SM64 tvOS app (generated / build output)
sm64tv/SM64TV.xcodeproj/
sm64tv/Sources/Info.plist

# GoldenEye tvOS app - same shape as the two above.
# build-generic/ is NOT covered by the bare `build/` rule above (that only matches a
# path component named exactly "build"), and it holds Xcode module + SDK stat caches
# worth megabytes. It was about to be committed.
getv/Goldeneye-Native.xcodeproj/
getv/Sources/Info.plist
getv/build-generic/

# Per-slot build directories and the native macOS build. These hold OBJECT FILES COMPILED
# FROM EXTRACTED ROM ASSETS (assets/**.c) and a ~40 MB linked binary with the whole game
# baked in -- i.e. derived game data, which must NEVER be committed. The bare `build/`
# rule above matches only a path component named exactly "build", so none of these were
# covered: `git add -A` in getv/ would have staged all of them.
getv/build-mac/
getv/build-sim-*/

# CRITICAL, ADDED 2026-08-22 BEFORE FIRST PUBLIC PUSH.
# The two rules above were written when there was ONE mac build dir. Parallel development
# created twenty-plus per-slot dirs (build-mac-anim/, build-mac-audit/, build-mac-final/,
# build-mac-play/, ...) and NONE of them matched. Measured at the time of writing:
# 41,757 untracked files under getv/, including a 31 MB libge.a and multi-MB objects
# PER SLOT -- every one of them compiled from EXTRACTED ROM DATA.
#
# A `git add -A` would have committed derived game data. Use a wildcard, not a list:
# any future slot is covered automatically.
getv/build-*/
build-mac-*/
build-sim-*/

# Scratch space: agent working files, frame captures, BMP/PNG dumps of rendered game
# frames. Frame dumps are derived from the ROM's own art assets -- treat as game data.
scratchpad/
getv/scratchpad/

# Belt and braces: never commit a compiled object or archive from anywhere in the tree.
# deps/ (vendored SDL2) is excluded by its own rule above and is not tracked; an early
# commit did contain it, which is why SDL2 test data and a prebuilt libSDL2.a appear in
# git history. That is SDL2's own zlib-licensed material, not game data.
*.o
*.a
*.dSYM/

# Frame captures are DERIVED FROM THE ROM'S ART ASSETS. Same rule as the ROM itself.
# getv_shot.bmp is written by GETV_SHOTFRAME and lands in the working directory.
*.bmp
getv/getv_shot.*
getv_shot.*

# base.zip is SM64 game data. An earlier bare `base.zip` rule did not match it at a
# nested path -- anchor it properly. Same class of miss as the build-slot dirs above:
# a rule that was correct when written and silently stopped covering the tree.
**/base.zip
sm64tv/Resources/res/
getv/GoldeneyeNativeSim*.xcodeproj/
getv/project-sim*.yml

# Backed up outside the repo at _Personal/goldeneye-native-devnotes-<date>/.
#
# These are working documents: development methodology, measurement traps,
# per-investigation narrative. They are genuinely useful to whoever maintains
# this, and genuinely not useful to someone trying to build and play it. The
# public docs (README, docs/CONFIGURATION.md, docs/CHEATS.md, docs/MODDING.md,
# docs/PORTING.md, docs/ROADMAP.md) are written for that reader instead.

# Application icon and top-shelf art. These render the GoldenEye wordmark and the 007
# gun logo, which are third-party marks (Danjaq/MGM; Nintendo/Rare). They are not needed
# to build or run anything and are excluded from the source release for the same reason
# no game data is shipped. Supply your own icons if you want a branded app bundle.
**/*.xcassets/**
**/*.brandassets/**

# ---------------------------------------------------------------------------
# Third-party port-layer sources. Fetched by tools/fetch-thirdparty.sh from a pinned
# sm64ex commit and patched with our changes; never vendored here. See docs/THIRD_PARTY.md.
#
# Measured inheritance is 62-100% of upstream text per file, and the upstream licence
# situation is unresolved (Emill's original forbade binary redistribution; sm64ex ships
# no root licence). Our changes to them live in getv/patches/thirdparty/ as a patch series.
#
# Listed explicitly rather than as a directory glob with negations, so that a new file
# added to fast3d/ is not silently ignored.
#
# ge_sky_rdp.{c,h} are OURS and stay tracked.
getv/port/fast3d/gfx_cc.c
getv/port/fast3d/gfx_cc.h
getv/port/fast3d/gfx_opengl.c
getv/port/fast3d/gfx_opengl.h
getv/port/fast3d/gfx_pc.c
getv/port/fast3d/gfx_pc.h
getv/port/fast3d/gfx_rendering_api.h
getv/port/fast3d/gfx_screen_config.h
getv/port/fast3d/gfx_sdl.h
getv/port/fast3d/gfx_sdl2.c
getv/port/fast3d/gfx_window_manager_api.h
getv/port/audio/ge_mixer.c
getv/port/audio/ge_mixer.h
getv/port/configfile.h
getv/port/fs/fs.h

# Sibling tvOS ports of other games (Super Mario 64, Perfect Dark). They share this
# build approach but are separate projects and are not part of Goldeneye-Native.
sm64tv/
tvos/

# Xcode projects are xcodegen output, generated from getv/project.yml. 28 per-target
# variants accumulate during development; none of them belong in the repository.
*.xcodeproj/

# Per-slot build scripts. build_mac.sh is the build; copies of it with a different
# BUILD= directory are created during parallel development and are not part of the
# project. build_mac.sh itself is tracked.
getv/build_mac_*.sh
getv/build_sim_*.sh

# Screenshots used in the documentation. These are the one deliberate exception to the
# no-game-data rule: they are captures of the running port, included because a port with
# no screenshots is not a credible port. They are not assets and nothing reads them.
!docs/images/
!docs/images/*.png
!docs/images/*.jpg

# Editor and tooling artifacts.
# compile_commands.json and .cache/ matter most here: clangd generates both as soon as anyone
# opens this tree in an editor that supports it, and on a codebase this size the cache is
# large. The rest are the usual per-editor and per-OS droppings.
.vscode/
.idea/
*.swp
*.swo
compile_commands.json
.cache/
.clangd/
core
core.*

# Diagnostic output from a run, which lands in whatever directory the binary was started
# from -- usually the repository root. GETV_CULLSTAT / GETV_ROOMTRACE / GETV_GUN_DEBUG logs
# are megabytes each (run.log reached 4 MB in one 9000-frame run) and GETV_SHOTFRAME writes
# uncompressed BMPs at the output resolution.
#
# Anchored to the root with a leading slash, deliberately: docs/images/ is tracked and must
# stay that way, and a bare *.png would swallow it.
#
# docs/COLLABORATION.md is explicit that this belongs here rather than in
# .git/info/exclude -- that file is per-clone and does not travel, which is how twelve
# unpublished files reached the other machine once already.
/*.log
/*.bmp
/*.png
/*.err

# macOS AppleDouble sidecars. They travel in tarballs, and a compiler will happily
# try to build one.
._*
.DS_Store

# Internal research notes. Kept out of the published repository deliberately.
#
# This lived in .git/info/exclude, which is per-clone and does not travel, so a second
# machine cloning this tree happily committed all twelve files. A shared rule is the only
# kind that actually holds.
docs/research/

# Ingested walkthrough text. Third-party prose from other people's sites, kept locally for
# analysis only -- the tool that produces it travels, the text does not.
build/levels/*.walkthrough.json
docs/research/TRAIN_WALKTHROUGH.txt
docs/research/TRAIN_SPATIAL_MODEL.txt
build/levels/*.brief.json
